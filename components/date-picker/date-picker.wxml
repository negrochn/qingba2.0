<!-- 日期选择器：自绘三列滚轮（年 / 月 / 日），半屏弹层
     布局对齐 WeUI 官方 picker：左上角关闭 + 居中标题 + 滚轮 + 底部一个确定。
     蒙层根节点自带主题 class，见 date-picker.wxss 头注释 -->
<view class="dp-mask {{fontClass}} {{darkClass}} {{show ? 'show' : ''}}" bindtap="onCancel" catchtouchmove="noop">
  <view class="dp-sheet" catchtap="noop">

    <view class="dp-hd">
      <view class="dp-hd-side">
        <view class="dp-close iconfont icon-close" catchtap="onCancel"></view>
      </view>
      <view class="dp-hd-main">
        <text class="dp-title">{{title}}</text>
      </view>
    </view>

    <picker-view
      class="dp-pv"
      indicator-style="height: 112rpx;"
      indicator-class="dp-pv-indicator"
      mask-class="dp-pv-mask"
      value="{{pickerValue}}"
      bindchange="onColumnChange"
    >
      <picker-view-column>
        <view class="dp-item" wx:for="{{years}}" wx:key="*this">{{item}}年</view>
      </picker-view-column>
      <picker-view-column>
        <view class="dp-item" wx:for="{{months}}" wx:key="*this">{{item}}月</view>
      </picker-view-column>
      <picker-view-column>
        <view class="dp-item" wx:for="{{days}}" wx:key="*this">{{item}}日</view>
      </picker-view-column>
    </picker-view>

    <view class="dp-ft">
      <button class="dp-btn" catchtap="onConfirm">确定</button>
    </view>

  </view>
</view>
