/* 日期选择器（自绘三列滚轮）
   布局与数值对齐 WeUI 官方 picker（源码 D:\github\weui）：
     src/style/widget/weui-picker/weui-picker.less
     src/style/widget/weui-tips/weui-half-screen-dialog.less
     weui.js 的 src/picker/picker.html（官方 DOM 模板）
   即：左上角「关闭」+ 居中标题 + 滚轮 + 底部居中的主按钮「确定」（关闭按钮承担取消语义）。

   颜色 / 字号全部走 --* 变量与 calc(Nrpx * var(--fs))，跟随页面根节点（.container / .dm-*）。
   弹层是 position:fixed，由页面把 fontClass / darkClass 透传进来挂在本根节点上。

   注：json 里设了 styleIsolation: "shared" —— picker-view 的内置蒙层 / 选中框是
   基础库渲染的元素，不开 shared 时组件作用域内的类名可能命中不到它们。 */

/* .iconfont / .icon-* 是 class 选择器，而 app.wxss 的 class 样式**不会**穿透进自定义组件，
   所以组件内用 iconfont 必须自己 @import 一份（同 components/radio-list 的做法）。 */
@import "../../styles/iconfont.wxss";

/* 本组件是「常驻挂载 + show 切 class」，隐藏态必须显式移出屏幕 + visibility:hidden，
   只写 pointer-events:none 是不够的（那只是不接收点击，面板仍会渲染在页面上）。
   visibility 参与 transition：关闭时延迟到滑出动画结束才真正隐藏。 */
.dp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 2000;
  visibility: hidden;
  pointer-events: none;
  transition: background 0.2s, visibility 0.3s;
  display: flex;
  align-items: flex-end;
}

.dp-mask.show {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
  visibility: visible;
}

.dp-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.3s ease;   /* WeUI: transition: transform 0.3s */
}

.dp-mask.show .dp-sheet {
  transform: translateY(0);
}

/* ===== 头部：左上角关闭 + 居中标题（对齐 WeUI .weui-half-screen-dialog__hd） ===== */
.dp-hd {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: 16rpx;
}

/* 通栏细线（对齐 WeUI .weui-picker__hd::after；左右用负值抵到面板边缘） */
.dp-hd::after {
  content: ' ';
  position: absolute;
  left: -32rpx;
  right: -32rpx;
  bottom: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: bottom;
}

/* 关闭按钮槽位：绝对定位，使标题不受按钮宽度影响而真正居中（WeUI 同款做法） */
.dp-hd-side {
  position: absolute;
  left: -32rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

/* 关闭：纯图标，热区 88rpx 见方（设计指南「可点项最小热区 ≥ 88rpx」） */
.dp-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}

.dp-close:active { opacity: 0.5; }

.dp-hd-main {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 0 80rpx;
}

/* WeUI .weui-half-screen-dialog__title：15px / font-weight 500 */
.dp-title {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  font-weight: 500;
}

/* ===== 滚轮（项高 56px / 区高 240px，对齐 WeUI .weui-picker__item / __bd） ===== */
.dp-pv {
  width: 100%;
  height: 480rpx;
}

/* line-height 必须与 indicator-style 的 height 严格一致，否则选中项与细线错位 */
.dp-item {
  line-height: 112rpx;
  text-align: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

/* picker-view 的内置蒙层是固定白色渐变，不吃 CSS 变量，深色下会在卡片上留下灰白块 ——
   这里用 mask-class 覆盖成「跟随主题」的上下渐隐，取值与 WeUI .weui-picker__mask 一致
   （浅色 rgba(255,255,255,…)、深色 rgba(25,25,25,…)，正好等于 --card 的深色 #191919）。
   注：这是功能性渐隐、WeUI 官方实现，不属于项目「禁止渐变」所针对的色块 / 标签 / 按钮。 */
.dp-pv-mask {
  background-image:
    linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.6)),
    linear-gradient(0deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.6)) !important;
  background-position: top, bottom;
  background-size: 100% 224rpx;   /* WeUI: 100% (2 × 56px) */
  background-repeat: no-repeat;
}

/* 蒙层根节点同时挂 dm-* 与 .dp-mask，故用同元素复合做祖先前缀
   （`.dm-dark .dp-pv-mask` 依赖组件外的祖先，组件样式隔离下不可靠） */
.dp-mask.dm-dark .dp-pv-mask {
  background-image:
    linear-gradient(180deg, rgba(25, 25, 25, 0.95), rgba(25, 25, 25, 0.6)),
    linear-gradient(0deg, rgba(25, 25, 25, 0.95), rgba(25, 25, 25, 0.6)) !important;
}

@media (prefers-color-scheme: dark) {
  .dp-mask.dm-auto .dp-pv-mask {
    background-image:
      linear-gradient(180deg, rgba(25, 25, 25, 0.95), rgba(25, 25, 25, 0.6)),
      linear-gradient(0deg, rgba(25, 25, 25, 0.95), rgba(25, 25, 25, 0.6)) !important;
  }
}

/* 选中框：小程序 picker-view 的 indicator 覆盖在内容层之上，填实色会盖住整行文字，
   故只能保持透明背景 + 主题色上下细线（WeUI 的 BG-3 实色底做不到）。
   它是 112rpx 高的框，加 transform 会压扁选中区，因此直接用 1px */
.dp-pv-indicator {
  background: transparent !important;
  border-top: 1px solid var(--divider);
  border-bottom: 1px solid var(--divider);
}

/* ===== 底部：一个居中的主按钮（对齐 WeUI .weui-half-screen-dialog__ft） =====
   上 112rpx ≈ WeUI 的 __bd { padding-bottom: 56px }
   下 96rpx + 面板自身 32rpx 下内距 = 128rpx = WeUI 的 __ft { padding: 0 0 64px } */
.dp-ft {
  padding: 112rpx 0 96rpx;
  text-align: center;
}

/* 主按钮：数值对齐 WeUI 的 .weui-btn.weui-btn_primary。
   组件样式默认隔离，app.wxss 里的 .weui-btn 不会作用到这里，故本地写一份同值样式。
   宽度沿用小程序原生 button 的默认 184px（= WeUI 的 @weuiBtnWidth），不做覆盖。 */
.dp-btn {
  margin: 0 auto;
  padding: 24rpx 48rpx;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  line-height: 1.41176471;
  text-align: center;
  color: #fff;
  background-color: var(--brand);
  border-radius: 16rpx;
  border: none;
  box-sizing: border-box;
  position: relative;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
}

.dp-btn::after { border: none; }

.dp-btn:active { opacity: 0.85; }

/* ===== 深色模式 =====
   蒙层根节点同时挂 dm-* 与 .dp-mask，故深色选择器要写成同元素复合。
   深色蒙层取 rgba(0,0,0,.8)，与 app.wxss 的 .dm-dark .weui-mask 同值。 */
.dp-mask.dm-dark.show { background: rgba(0, 0, 0, 0.8); }

@media (prefers-color-scheme: dark) {
  .dp-mask.dm-auto.show { background: rgba(0, 0, 0, 0.8); }
}
