/* 资源选择器（双列：左分组 / 右资源）
   头部布局对齐 WeUI picker（源码 D:\github\weui\src\style\widget\weui-tips\weui-half-screen-dialog.less）：
   左上角「关闭」+ 居中标题。本弹层没有底部按钮（点资源即选中并关闭）。

   颜色 / 字号全部走 --* 变量与 calc(Nrpx * var(--fs))，跟随页面根节点（.container / .dm-*）。
   弹层是 position:fixed，由页面把 fontClass / darkClass 透传进来挂在本根节点上。

   字号只用 WeUI 标准 UI 三档（34 / 28 / 24rpx），不使用已废弃的 22 / 26 / 30 / 32 / 36rpx。 */

/* .iconfont / .icon-* 是 class 选择器，而 app.wxss 的 class 样式**不会**穿透进自定义组件
   （只用标签名选择器才会），所以组件内用 iconfont 必须自己 @import 一份。
   与 components/radio-list/radio-list.wxss 同一做法。 */
@import "../../styles/iconfont.wxss";

/* 本组件是「常驻挂载 + show 切 class」，不是 wx:if 创建/销毁，
   所以隐藏态必须显式把面板移出屏幕 + 整体 visibility:hidden。
   只写 pointer-events:none 是不够的 —— 那只是不接收点击，面板仍会渲染在页面上。
   visibility 参与 transition：关闭时延迟到滑出动画结束才真正隐藏。 */
.rp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 2000;
  visibility: hidden;
  pointer-events: none;
  transition: background 0.2s, visibility 0.3s;
  display: flex;
  align-items: flex-end;
}

.rp-mask.show {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
  visibility: visible;
}

.rp-sheet {
  width: 100%;
  height: 75vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  /* 半屏弹窗顶部圆角 24rpx（@weuiDialogBorderRadius 同档） */
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  /* 隐藏态整体沉到视口下方 */
  transform: translateY(100%);
  transition: transform 0.3s ease;   /* WeUI: transition: transform 0.3s */
}

.rp-mask.show .rp-sheet {
  transform: translateY(0);
}

/* ===== 头部：左上角关闭 + 居中标题（对齐 WeUI .weui-half-screen-dialog__hd） ===== */
.rp-hd {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: 16rpx;
}

/* 通栏细线（对齐 WeUI .weui-picker__hd::after；左右用负值抵到面板边缘） */
.rp-hd::after {
  content: ' ';
  position: absolute;
  left: -32rpx;
  right: -32rpx;
  bottom: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: bottom;
}

/* 关闭按钮槽位：绝对定位，使标题不受按钮宽度影响而真正居中（WeUI 同款做法） */
.rp-hd-side {
  position: absolute;
  left: -32rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

/* 关闭：纯图标，热区 88rpx 见方（设计指南「可点项最小热区 ≥ 88rpx」） */
.rp-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}

.rp-close:active { opacity: 0.5; }

.rp-hd-main {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 0 80rpx;
}

/* WeUI .weui-half-screen-dialog__title：15px / font-weight 500 */
.rp-title {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  font-weight: 500;
}

/* ===== 双列主体 ===== */
.rp-body {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
  /* 内嵌面板走「分组卡片」圆角 20rpx */
  border-radius: 20rpx;
  background: var(--card2);
}

.rp-groups {
  position: relative;
  width: 200rpx;
  flex-shrink: 0;
  height: 100%;
}

/* 列间细线（细线统一方案：1px + scaleX(0.5)，origin 锚右） */
.rp-groups::after {
  content: ' ';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--divider);
  transform: scaleX(0.5);
  transform-origin: right;
}

.rp-group {
  padding: 28rpx 16rpx 28rpx 24rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.3;
}

.rp-group.active {
  background: var(--card);
  color: var(--text);
  font-weight: 500;
}

.rp-items {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--card);
  border-top-right-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
}

/* 列表项：主文 34rpx，行高对齐 @weuiCellHeight 112rpx */
.rp-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.rp-item:active { background: var(--cell-active); }

/* 选中态用品牌绿（与 .weui-cells_radio 的选中标记同语义） */
.rp-item.active { color: var(--brand); }

/* 行间缩进细线：left 与内容左边界（padding-left 24rpx）对齐 */
.rp-item::before {
  content: ' ';
  position: absolute;
  left: 24rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.rp-item:first-child::before { display: none; }

.rp-item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 自定义尾标（与补录页同语义，辅助档 24rpx） */
.rp-custom {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--card2);
  color: var(--text3);
  font-size: calc(24rpx * var(--fs, 1));
}

/* 选中勾：对齐 .weui-cells_radio .weui-icon-checked 的 44rpx */
.rp-check {
  flex-shrink: 0;
  font-size: calc(44rpx * var(--fs, 1)) !important;
  color: var(--brand);
  line-height: 1;
}

.rp-empty {
  padding: 64rpx 24rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* ===== 深色模式 =====
   蒙层根节点同时挂 dm-* 与 .rp-mask，故深色选择器要写成同元素复合
   （写 `.dm-dark .rp-mask` 会要求 dm-dark 是祖先，匹配不到）。
   深色蒙层取 rgba(0,0,0,.8)，与 app.wxss 的 .dm-dark .weui-mask 同值。 */
.rp-mask.dm-dark.show { background: rgba(0, 0, 0, 0.8); }

@media (prefers-color-scheme: dark) {
  .rp-mask.dm-auto.show { background: rgba(0, 0, 0, 0.8); }
}
