/* 资源选择器（双列：左分组 / 右资源）
   弹层外壳（蒙层 / 抓手 / 标题左 + 关闭右）走 components/half-sheet，
   本组件只定制面板高度与左右内边距（见文件末尾的 .rp-sheet）。
   本弹层没有底部按钮（点资源即选中并关闭）。

   颜色 / 字号全部走 --* 变量与 calc(Nrpx * var(--fs))，跟随页面根节点（.container / .dm-*）。
   外壳所需的 fontClass / darkClass 由页面透传进来，再由本组件转交给 half-sheet。

   字号只用微信标准 UI 三档（34 / 28 / 24rpx），不使用已废弃的 22 / 26 / 30 / 32 / 36rpx。 */

/* .iconfont / .icon-* 是 class 选择器，而 app.wxss 的 class 样式**不会**穿透进自定义组件
   （只用标签名选择器才会），所以组件内用 iconfont 必须自己 @import 一份。
   与 components/radio-list/radio-list.wxss 同一做法。 */
@import "../../styles/iconfont.wxss";

/* 本组件是「常驻挂载 + show 切 class」，不是 wx:if 创建/销毁，
   所以隐藏态必须显式把面板移出屏幕 + 整体 visibility:hidden。
   只写 pointer-events:none 是不够的 —— 那只是不接收点击，面板仍会渲染在页面上。
   visibility 参与 transition：关闭时延迟到滑出动画结束才真正隐藏。 */
/* 面板定制：外壳（蒙层 / 抓手 / 头部 / 圆角 / 隐藏与滑出动画）由 components/half-sheet 提供，
   这里只补两件组件不知道的事 ——
   ① 面板高度分三档（默认 7 行 / .h8 8 行 / .h9 9 行），保证左右两列 scroll-view 有确定高度；
   ② 左右内边距归零，让双列主体通栏铺满（左右留白由头部自己维护） */
.rp-sheet {
  --rp-rows: 7;
  /* 固定占高 = 上 padding 16 + 抓手(8+8+24) + 头部(56+24) + 下 padding 32 = 168rpx，
     再 + 行高 96rpx × N + 余量 24rpx + 底部安全区。
     用 rpx + env() 表达，随屏宽 / 安全区自动适配，不必用 JS 量窗口；
     余量 24rpx 用于吸收大字号档头部变高、安全区取整等几像素的波动 */
  height: calc(168rpx + 24rpx + 96rpx * var(--rp-rows) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* 双类名提高特异性：确保盖过 half-sheet 内 .hsc-sheet 的左右内边距（两者特异性同为 0,1,0） */
.rp-sheet.rp-sheet {
  padding-left: 0;
  padding-right: 0;
}

/* 高度档：默认档装 7 个分组行，这两个类分别装 8 / 9 行 */
.rp-sheet.h8 { --rp-rows: 8; }
.rp-sheet.h9 { --rp-rows: 9; }

/* ===== 双列主体 =====
   通栏铺满弹窗宽度，不做「内缩 + 圆角」的内嵌卡片（那是表单卡的形态）。
   左右两列同白底，分栏只靠 .rp-groups::after 的列间竖线表达，顶部圆角由 .rp-sheet 承担 */
.rp-body {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
}

.rp-groups {
  position: relative;
  /* 300rpx：够放「副课分级读物」这类 6 字分组名（34rpx × 6 = 204rpx），
     加左右内边距 48rpx 共 252rpx，留出余量以便字号档调大时不换行 */
  width: 300rpx;
  flex-shrink: 0;
  height: 100%;
}

/* 列间细线（细线统一方案：1px + scaleX(0.5)，origin 锚右） */
.rp-groups::after {
  content: ' ';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--divider);
  transform: scaleX(0.5);
  transform-origin: right;
}

/* 分组项：字号取微信 17pt 主文档（34rpx）——与右列 .rp-item 同档，层级由颜色承担
   （未选中 --text2 灰 / 选中 --brand 品牌绿）。
   高度 96rpx；分组多时超出 70vh 由 scroll-view 滚动兜底 */
.rp-group {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.3;
}

/* 分组名：flex:1 把行尾选中勾推到右侧，长名省略号 */
.rp-group-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 行间细线：与右列 .rp-item::before 同款 —— 左缩进 24rpx 对齐文字，
   右端也留 24rpx，避免顶到列间那根竖线上 */
.rp-group::before {
  content: ' ';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.rp-group:first-child::before { display: none; }

.rp-group:active { background: var(--cell-active); }

/* 选中态：文字变品牌色，行尾打对勾（.rp-check，与右列 .rp-item 选中勾同款），
   不再用竖线指示条，也不改背景 —— 与右侧资源的选中表达保持一致 */
.rp-group.active {
  color: var(--brand);
  font-weight: 500;
}

.rp-items {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--card);
}

/* 列表项：主文 34rpx，行高对齐 @weuiCellHeight 112rpx */
.rp-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.rp-item:active { background: var(--cell-active); }

/* 选中态用品牌绿（与 .weui-cells_radio 的选中标记同语义） */
.rp-item.active { color: var(--brand); }

/* 行间缩进细线：left 与内容左边界（padding-left 24rpx）对齐 */
.rp-item::before {
  content: ' ';
  position: absolute;
  left: 24rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.rp-item:first-child::before { display: none; }

.rp-item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 自定义尾标（与补录页同语义，辅助档 24rpx） */
.rp-custom {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--card2);
  color: var(--text3);
  font-size: calc(24rpx * var(--fs, 1));
}

/* 选中勾：对齐 .weui-cells_radio .weui-icon-checked 的 44rpx */
.rp-check {
  flex-shrink: 0;
  font-size: calc(44rpx * var(--fs, 1)) !important;
  color: var(--brand);
  line-height: 1;
}

.rp-empty {
  padding: 64rpx 24rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* 深色蒙层已随外壳迁入 components/half-sheet（.hsc-mask.dm-dark / .dm-auto），本组件无需覆盖 */
