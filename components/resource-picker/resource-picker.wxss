/* 资源选择器（双列：左分组 / 右资源）
   弹层样式对齐项目原语 4「action-sheet」（pages/stage 打卡弹窗同款）：抓手 + 标题左 + 关闭右。
   本弹层没有底部按钮（点资源即选中并关闭）。

   颜色 / 字号全部走 --* 变量与 calc(Nrpx * var(--fs))，跟随页面根节点（.container / .dm-*）。
   弹层是 position:fixed，由页面把 fontClass / darkClass 透传进来挂在本根节点上。

   字号只用微信标准 UI 三档（34 / 28 / 24rpx），不使用已废弃的 22 / 26 / 30 / 32 / 36rpx。 */

/* .iconfont / .icon-* 是 class 选择器，而 app.wxss 的 class 样式**不会**穿透进自定义组件
   （只用标签名选择器才会），所以组件内用 iconfont 必须自己 @import 一份。
   与 components/radio-list/radio-list.wxss 同一做法。 */
@import "../../styles/iconfont.wxss";

/* 本组件是「常驻挂载 + show 切 class」，不是 wx:if 创建/销毁，
   所以隐藏态必须显式把面板移出屏幕 + 整体 visibility:hidden。
   只写 pointer-events:none 是不够的 —— 那只是不接收点击，面板仍会渲染在页面上。
   visibility 参与 transition：关闭时延迟到滑出动画结束才真正隐藏。 */
.rp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 2000;
  visibility: hidden;
  pointer-events: none;
  transition: background 0.2s, visibility 0.3s;
  display: flex;
  align-items: flex-end;
}

.rp-mask.show {
  background: rgba(0, 0, 0, 0.5);   /* 与 .sheet-mask-show 同值 */
  pointer-events: auto;
  visibility: visible;
}

.rp-sheet {
  width: 100%;
  /* 高度按「能装下几个分组行」分三档（默认档 7 行 / .h8 8 行 / .h9 9 行）：
       固定占高 172rpx（上 padding 16 + 抓手 8+8+24 + 头部 56+28 + 下 padding 32）
     + 行高 96rpx × N + 余量 24rpx + 底部安全区。
     用 rpx + env() 表达，随屏宽 / 安全区自动适配，不必用 JS 量窗口；
     双列 scroll-view 因此始终有确定高度 —— 内容多于档位时在档内滚动，不会撑出屏幕。
     余量 24rpx 用于吸收大字号档头部变高、安全区取整等几像素的波动 */
  --rp-rows: 7;
  height: calc(172rpx + 24rpx + 96rpx * var(--rp-rows) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--card);
  /* 半屏弹窗顶部圆角 24rpx（@weuiDialogBorderRadius 同档） */
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  /* 左右不留内边距：双列主体要通栏铺满（WeUI 列表的做法）——
     左右留白由 .rp-head 自己维护，主体的分栏才不会被「内缩 + 圆角」框成一张卡片 */
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  /* 隐藏态整体沉到视口下方 */
  transform: translateY(100%);
  transition: transform 0.25s ease;   /* 对齐 .action-sheet */
}

.rp-mask.show .rp-sheet {
  transform: translateY(0);
}

/* 高度档：默认档装 7 个分组行，这两个类分别装 8 / 9 行 */
.rp-sheet.h8 { --rp-rows: 8; }
.rp-sheet.h9 { --rp-rows: 9; }

/* ===== 头部：抓手 + 标题左 + 关闭右（对齐 .sheet-handle / .sheet-head / .sheet-close） ===== */
.rp-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--divider);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

.rp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 28rpx;   /* 面板左右 padding 已归零，头部自己留白 */
}

.rp-title {
  flex: 1;
  min-width: 0;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
}

/* 关闭：纯图标，热区 88rpx 见方（设计指南「可点项最小热区 ≥ 88rpx」），
   负 margin 抵消热区外扩，让标题与图标的视觉间距保持不变 */
.rp-close {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -16rpx -16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  border-radius: 50%;
}

.rp-close:active { background: var(--cell-active); color: var(--text2); }

/* ===== 双列主体 =====
   通栏铺满弹窗宽度，不做「内缩 + 圆角」的内嵌卡片（那是表单卡的形态）。
   左右两列同白底，分栏只靠 .rp-groups::after 的列间竖线表达，顶部圆角由 .rp-sheet 承担 */
.rp-body {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
}

.rp-groups {
  position: relative;
  /* 300rpx：够放「副课分级读物」这类 6 字分组名（34rpx × 6 = 204rpx），
     加左右内边距 48rpx 共 252rpx，留出余量以便字号档调大时不换行 */
  width: 300rpx;
  flex-shrink: 0;
  height: 100%;
}

/* 列间细线（细线统一方案：1px + scaleX(0.5)，origin 锚右） */
.rp-groups::after {
  content: ' ';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--divider);
  transform: scaleX(0.5);
  transform-origin: right;
}

/* 分组项：字号取微信 17pt 主文档（34rpx）——与右列 .rp-item 同档，层级由颜色承担
   （未选中 --text2 灰 / 选中 --brand 品牌绿）。
   高度 96rpx；分组多时超出 70vh 由 scroll-view 滚动兜底 */
.rp-group {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.3;
}

/* 分组名：flex:1 把行尾选中勾推到右侧，长名省略号 */
.rp-group-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 行间细线：与右列 .rp-item::before 同款 —— 左缩进 24rpx 对齐文字，
   右端也留 24rpx，避免顶到列间那根竖线上 */
.rp-group::before {
  content: ' ';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.rp-group:first-child::before { display: none; }

.rp-group:active { background: var(--cell-active); }

/* 选中态：文字变品牌色，行尾打对勾（.rp-check，与右列 .rp-item 选中勾同款），
   不再用竖线指示条，也不改背景 —— 与右侧资源的选中表达保持一致 */
.rp-group.active {
  color: var(--brand);
  font-weight: 500;
}

.rp-items {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--card);
}

/* 列表项：主文 34rpx，行高对齐 @weuiCellHeight 112rpx */
.rp-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.rp-item:active { background: var(--cell-active); }

/* 选中态用品牌绿（与 .weui-cells_radio 的选中标记同语义） */
.rp-item.active { color: var(--brand); }

/* 行间缩进细线：left 与内容左边界（padding-left 24rpx）对齐 */
.rp-item::before {
  content: ' ';
  position: absolute;
  left: 24rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.rp-item:first-child::before { display: none; }

.rp-item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 自定义尾标（与补录页同语义，辅助档 24rpx） */
.rp-custom {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--card2);
  color: var(--text3);
  font-size: calc(24rpx * var(--fs, 1));
}

/* 选中勾：对齐 .weui-cells_radio .weui-icon-checked 的 44rpx */
.rp-check {
  flex-shrink: 0;
  font-size: calc(44rpx * var(--fs, 1)) !important;
  color: var(--brand);
  line-height: 1;
}

.rp-empty {
  padding: 64rpx 24rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* ===== 深色模式 =====
   蒙层根节点同时挂 dm-* 与 .rp-mask，故深色选择器要写成同元素复合
   （写 `.dm-dark .rp-mask` 会要求 dm-dark 是祖先，匹配不到）。
   深色蒙层取 rgba(0,0,0,.8)，与 app.wxss 的 .dm-dark .weui-mask 同值。 */
.rp-mask.dm-dark.show { background: rgba(0, 0, 0, 0.8); }

@media (prefers-color-scheme: dark) {
  .rp-mask.dm-auto.show { background: rgba(0, 0, 0, 0.8); }
}
