/* 全局样式 —— 设计系统以 WeUI 官方（Tencent/weui v2.6.26）为权威来源，
   全部色板 / 字号 / 间距 / 圆角沿用 .codebuddy/skills/ui-design-spec 的 token。
   类名采用 WeUI 规范（.weui-*）。颜色统一引用项目 --* 变量（已对齐 WeUI，见 skill design-tokens.md §9）。 */

/* 可被自定义组件复用的样式抽到 styles/ 下，由 app.wxss 与组件共同 @import，
   保证全项目只有一份来源（详见各文件头注释）：
     styles/weui-cells.wxss  —— 列表分组 / 单元格 / 单选
     styles/iconfont.wxss    —— .iconfont / .icon-* 字形类（@font-face 仍在下方本文件注册）
     styles/checkin-matrix.wxss —— 打卡矩阵（成绩单列表页 / 详情页共用） */
@import "./styles/weui-cells.wxss";
@import "./styles/iconfont.wxss";
@import "./styles/checkin-matrix.wxss";
@import "./styles/empty-state.wxss";

/* ===== 主题色板（--* 变量，已对齐 WeUI） =====
   浅色为默认；深色通过根节点 class 切换 CSS 变量（现只挂 dm-auto = 跟随系统，
   dm-light / dm-dark 两个手动档已移除，规则体保留为休眠机制）。
   对应 WeUI：--bg=BG-0 / --card=BG-2 / --text=FG-0(主文字) / --text2=FG-1(次级) /
   --text3=FG-2(三级·占位) / --divider≈FG-3 / --brand=BRAND /
   --danger=RED / --cell-active≈BG-COLOR-ACTIVE / --btn-default=FG-5(默认按钮底) */
page {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f7f7;
  --text: #1a1a1a;                  /* FG-0 rgba(0,0,0,.9) 主文字 */
  --text2: #737373;                 /* FG-1 rgba(0,0,0,.55) 次级：标题 / 说明 / cell 值 */
  --text3: #b2b2b2;                 /* FG-2 rgba(0,0,0,.3) 三级 / 占位 */
  --divider: #e5e5e5;               /* ≈FG-3 rgba(0,0,0,.1) 分隔线 */
  --brand: #07C160;
  --danger: #fa5151;               /* RED light */
  --cell-active: #ececec;          /* BG-COLOR-ACTIVE light */
  /* 默认按钮底（= WeUI FG-5）：**必须是半透明叠加、不能是不透明实色**。
     同一枚 .weui-btn_default 既要落在页面 --bg 上（stage 的「晋级下一阶段」），
     又要落在 --card 上（弹窗里的「取消」）——取任一实色都只适配一种底，
     在另一种底上就会与背景同色而隐形（历史两次踩坑：--cell-active 撞 --bg、--card 撞 --card） */
  --btn-default: rgba(0, 0, 0, 0.05);
  /* 默认浅色背景；系统深色时由下方 media query 覆盖为深色。
     这里不能用 var(--bg) —— dm-light/dm-dark 类挂在 .container 上，
     变量只能向下继承，page 上解析到的永远是基础值 #ededed。*/
  background-color: #ededed;
  color: var(--text);
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 跟随系统深色：把 page 背景改为深色，覆盖 app.json.backgroundColor 的固定值。
   解决 nav bar 下方露出 page 浅色底的小亮色条问题。*/
@media (prefers-color-scheme: dark) {
  page { background-color: #111; }
}

view, text {
  box-sizing: border-box;
}

/* iconfont 字族：base64 data URI 在全局 app.wxss 内联注册 @font-face。
   之前 WXSS 用本地相对路径的 @font-face 被开发者工具强制改写为 -do-not-use-local-path- 拒绝加载；
   而 wx.loadFontFace 在 App.onLaunch 调用仅作用于 App 所在 webview，无法跨页面下发到各页面 webview。
   全局 app.wxss 会注入每个页面 webview，故在此内联注册字族后所有页面可直接使用。
   关键坑：微信开发者工具内置 Chromium 对 woff 的 data URI 渲染支持很差（真机 WebView 正常），
   单独用 woff 时模拟器里图标会变成方块/异常。故 src 顺序为 ttf 优先（开发者工具与真机都能识别 ttf），
   woff 兜底（体积更小），二者都内联，所有页面 webview 通用。 */
@font-face {
  font-family: "iconfont";
      src: url(data:application/x-font-ttf;base64,) format("truetype"),
         url(data:application/font-woff;base64,) format("woff");
  font-weight: normal;
  font-style: normal;
}

/* 手动浅色（系统深色时强制浅色内容区） */
.dm-light {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f7f7;
  --text: #1a1a1a;                  /* FG-0 主文字 */
  --text2: #737373;                 /* FG-1 次级 */
  --text3: #b2b2b2;                 /* FG-2 三级 / 占位 */
  --divider: #e5e5e5;               /* ≈FG-3 分隔线 */
  --brand: #07C160;
  --danger: #fa5151;               /* RED light */
  --cell-active: #ececec;          /* BG-COLOR-ACTIVE light */
  --btn-default: rgba(0, 0, 0, 0.05);   /* FG-5 light：默认按钮底 */
}

/* 手动深色（微信官方深色色板：BG #111 / 卡片 BG-2 #191919 / 文字 FG-0 .8 / FG-1 .5 / FG-2 .3） */
.dm-dark {
  --bg: #111111;
  --card: #191919;
  --card2: #202020;
  --text: rgba(255, 255, 255, 0.8);     /* FG-0 dark 主文字 */
  --text2: rgba(255, 255, 255, 0.5);    /* FG-1 dark 次级 */
  --text3: rgba(255, 255, 255, 0.3);    /* FG-2 dark 三级 / 占位 */
  --divider: rgba(255, 255, 255, 0.1);
  --brand: #07C160;
  --danger: #fa5151;               /* RED dark（与浅色一致，WeUI RED 不随深浅变化） */
  --cell-active: #373737;          /* BG-COLOR-ACTIVE dark */
  --btn-default: rgba(255, 255, 255, 0.1);   /* FG-5 dark：默认按钮底 */
}

/* 跟随系统 */
@media (prefers-color-scheme: dark) {
  .dm-auto {
    --bg: #111111;
    --card: #191919;
    --card2: #202020;
    --text: rgba(255, 255, 255, 0.8);     /* FG-0 dark 主文字 */
    --text2: rgba(255, 255, 255, 0.5);    /* FG-1 dark 次级 */
    --text3: rgba(255, 255, 255, 0.3);    /* FG-2 dark 三级 / 占位 */
    --divider: rgba(255, 255, 255, 0.1);
    --brand: #07C160;
    --danger: #fa5151;               /* RED dark（与浅色一致，WeUI RED 不随深浅变化） */
    --cell-active: #373737;          /* BG-COLOR-ACTIVE dark */
    --btn-default: rgba(255, 255, 255, 0.1);   /* FG-5 dark：默认按钮底 */
  }
}

/* ===== 字号档位（无障碍：跟随系统字号缩放） =====
   档位 class 挂在页面根节点上，子节点所有 calc(Nrpx * var(--fs)) 自动缩放 */
.fs-small { --fs: 0.9; font-size: calc(28rpx * var(--fs, 1)); }
.fs-normal { --fs: 1; font-size: calc(28rpx * var(--fs, 1)); }
.fs-large { --fs: 1.15; font-size: calc(28rpx * var(--fs, 1)); }
.fs-xlarge { --fs: 1.3; font-size: calc(28rpx * var(--fs, 1)); }

/* ============================================================
   原语：孩子头像（多孩功能共用：首页切换器 / 路线页 cell /
   孩子管理页 / 切换弹层组件）
   圆形色板底 + 白字首字；色板 green/blue/orange/purple/pink 按添加顺序循环
   ============================================================ */
.cp-av {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 500;
  line-height: 1;
  flex-shrink: 0;
}
.cp-av--green  { background: #07C160; }
.cp-av--blue   { background: #10AEFF; }
.cp-av--orange { background: #FA9D3B; }
.cp-av--purple { background: #6467F0; }
.cp-av--pink   { background: #FA5151; }

/* ===== 页面容器（统一底部安全区留白） ===== */
/* 注：页面背景挂在 .container 上而非 page 上 —— dm-light/dm-dark 类挂在此元素，
   var(--bg) 才能正确解析跟随；page 上的 var(--bg) 永远是基础值 */
.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
  background-color: var(--bg);
}

/* ===== 间距工具类（统一分割/留白，按需扩展） =====
   mb-<n> = margin-bottom <n>rpx */
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }

/* ============================================================
   原语 4：按钮 Button
   默认高 48px(96rpx)、圆角 8px(16rpx)；变体 primary(绿)/default(灰)/warn(红)/disabled
   ============================================================ */
.weui-btn {
  display: block;
  width: auto;
  max-width: 560rpx;
  margin: 0 auto;
  padding: 24rpx 48rpx;            /* 高 ≈ 96rpx（@weuiBtnHeight 48px） */
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  line-height: 1.41176471;
  text-align: center;
  color: #fff;
  border-radius: 16rpx;            /* @weuiBtnBorderRadius 8px */
  border: none;
  box-sizing: border-box;
  position: relative;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  user-select: none;
}
.weui-btn::after { border: none; }
.weui-btn:active { opacity: 0.85; }

.weui-btn_primary { background-color: var(--brand); color: #fff; }
/* 默认按钮底 = WeUI 官方 FG-5 的半透明叠加（项目令牌 --btn-default）。
   这里**不能用不透明实色**：同一枚按钮既要落在页面 --bg 上
   （stage 的「晋级下一阶段」进度按钮 —— 它靠 transparent 透出这层底色），
   又要落在 --card 上（弹窗里的「取消」），而 .weui-btn::after 的边框已按项目约定去掉，
   实色必有一处与背景同色而隐形。两次踩坑：先用 --cell-active
   （#ececec vs --bg #ededed 只差 1 个色阶），后改 --card（又正好等于弹窗自身底色）。 */
.weui-btn_default { background-color: var(--btn-default); color: var(--text); }
.weui-btn_warn { background-color: var(--danger); color: #fff; }
.weui-btn_disabled { background-color: #C7C7CC; color: #fff; pointer-events: none; }
.weui-btn_disabled:active { opacity: 1; }
/* 深色禁用色：原写的是 .dm-dark，但深色已固定跟随系统、dm-dark 不再挂载，
   故必须改成 .dm-auto + 媒体查询才生效 */
@media (prefers-color-scheme: dark) {
  .dm-auto .weui-btn_disabled { background-color: #3A3A3C; }
}

/* 满宽：用 .weui-btn.weui-btn_block 提高特异性(0,2,0)，盖过原生 button 默认
   wx-button:not([size=mini]) 的 width:184px(0,1,1)，否则满宽不生效 */
.weui-btn.weui-btn_block {
  display: block;
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
}
.weui-btn_inline { display: inline-block; }

/* 按钮区：居中堆叠（上 48px） / 并排 / 底部固定栏 */
.weui-btn-area {
  padding: 96rpx 32rpx 16rpx;     /* 上48px(96rpx) 左右16px(32rpx) 下8px(16rpx)，对齐 @weuiBtnAreaGap */
  box-sizing: border-box;
}
.weui-btn-area_inline {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;                      /* @weuiBtnDefaultGap 16px(32rpx) */
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.weui-btn-area_inline .weui-btn { flex: 1; max-width: none; margin: 0; }
.weui-btn-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--card);
  box-sizing: border-box;
}

/* ============================================================
   原语 10：徽标 / 标签 Badge / Tag
   ============================================================ */
.weui-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  min-width: 32rpx;
  background: var(--danger);
  color: #fff;
  font-size: calc(24rpx * var(--fs, 1));
  border-radius: 32rpx;
  line-height: 1.2;
  text-align: center;
}
.weui-cell__ft .weui-badge { margin-left: 16rpx; }

.weui-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: calc(24rpx * var(--fs, 1));
  border-radius: 8rpx;
  line-height: 1.4;
}
.weui-tag_default { color: var(--text2); background: var(--card2); }

/* ============================================================
   原语 8：弹窗类 Dialog / ActionSheet / Toast
   蒙层 OVERLAY；dialog 卡片 #fff 圆角 12px(24rpx)；主操作 BRAND(品牌绿，项目约定)
   ============================================================ */
.weui-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);   /* OVERLAY light */
  z-index: 1000;
}
.dm-dark .weui-mask,
.dm-auto .weui-mask { background: rgba(0, 0, 0, 0.8); }

.weui-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 640rpx;
  background: var(--card);
  border-radius: 24rpx;            /* @weuiDialogBorderRadius 12px */
  text-align: center;
  overflow: hidden;
  z-index: 1001;
}
.weui-dialog__hd { padding: 64rpx 48rpx 32rpx; }
.weui-dialog__title { font-weight: 500; font-size: calc(34rpx * var(--fs, 1)); line-height: 1.4; color: var(--text); }
.weui-dialog__bd { padding: 0 48rpx; margin-bottom: 64rpx; font-size: calc(34rpx * var(--fs, 1)); line-height: 1.4; color: var(--text2); }
.weui-dialog__bd:first-child { padding: 64rpx 48rpx 0; font-weight: 500; color: var(--text); }
.weui-dialog__ft { position: relative; display: flex; }
.weui-dialog__ft::before {
  content: " ";
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1px;
  background: var(--divider);             /* DIALOG-LINE-COLOR */
  transform: scaleY(0.5);
  transform-origin: top;
}
.weui-dialog__btn {
  flex: 1;
  padding: 40rpx 16rpx;
  font-size: calc(34rpx * var(--fs, 1));
  line-height: 1.41176471;
  font-weight: 500;
  color: var(--brand);             /* 主操作品牌绿（项目约定） */
  position: relative;
}
.weui-dialog__btn::before {
  content: " ";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 1px;
  background: var(--divider);
  transform: scaleX(0.5);
  transform-origin: left;
}
.weui-dialog__btn:first-child::before { display: none; }
.weui-dialog__btn:active { background: var(--cell-active); }
.weui-dialog__btn_default { color: var(--text2); }
.weui-dialog__btn_warn { color: var(--danger); }

.weui-actionsheet {
  position: fixed;
  left: 0; bottom: 0;
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
}
.weui-actionsheet__title { padding: 32rpx; color: var(--text2); font-size: calc(28rpx * var(--fs, 1)); text-align: center; }
.weui-actionsheet__menu { background: var(--card); }
.weui-actionsheet__cell {
  position: relative;
  padding: 36rpx;
  text-align: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}
.weui-actionsheet__cell:active { background: var(--cell-active); }
.weui-actionsheet__action { margin-top: 16rpx; background: var(--card); }

.weui-toast {
  position: fixed;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  min-width: 240rpx;
  text-align: center;
  z-index: 5000;
}
.weui-toast__content { margin-top: 16rpx; font-size: calc(28rpx * var(--fs, 1)); }

/* ============================================================
   原语：弹层表单（卡片 + 行 + 控件 + 分段快捷值）
   半屏弹层里的内容原语 —— components/half-sheet 只管外壳，内容样式归使用方。
   原先在 pages/stage（打卡弹窗 / 晋级弹窗）、pages/myResources、pages/targetSetting
   各存一份且取值一致，此处收敛为一处；改弹层表单观感只改这里。

   用法：.form-card 包若干 .form-row，行间用全局 .weui-divider 分节；
   只读参考行加 .form-row-static + .form-label-muted（整行降一级，不与可填项抢注意力）
   ============================================================ */
/* 底色取 --card2 而非 --card：与半屏弹层外壳（--card）拉开一档之后，
   卡片的边界、16rpx 圆角与左右 32rpx 内缩才读得出来 —— 同色时这三样都不可见，
   32rpx 内缩只会显得"没和弹层标题对齐"。
   卡片变浅灰后，行按压反馈不能再用 --cell-active，见下方 .form-row:active */
.form-card {
  background: var(--card2);
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}
/* 行高 112rpx = 56px = WeUI 的 cell 标准行高（@weuiCellHeight），
   也是 backfill 页 .bf-row 的取值。
   上下内边距 12rpx + 内容区 88rpx：输入框正好放得下 ——
   只改 min-height 而不动 padding 的话，88rpx 的输入框会把这一行撑得比邻行高出一截 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}
/* 按压反馈借 --divider 的色值：卡片底改为 --card2 后，--cell-active 的对比只剩 11 个色阶
   （#ececec on #f7f7f7，按住几乎看不出来），而 --divider 浅色是实色 #e5e5e5、深色是
   rgba(255,255,255,.1) 叠在 #202020 上 → 浅色差 18、深色差 23，与原先落在 --card 上的手感相当。
   语义上 --divider 也是「一档浅灰」，与分隔线共用同一档色值，故未新增令牌；
   ⚠️ 若将来把 .form-card 的底色改回 --card，这里应一并换回 --cell-active */
.form-row:active { background: var(--divider); }
/* 只读行不给按压反馈，避免暗示可点 */
.form-row-static:active { background: transparent; }
.form-label {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  width: 140rpx;
}
/* 参考信息的标签降一级 */
.form-label-muted { color: var(--text2); }
.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
/* 输入框 88rpx（44pt）= 项目「可点项最小热区 ≥ 88rpx」的口径，与 backfill 的 .bf-dur-input、
   editRecord 的 .cell-input 同值；正好等于行高 112rpx 减去上下 padding 24rpx */
.form-field {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 88rpx;
}
.form-unit {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  margin-left: 8rpx;
}
/* 行内的只读值（右对齐由 .form-right 负责，这里只管字号与层级） */
.form-static {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
}
/* 行内的箭头：.weui-cell__ft .icon-right 只管 cell，form-row 需要自己一条 */
.form-row .icon-right {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 分段快捷值（打卡弹窗的 10/15/20/25/30 分钟、目标时长的 60H/80H） */
.seg-control { display: flex; align-items: center; flex: 1; }
/* 等宽变体：行内铺满（打卡弹窗的 5 个快捷时长用它） */
.seg-control-grid .seg-item { flex: 1; text-align: center; }
.seg-item {
  height: 56rpx;
  padding: 0 32rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--divider);
  border-radius: 8rpx;
  background: var(--card);
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  box-sizing: border-box;
}
.seg-item:first-child { margin-left: 0; }
.seg-item:active { background: var(--cell-active); }
.seg-active { border-color: var(--brand); color: var(--brand); background: var(--card); }

/* ============================================================
   原语：卡片 .weui-panel（内容卡：圆角 + 极淡阴影，区别于裸列表）
   ============================================================ */
.weui-panel {
  background: var(--card);
  border-radius: 20rpx;           /* iOS 分组卡片圆角 10pt(20rpx) */
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.weui-panel__hd {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.weui-panel__bd { color: var(--text); }

/* ============================================================
   记录标签配色（打卡记录列表：阶段 / 分类 / 备注 / 补录）
   浅色「浅底深字」→ 深色「深底亮字」（同色相 16% 透明底）。
   浅 / 深两档必须写在同一节：此前浅色留在 pages/records/records.wxss、
   深色留在这里，两边分开维护，结果 .tag-stage 只补了浅色 ——
   深色下「常规N」仍是 #fff7e6 浅底，在 #191919 卡片上亮成一块。
   ============================================================ */
/* 阶段标签（常规N）：金棕，与「科普拓展」的琥珀刻意错开一档 */
.tag-stage { color: #7a5200; background: #fff7e6; }

/* 各分类标签颜色 */
.tag-group-main_picture_books { color: #1a5fb0; background: #e8f1fb; }
.tag-group-main_graded_readers { color: #4a26a8; background: #f0eafc; }
.tag-group-main_animations { color: #c4390e; background: #fff1ea; }
.tag-group-sub_graded_readers { color: #006d75; background: #e6fffb; }
.tag-group-sub_animations { color: #b0156e; background: #fff0f6; }
.tag-group-fun_extensions { color: #389e0d; background: #f0ffe0; }
.tag-group-science_extensions { color: #ad6800; background: #fffbe6; }
.tag-group-fusion_apps { color: #531dab; background: #f5f0ff; }
.tag-group-listening_audio { color: #37474f; background: #eceff1; }
.tag-group-default { color: var(--text3); background: var(--cell-active); }

/* 备注：单行截断（颜色 / 底色见下方深色档配套） */
.record-remark {
  color: #52c41a;
  background: #f0fff0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 补录标记（中性灰，弱于分类彩色标签；走变量、无需深色档） */
.record-backfill {
  color: var(--text2);
  background: var(--cell-active);
}

/* ---- 深色档 ---- */
.dm-dark .tag-group-main_picture_books { color: #7fb4f7; background: rgba(127, 180, 247, 0.16); }
.dm-dark .tag-group-main_graded_readers { color: #b39df5; background: rgba(179, 157, 245, 0.16); }
.dm-dark .tag-group-main_animations { color: #ff9c6e; background: rgba(255, 156, 110, 0.16); }
.dm-dark .tag-group-sub_graded_readers { color: #5cd3dc; background: rgba(92, 211, 220, 0.16); }
.dm-dark .tag-group-sub_animations { color: #ff9ecb; background: rgba(255, 158, 203, 0.16); }
