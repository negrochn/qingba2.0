/* 全局样式 —— 设计系统以 WeUI 官方（Tencent/weui v2.6.26）为权威来源，
   全部色板 / 字号 / 间距 / 圆角沿用 .codebuddy/skills/ui-design-spec 的 token。
   类名采用 WeUI 规范（.weui-*）。颜色统一引用项目 --* 变量（已对齐 WeUI，见 skill design-tokens.md §9）。 */

/* ===== 主题色板（--* 变量，已对齐 WeUI） =====
   浅色为默认；深色通过根节点 class（dm-light / dm-dark / dm-auto）切换 CSS 变量。
   对应 WeUI：--bg=BG-0 / --card=BG-2 / --text=FG-0(主文字) / --text2=FG-1(次级) /
   --text3=FG-2(三级·占位) / --divider≈FG-3 / --brand=BRAND /
   --danger=RED / --cell-active≈BG-COLOR-ACTIVE */
page {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f8fa;
  --text: #1a1a1a;                  /* FG-0 rgba(0,0,0,.9) 主文字 */
  --text2: #737373;                 /* FG-1 rgba(0,0,0,.55) 次级：标题 / 说明 / cell 值 */
  --text3: #b2b2b2;                 /* FG-2 rgba(0,0,0,.3) 三级 / 占位 */
  --divider: #e5e5e5;               /* ≈FG-3 rgba(0,0,0,.1) 分隔线 */
  --brand: #07C160;
  --danger: #fa5151;               /* RED light */
  --cell-active: #f5f5f5;
  /* 默认浅色背景；系统深色时由下方 media query 覆盖为深色。
     这里不能用 var(--bg) —— dm-light/dm-dark 类挂在 .container 上，
     变量只能向下继承，page 上解析到的永远是基础值 #ededed。*/
  background-color: #ededed;
  color: var(--text);
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 跟随系统深色：把 page 背景改为深色，覆盖 app.json.backgroundColor 的固定值。
   解决 nav bar 下方露出 page 浅色底的小亮色条问题。*/
@media (prefers-color-scheme: dark) {
  page { background-color: #111; }
}

view, text {
  box-sizing: border-box;
}

/* iconfont 字族：base64 data URI 在全局 app.wxss 内联注册 @font-face。
   之前 WXSS 用本地相对路径的 @font-face 被开发者工具强制改写为 -do-not-use-local-path- 拒绝加载；
   而 wx.loadFontFace 在 App.onLaunch 调用仅作用于 App 所在 webview，无法跨页面下发到各页面 webview。
   全局 app.wxss 会注入每个页面 webview，故在此内联注册字族后所有页面可直接使用。
   关键坑：微信开发者工具内置 Chromium 对 woff 的 data URI 渲染支持很差（真机 WebView 正常），
   单独用 woff 时模拟器里图标会变成方块/异常。故 src 顺序为 ttf 优先（开发者工具与真机都能识别 ttf），
   woff 兜底（体积更小），二者都内联，所有页面 webview 通用。 */
@font-face {
  font-family: "iconfont";
      src: url(data:application/x-font-ttf;base64,) format("truetype"),
       url(data:application/font-woff;base64,) format("woff");
  font-weight: normal;
  font-style: normal;
}

/* 手动浅色（系统深色时强制浅色内容区） */
.dm-light {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f8fa;
  --text: #1a1a1a;                  /* FG-0 主文字 */
  --text2: #737373;                 /* FG-1 次级 */
  --text3: #b2b2b2;                 /* FG-2 三级 / 占位 */
  --divider: #e5e5e5;               /* ≈FG-3 分隔线 */
  --brand: #07C160;
  --danger: #fa5151;               /* RED light */
  --cell-active: #f5f5f5;
}

/* 手动深色（微信官方深色色板：BG #111 / 卡片 #1C1C1E / 文字 FG-0 .8 / FG-1 .5 / FG-2 .3） */
.dm-dark {
  --bg: #111111;
  --card: #1c1c1e;
  --card2: #232326;
  --text: rgba(255, 255, 255, 0.8);     /* FG-0 dark 主文字 */
  --text2: rgba(255, 255, 255, 0.5);    /* FG-1 dark 次级 */
  --text3: rgba(255, 255, 255, 0.3);    /* FG-2 dark 三级 / 占位 */
  --divider: rgba(255, 255, 255, 0.1);
  --brand: #07C160;
  --danger: #fa5151;               /* RED dark（与浅色一致，WeUI RED 不随深浅变化） */
  --cell-active: #2c2c2e;
}

/* 跟随系统 */
@media (prefers-color-scheme: dark) {
  .dm-auto {
    --bg: #111111;
    --card: #1c1c1e;
    --card2: #232326;
    --text: rgba(255, 255, 255, 0.8);     /* FG-0 dark 主文字 */
    --text2: rgba(255, 255, 255, 0.5);    /* FG-1 dark 次级 */
    --text3: rgba(255, 255, 255, 0.3);    /* FG-2 dark 三级 / 占位 */
    --divider: rgba(255, 255, 255, 0.1);
    --brand: #07C160;
    --danger: #fa5151;               /* RED dark（与浅色一致，WeUI RED 不随深浅变化） */
    --cell-active: #2c2c2e;
  }
}

/* ===== 字号档位（无障碍：跟随系统字号缩放） =====
   档位 class 挂在页面根节点上，子节点所有 calc(Nrpx * var(--fs)) 自动缩放 */
.fs-small { --fs: 0.9; font-size: calc(28rpx * var(--fs, 1)); }
.fs-normal { --fs: 1; font-size: calc(28rpx * var(--fs, 1)); }
.fs-large { --fs: 1.15; font-size: calc(28rpx * var(--fs, 1)); }
.fs-xlarge { --fs: 1.3; font-size: calc(28rpx * var(--fs, 1)); }

/* ===== 页面容器（统一底部安全区留白） ===== */
/* 注：页面背景挂在 .container 上而非 page 上 —— dm-light/dm-dark 类挂在此元素，
   var(--bg) 才能正确解析跟随；page 上的 var(--bg) 永远是基础值 */
.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
  background-color: var(--bg);
}

/* ===== 间距工具类（统一分割/留白，按需扩展） =====
   mb-<n> = margin-bottom <n>rpx */
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }

/* ============================================================
   原语 1：列表分组容器 .weui-cells（WeUI 原生：无圆角、无阴影，
   靠上间距与灰底分组；上下 1px 通栏分隔线）
   ============================================================ */
.weui-cells {
  background-color: var(--card);
  position: relative;
  overflow: hidden;
}
.weui-cells::before,
.weui-cells::after {
  content: " ";
  position: absolute;
  left: 0; right: 0;
  height: 1rpx;
  border-top: 1rpx solid var(--divider);
  pointer-events: none;
}
.weui-cells::before { top: -1rpx; }
.weui-cells::after { bottom: -1rpx; }

/* 分组标题 / 说明（纯灰文字，无彩色竖条；margin-top/margin-bottom 已合入 padding，左右统一 32rpx） */
.weui-cells__title {
  padding: 32rpx 32rpx 6rpx;       /* 上=原 margin-top，左右 32rpx，下=WeUI 原 margin-bottom 3px(6rpx) */
  color: var(--text2);
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 分组标题 */
  line-height: 1.4;
}
.weui-cells__tips {
  margin-top: 16rpx;
  padding: 0 32rpx;
  color: var(--text2);
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.4;
}
.weui-cells__tips a { color: var(--brand); }

/* 通用分隔线（非 cell 上下文，如表单卡片内行分隔；细线 1px） */
.weui-divider {
  height: 1rpx;
  background: var(--divider);
  margin: 0;
}

/* ============================================================
   原语 2：单元格 .weui-cell（左文右值，可点击/箭头/开关）
   行高 56px(112rpx) 由 padding + 字号自然撑出；单元格间 0.5px 分隔线 left 缩进 32rpx，首行无
   ============================================================ */
.weui-cell {
  position: relative;
  padding: 32rpx;                   /* @weuiCellGapV/H 16px */
  display: flex;
  align-items: center;
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  line-height: 1.41176471;
  color: var(--text);
  min-height: 112rpx;               /* @weuiCellHeight 56px，保证点击热区 */
}
.weui-cell::before {
  content: " ";
  position: absolute;
  left: 32rpx; right: 0; top: 0;
  height: 1rpx;
  border-top: 1rpx solid var(--divider);
}
.weui-cell:first-child::before { display: none; }
.weui-cell:active { background-color: var(--cell-active); }

.weui-cell__hd {                   /* 行首图标列 */
  margin-right: 16rpx;             /* 8px(16rpx) */
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-size: calc(40rpx * var(--fs, 1));
  line-height: 1;
}
.weui-cell__bd {                   /* 左侧主内容（标题 / 堆叠 label+desc） */
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}
.weui-cell__bd_text {              /* 纯标题文字（34rpx 主文） */
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.41176471;
}
.weui-cell__desc {                 /* 描述文字（12px FG-2） */
  display: block;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
  margin-top: 4rpx;
}
.weui-cell__ft {                   /* 右侧内容（值 / 箭头 / 开关） */
  flex-shrink: 0;
  max-width: 60%;
  text-align: right;
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.weui-cell__ft_value {             /* 右侧值文字（34rpx，FG-1） */
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.41176471;
}
.weui-cell__ft_value.placeholder { opacity: 0.6; }

/* 箭头（iconfont .icon-right，色随 FG-2） */
.weui-cell__ft .icon-right {
  font-size: calc(34rpx * var(--fs, 1)) !important;
  color: var(--text3);
  line-height: 1.4;
  margin-left: 12rpx;
}

/* 变体 */
.weui-cell_access { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); }   /* 可点击带箭头 */
.weui-cell_link .weui-cell__bd { color: var(--brand); }               /* 链接蓝（项目用品牌绿） */
.weui-cell_warn .weui-cell__bd { color: var(--danger); }              /* 警告红 */
.weui-cell_empty {
  padding: 48rpx 32rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  text-align: center;
  min-height: auto;
}

/* ============================================================
   原语 7：单选 .weui-cells_radio（选中标记统一品牌绿对勾）
   ============================================================ */
.weui-cells_radio .weui-cell__ft { max-width: none; }
.weui-cells_radio .weui-icon-checked {
  font-size: calc(44rpx * var(--fs, 1)) !important;
  color: var(--brand);             /* 选中态品牌绿对勾 */
  line-height: 1;
  flex-shrink: 0;
}
.weui-cells_radio .weui-icon-checked.is-hidden { display: none; }

/* ============================================================
   原语 4：按钮 Button
   默认高 48px(96rpx)、圆角 8px(16rpx)；变体 primary(绿)/default(灰)/warn(红)/disabled
   ============================================================ */
.weui-btn {
  display: block;
  width: auto;
  max-width: 560rpx;
  margin: 0 auto;
  padding: 24rpx 48rpx;            /* 高 ≈ 96rpx（@weuiBtnBorderRadius 8px） */
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  line-height: 1.41176471;
  text-align: center;
  color: #fff;
  border-radius: 16rpx;            /* @weuiBtnBorderRadius 8px */
  border: none;
  box-sizing: border-box;
  position: relative;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  user-select: none;
}
.weui-btn::after { border: none; }
.weui-btn:active { opacity: 0.85; }

.weui-btn_primary { background-color: var(--brand); color: #fff; }
.weui-btn_default { background-color: var(--cell-active); color: var(--text); }
.weui-btn_warn { background-color: var(--danger); color: #fff; }
.weui-btn_disabled { background-color: #C7C7CC; color: #fff; pointer-events: none; }
.weui-btn_disabled:active { opacity: 1; }
.dm-dark .weui-btn_disabled { background-color: #3A3A3C; }

/* 满宽：用 .weui-btn.weui-btn_block 提高特异性(0,2,0)，盖过原生 button 默认
   wx-button:not([size=mini]) 的 width:184px(0,1,1)，否则满宽不生效 */
.weui-btn.weui-btn_block {
  display: block;
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
}
.weui-btn_inline { display: inline-block; }

/* 按钮区：居中堆叠（上 48px） / 并排 / 底部固定栏 */
.weui-btn-area {
  padding: 96rpx 32rpx 16rpx;     /* 上48px(96rpx) 左右16px(32rpx) 下8px(16rpx)，对齐 @weuiBtnAreaGap */
  box-sizing: border-box;
}
.weui-btn-area_inline {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;                      /* @weuiBtnDefaultGap 16px(32rpx) */
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.weui-btn-area_inline .weui-btn { flex: 1; max-width: none; margin: 0; }
.weui-btn-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--card);
  box-sizing: border-box;
}

/* ============================================================
   原语 10：徽标 / 标签 Badge / Tag
   ============================================================ */
.weui-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  min-width: 32rpx;
  background: var(--danger);
  color: #fff;
  font-size: calc(24rpx * var(--fs, 1));
  border-radius: 32rpx;
  line-height: 1.2;
  text-align: center;
}
.weui-cell__ft .weui-badge { margin-left: 16rpx; }

.weui-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: calc(24rpx * var(--fs, 1));
  border-radius: 8rpx;
  line-height: 1.4;
}
.weui-tag_default { color: var(--text2); background: var(--card2); }

/* ============================================================
   原语 8：弹窗类 Dialog / ActionSheet / Toast
   蒙层 OVERLAY；dialog 卡片 #fff 圆角 12px(24rpx)；主操作 BRAND(品牌绿，项目约定)
   ============================================================ */
.weui-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);   /* OVERLAY light */
  z-index: 1000;
}
.dm-dark .weui-mask,
.dm-auto .weui-mask { background: rgba(0, 0, 0, 0.8); }

.weui-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 640rpx;
  background: var(--card);
  border-radius: 24rpx;            /* @weuiDialogBorderRadius 12px */
  text-align: center;
  overflow: hidden;
  z-index: 1001;
}
.weui-dialog__hd { padding: 64rpx 48rpx 32rpx; }
.weui-dialog__title { font-weight: 500; font-size: calc(34rpx * var(--fs, 1)); line-height: 1.4; color: var(--text); }
.weui-dialog__bd { padding: 0 48rpx; margin-bottom: 64rpx; font-size: calc(34rpx * var(--fs, 1)); line-height: 1.4; color: var(--text2); }
.weui-dialog__bd:first-child { padding: 64rpx 48rpx 0; font-weight: 500; color: var(--text); }
.weui-dialog__ft { position: relative; display: flex; }
.weui-dialog__ft::before {
  content: " ";
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1rpx;
  border-top: 1rpx solid var(--divider);   /* DIALOG-LINE-COLOR */
}
.weui-dialog__btn {
  flex: 1;
  padding: 40rpx 16rpx;
  font-size: calc(34rpx * var(--fs, 1));
  line-height: 1.41176471;
  font-weight: 500;
  color: var(--brand);             /* 主操作品牌绿（项目约定） */
  position: relative;
}
.weui-dialog__btn::before {
  content: " ";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 1rpx;
  border-left: 1rpx solid var(--divider);
}
.weui-dialog__btn:first-child::before { display: none; }
.weui-dialog__btn:active { background: var(--cell-active); }
.weui-dialog__btn_default { color: var(--text2); }
.weui-dialog__btn_warn { color: var(--danger); }

.weui-actionsheet {
  position: fixed;
  left: 0; bottom: 0;
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
}
.weui-actionsheet__title { padding: 32rpx; color: var(--text2); font-size: calc(28rpx * var(--fs, 1)); text-align: center; }
.weui-actionsheet__menu { background: var(--card); }
.weui-actionsheet__cell {
  position: relative;
  padding: 36rpx;
  text-align: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}
.weui-actionsheet__cell:active { background: var(--cell-active); }
.weui-actionsheet__action { margin-top: 16rpx; background: var(--card); }

.weui-toast {
  position: fixed;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  min-width: 240rpx;
  text-align: center;
  z-index: 5000;
}
.weui-toast__content { margin-top: 16rpx; font-size: calc(28rpx * var(--fs, 1)); }

/* ============================================================
   原语：卡片 .weui-panel（内容卡：圆角 + 极淡阴影，区别于裸列表）
   ============================================================ */
.weui-panel {
  background: var(--card);
  border-radius: 20rpx;           /* iOS 分组卡片圆角 10pt(20rpx) */
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.weui-panel__hd {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.weui-panel__bd { color: var(--text); }

/* ============================================================
   iconfont（Project id 5231154）
   维护说明：后续在 iconfont.cn 增删图标后，重新下载并把 iconfont.ttf / iconfont.woff
   覆盖到 assets/fonts/ 目录，运行 scripts/gen_iconfont_base64.ps1 输出新的 base64 data URI，
   同步替换本文件顶部 @font-face src 中的 data URI 段，并按 iconfont.css 更新下方
   .icon-* 类的 content 编码。字族在全局 app.wxss 以 @font-face 注册，对所有页面 webview 生效
   （之前 WXSS 本地路径 @font-face 会被开发者工具改写为 -do-not-use-local-path-；改在 App.onLaunch
   用 wx.loadFontFace 又仅作用于 App 所在 webview，跨页面失效，故最终方案是 WXSS 内联 data URI）。
   ============================================================ */
.iconfont {
  font-family: "iconfont" !important;
  font-size: 32rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.icon-check:before { content: "\e645"; }
.icon-right:before { content: "\e6a3"; }
.icon-homefill:before { content: "\e6bb"; }
.icon-lock:before { content: "\e6c0"; }
.icon-unlock:before { content: "\e6c2"; }
.icon-myfill:before { content: "\e78c"; }
.icon-circlefill:before { content: "\e7b0"; }
.icon-info:before { content: "\e6e5"; }
.icon-squarecheck:before { content: "\e6d6"; }
.icon-rank:before { content: "\e722"; }
.icon-settings:before { content: "\e68a"; }
.icon-location:before { content: "\e651"; }
.icon-circle:before { content: "\e7b1"; }
.icon-home:before { content: "\e6b8"; }
.icon-my:before { content: "\e78b"; }
.icon-calendar:before { content: "\e74a"; }

/* ============================================================
   全局深色适配（微信小程序深色规范）
   分类彩色标签：浅色为浅底深字，深色转为深底亮字（复用原配色语义）
   ============================================================ */
.dm-dark .tag-group-main_picture_books { color: #7fb4f7; background: rgba(127, 180, 247, 0.16); }
.dm-dark .tag-group-main_graded_readers { color: #b39df5; background: rgba(179, 157, 245, 0.16); }
