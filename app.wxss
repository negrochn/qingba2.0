/* 全局样式 */

/* ===== 主题色板（浅色为默认） =====
   深色模式通过根节点 class（dm-light / dm-dark / dm-auto）切换 CSS 变量 */
page {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f8fa;
  --text: #1a1a1a;
  --text2: #6b6b6b;
  --text3: #737373;
  --text4: #b2b2b2;
  --divider: #ebedf0;
  --brand: #00c25f;
  --danger: #FF3B30;               /* iOS systemRed light */
  --cell-active: #f5f5f5;
  background-color: var(--bg);
  color: var(--text);
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text {
  box-sizing: border-box;
}

/* iconfont 字族：base64 data URI 在全局 app.wxss 内联注册 @font-face。
   之前 WXSS 用本地相对路径的 @font-face 被开发者工具强制改写为 -do-not-use-local-path- 拒绝加载；
   而 wx.loadFontFace 在 App.onLaunch 调用仅作用于 App 所在 webview，无法跨页面下发到各页面 webview。
   全局 app.wxss 会注入每个页面 webview，故在此内联注册字族后所有页面可直接使用。
   data URI MIME 用 application/font-woff（旧版 Chromium / WeChat 开发者工具内置 Chromium 不识别 font/woff，仅真机新 WebView 认）。 */
@font-face {
  font-family: "iconfont";
  src: url(data:application/font-woff;base64,) format("woff");
  font-weight: normal;
  font-style: normal;
}

/* 手动浅色（系统深色时强制浅色内容区） */
.dm-light {
  --bg: #ededed;
  --card: #ffffff;
  --card2: #f7f8fa;
  --text: #1a1a1a;
  --text2: #6b6b6b;
  --text3: #737373;
  --text4: #b2b2b2;
  --divider: #ebedf0;
  --brand: #00c25f;
  --danger: #FF3B30;               /* iOS systemRed light */
  --cell-active: #f5f5f5;
}

/* 手动深色（微信官方深色色板：BG #111 / 卡片 #1C1C1E / 文字 rgba(255,255,255,.9/.6/.35)） */
.dm-dark {
  --bg: #111111;
  --card: #1c1c1e;
  --card2: #232326;
  --text: rgba(255, 255, 255, 0.92);
  --text2: rgba(255, 255, 255, 0.78);
  --text3: rgba(255, 255, 255, 0.62);
  --text4: rgba(255, 255, 255, 0.42);
  --divider: rgba(255, 255, 255, 0.1);
  --brand: #33d17a;
  --danger: #FF453A;               /* iOS systemRed dark */
  --cell-active: #2c2c2e;
}

/* 跟随系统 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #111111;
  }

  .dm-auto {
    --bg: #111111;
    --card: #1c1c1e;
    --card2: #232326;
    --text: rgba(255, 255, 255, 0.92);
    --text2: rgba(255, 255, 255, 0.78);
    --text3: rgba(255, 255, 255, 0.62);
    --text4: rgba(255, 255, 255, 0.42);
    --divider: rgba(255, 255, 255, 0.1);
    --brand: #33d17a;
    --danger: #FF453A;               /* iOS systemRed dark */
    --cell-active: #2c2c2e;
  }
}

/* ===== 字体大小档位 =====
   档位 class 挂在页面根节点上，子节点所有 calc(Nrpx * var(--fs)) 自动缩放 */
.fs-small {
  --fs: 0.9;
  font-size: calc(28rpx * var(--fs, 1));
}

.fs-normal {
  --fs: 1;
  font-size: calc(28rpx * var(--fs, 1));
}

.fs-large {
  --fs: 1.15;
  font-size: calc(28rpx * var(--fs, 1));
}

.fs-xlarge {
  --fs: 1.3;
  font-size: calc(28rpx * var(--fs, 1));
}

/* 公共容器：所有页面统一使用，后续调整容器留白只改此处 */
.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #00c25f;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #eef4fb;
  color: #00c25f;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--fs, 1));
  margin: 6rpx 6rpx 6rpx 0;
}

/* ===== 间距工具类（公共，单行单职责，统一分割/留白） =====
   命名 mb-<n> = margin-bottom <n>rpx；当前仅 16，按需扩展 mb-8 / mb-24 等 */
.mb-16 { margin-bottom: 16rpx; }

/* ===== 全局深色适配（微信小程序深色规范） =====
   分类彩色标签：浅色为浅底深字，深色转为深底亮字 */
.dm-dark .tag-group-main_picture_books { color: #7fb4f7; background: rgba(127, 180, 247, 0.16); }
.dm-dark .tag-group-main_graded_readers { color: #b39df5; background: rgba(179, 157, 245, 0.16); }
.dm-dark .tag-group-main_animations { color: #ff9c6e; background: rgba(255, 156, 110, 0.16); }
.dm-dark .tag-group-sub_graded_readers { color: #5cd3dc; background: rgba(92, 211, 220, 0.16); }
.dm-dark .tag-group-sub_animations { color: #ff9ecb; background: rgba(255, 158, 203, 0.16); }
.dm-dark .tag-group-fun_extensions { color: #95de64; background: rgba(149, 222, 100, 0.16); }
.dm-dark .tag-group-science_extensions { color: #ffd666; background: rgba(255, 214, 102, 0.16); }
.dm-dark .tag-group-fusion_apps { color: #b37feb; background: rgba(179, 127, 235, 0.16); }

/* 备注标签 */
.dm-dark .record-remark { color: #95de64; background: rgba(149, 222, 100, 0.16); }

/* 弹层遮罩统一为深色规范值 */
.dm-dark .ci-mask-show,
.dm-dark .pm-mask-show,
.dm-dark .mp-mask.show { background: rgba(0, 0, 0, 0.5); }

@media (prefers-color-scheme: dark) {
  .dm-auto .tag-group-main_picture_books { color: #7fb4f7; background: rgba(127, 180, 247, 0.16); }
  .dm-auto .tag-group-main_graded_readers { color: #b39df5; background: rgba(179, 157, 245, 0.16); }
  .dm-auto .tag-group-main_animations { color: #ff9c6e; background: rgba(255, 156, 110, 0.16); }
  .dm-auto .tag-group-sub_graded_readers { color: #5cd3dc; background: rgba(92, 211, 220, 0.16); }
  .dm-auto .tag-group-sub_animations { color: #ff9ecb; background: rgba(255, 158, 203, 0.16); }
  .dm-auto .tag-group-fun_extensions { color: #95de64; background: rgba(149, 222, 100, 0.16); }
  .dm-auto .tag-group-science_extensions { color: #ffd666; background: rgba(255, 214, 102, 0.16); }
  .dm-auto .tag-group-fusion_apps { color: #b37feb; background: rgba(179, 127, 235, 0.16); }

  .dm-auto .record-remark { color: #95de64; background: rgba(149, 222, 100, 0.16); }

  .dm-auto .ci-mask-show,
  .dm-auto .pm-mask-show,
  .dm-auto .mp-mask.show { background: rgba(0, 0, 0, 0.5); }
}

/* ===== 原语 16：.btn 按钮族（全局；规范见 skill ui-design-spec/references/components.md） =====
   来源：微信「转账说明 / 评论 / 确认弹窗」浅灰次按钮 + 品牌主按钮并排；iOS 矩形圆角 8rpx，高 88rpx。
   项目内 var(--brand) = #00c25f（品牌绿，区别于微信原生绿 #07C160；见原语 16 约定第 7 条）。 */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;                /* btn-h = cell-h = 44pt iOS */
  padding: 0 32rpx;             /* btn-pad-x */
  font-size: calc(32rpx * var(--fs, 1));   /* btn-fs */
  font-weight: 500;
  border: none;
  border-radius: 8rpx;          /* radius-btn，iOS 4pt（微信原生矩形） */
  line-height: 1;
  box-sizing: border-box;
  text-align: center;
  background: var(--cell-active);
  color: var(--text);
}
.btn::after { border: none; }   /* 清除小程序 button 默认边框 */
.btn:active { opacity: 0.85; }  /* 按下态：所有变体统一 */

/* 变体 */
.btn-primary {
  background: var(--brand);
  color: #fff;
}
.btn-secondary {
  background: var(--cell-active);
  color: var(--text);
}
.btn-danger {
  background: var(--danger);
  color: #fff;
}
.btn-disabled {
  background: #C7C7CC;
  color: #fff;
  pointer-events: none;       /* 禁用态不响应点击 */
}
.dm-dark .btn-disabled {
  background: #3A3A3C;
}
.btn-disabled:active { opacity: 1; }  /* 禁用态无按下反馈 */

/* 修饰 */
.btn-block {
  width: 100%;
  padding: 0;                /* 全宽时取消左右内边距 */
}

/* 布局容器 */
.btn-row {
  display: flex;
  justify-content: center;   /* 居中 + gap 实现，不靠两端对齐 */
  align-items: center;
  gap: 24rpx;                /* btn-gap */
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.btn-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--card);   /* 与整页背景形成层次 */
  box-sizing: border-box;
}

/* ===== 原语 1：.cell 列表项家族（全局；规范见 skill ui-design-spec）
   来源：微信分组列表（设置 / 我的）+ picker-page 单选列表。跨 settings / mine /
   stagePicker / importPicker / fontPicker / clearPicker / darkMode 七页统一后合入本文件，
   各页不再重复定义。行高 cell-h = 88rpx（44pt iOS 点击热区），左右内边距 32rpx 对称。 */

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 行高由 cell--single / cell--desc 提供（min-height）；裸 .cell 无兜底，务必加 modifier */
  padding: 24rpx 32rpx;             /* cell-pad-x：左右 32rpx 对称 */
  box-sizing: border-box;
}
.cell:active { background: var(--cell-active); }

/* 行高规格 modifier（设计稿 px → rpx，基准 750rpx = 375pt，1px = 2rpx）
   用 min-height：常规字号下即 110/146rpx（等同固定高度），超大字号自动撑高不裁切 */
.cell--single { min-height: 110rpx; }
.cell--desc { min-height: 146rpx; }

/* ===== 原语 1：.group 分组 section（全宽平铺，无圆角无侧边距） =====
   来源：微信分组列表（设置 / 我的 / picker-page 等）。跨 settings / mine / darkMode /
   stagePicker / importPicker / fontPicker / clearPicker 统一后合入本文件，各页不再重复定义。
   段间间隙由需求决定，当前 .group 不设置 margin-bottom。 */
.group-title {
  padding: 32rpx 32px 16rpx 32rpx;   /* group-title-pad：上32 右32 下16 左32（右为 px） */
  font-size: calc(26rpx * var(--fs, 1));   /* group-title 26rpx */
  color: var(--text2);
  line-height: 1;
}
.group-card {
  background: var(--card);
  margin: 0;                        /* 全宽平铺，无侧边距 */
  border-radius: 0;                 /* 无圆角 */
  overflow: hidden;                 /* spec：防子元素溢出 */
}

/* 主标题：直接作为 .cell 子元素时占满左侧，把右侧元素推到最右 */
.cell-label {
  font-size: calc(34rpx * var(--fs, 1));   /* 原语：row 主文 34rpx */
  color: var(--text);
  line-height: 1.4;
}
.cell > .cell-label {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

/* 含说明文字的行：info 占满左侧（竖向堆叠 label + desc），右侧元素贴右 */
.cell-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
}
.cell-desc {
  font-size: calc(26rpx * var(--fs, 1));   /* 原语：desc 26rpx */
  color: var(--text4);
  line-height: 1.4;
  margin-top: 4rpx;
}

/* 右侧内容容器 / 值 / 占位 / 箭头 */
.cell-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 60%;
}
.cell-value {
  font-size: calc(34rpx * var(--fs, 1));   /* 原语：value 34rpx */
  color: var(--text3);
}
.cell-value.placeholder {
  color: var(--text3);
  opacity: 0.6;
}
.cell-arrow {                              /* spec 对应 .cell-chevron；箭头改用 iconfont 的 icon-right 图标（见 .icon-right） */
  font-size: calc(34rpx * var(--fs, 1)) !important;   /* !important 覆盖 .iconfont 的 32rpx 默认图标字号，保持与 value 同高 */
  color: var(--text4);
  line-height: 1;
  margin-left: 12rpx;
}

/* 行首图标（mine 页 emoji 图标列） */
.cell-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 危险操作语义色（spec #FF3B30） */
.cell-danger .cell-label { color: #FF3B30; }

/* 单选行标记（继承 .cell 基类，选中态由 .cell-check 呈现） */
.cell-radio { /* 继承 .cell 基类 */ }

/* 单选对勾（iOS systemGreen success；深色 #30D158） */
.cell-check {
  font-size: calc(34rpx * var(--fs, 1));
  color: #34C759;
  line-height: 1;
  flex-shrink: 0;
}
.dm-dark .cell-check { color: #30D158; }
@media (prefers-color-scheme: dark) {
  .dm-auto .cell-check { color: #30D158; }
}

/* 空状态（clearPicker） */
.cell-empty {
  padding: 48rpx 32rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text4);
  text-align: center;
}

/* 行间分隔线（左缩进 32rpx = cell-pad-x；mine 因图标列覆盖为 100rpx） */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 32rpx;
}

/* ===== iconfont（Project id 5231154）
   维护说明：后续在 iconfont.cn 增删图标后，重新下载并把 iconfont.ttf / iconfont.woff
   覆盖到 assets/fonts/ 目录，运行 scripts/gen_iconfont_base64.ps1 输出新的 base64 data URI，
   同步替换本文件顶部 @font-face src 中的 data URI 段，并按 iconfont.css 更新下方
   .icon-* 类的 content 编码。字族在全局 app.wxss 以 @font-face 注册，对所有页面 webview 生效
   （之前 WXSS 本地路径 @font-face 会被开发者工具改写为 -do-not-use-local-path-；改在 App.onLaunch
   用 wx.loadFontFace 又仅作用于 App 所在 webview，跨页面失效，故最终方案是 WXSS 内联 data URI）。 */

.iconfont {
  font-family: "iconfont" !important;
  font-size: 32rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-check:before { content: "\e645"; }
.icon-right:before { content: "\e6a3"; }
.icon-homefill:before { content: "\e6bb"; }
.icon-lock:before { content: "\e6c0"; }
.icon-unlock:before { content: "\e6c2"; }
.icon-myfill:before { content: "\e78c"; }
.icon-circlefill:before { content: "\e7b0"; }
