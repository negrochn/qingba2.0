/* 全局样式 */
page {
  background-color: #f5f6f8;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #4a90d9;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #eef4fb;
  color: #4a90d9;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin: 6rpx 6rpx 6rpx 0;
}

.btn-primary {
  background: #4a90d9;
  color: #fff;
  border-radius: 12rpx;
}
