/* 阶段统计详情 */

.card {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  background: var(--card);
  border-radius: 20rpx;
}

/* 核心数据 headline（无卡片，最简洁） */
.head-card {
  padding: 16rpx 32rpx 0;
}
.head-main {
  display: flex;
  align-items: baseline;
}
.head-num {
  font-size: calc(64rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  line-height: 1.1;
}
.head-unit {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  margin-left: 8rpx;
  margin-right: 8rpx;
}
.head-sub {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

/* ④ 打卡时长分布 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
}
.card-cal {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}
.echart-box {
  width: 100%;
  height: 440rpx;
}
.echart-box-ring {
  height: 520rpx;
}
.card-foot {
  margin-top: 20rpx;
  width: 100%;
}
.chip {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 20rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text);
  background: rgba(7, 193, 96, .10);
  border-radius: 12rpx;
}
/* ⑤ 汇总指标（简单 flex：前两项一行，第三项换行） */
.summary {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 32rpx 0;
}
.summary-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
  padding: 0;
}
.summary-prefix {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}
.summary-value {
  font-size: calc(40rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  margin: 0 8rpx;
}
.summary-unit {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}
.summary-arrow {
  margin-left: 8rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* ⑦ 时长排行榜（淡绿占比背景） */
.rank { margin-top: 4rpx; }
.rank-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.rank-row:last-child { margin-bottom: 0; }
.rank-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(7, 193, 96, .14);
  z-index: 0;
}
.rank-cover {
  position: relative;
  z-index: 1;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--card2);
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30rpx * var(--fs, 1));
  flex-shrink: 0;
}
.rank-name {
  position: relative;
  z-index: 1;
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-dur {
  position: relative;
  z-index: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}
.rank-empty {
  text-align: center;
  color: var(--text3);
  font-size: calc(28rpx * var(--fs, 1));
  padding: 32rpx 0;
}

/* 整页空态：该阶段无任何打卡 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 180rpx 64rpx 0;
}
.empty-icon {
  font-size: calc(96rpx * var(--fs, 1));
  color: var(--text3);
}
.empty-text {
  margin-top: 28rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
}
.empty-sub {
  margin-top: 12rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}


