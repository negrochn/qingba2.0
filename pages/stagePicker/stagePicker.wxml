<view class="container {{fontClass}} {{darkClass}}">

  <!-- 当前阶段选择（整页单选列表，选中品牌绿对勾） -->
  <view class="weui-cells weui-cells_radio">
    <view class="weui-cell" bindtap="pick" data-id="__none__">
      <view class="weui-cell__bd">未设置</view>
      <text class="weui-icon-checked iconfont icon-check" hidden="{{selectedId !== ''}}"></text>
    </view>
    <block wx:for="{{stages}}" wx:key="id" wx:for-item="s" wx:for-index="i">
      <view class="weui-cell" bindtap="pick" data-id="{{s.id}}">
        <view class="weui-cell__bd">{{s.name}}</view>
        <text class="weui-icon-checked iconfont icon-check" hidden="{{selectedId !== s.id}}"></text>
      </view>
    </block>
  </view>

</view>
