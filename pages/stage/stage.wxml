<view class="container {{fontClass}} {{darkClass}}" wx:if="{{stage}}">
  <!-- 阶段资源（核心：打卡）放在上半区，突出入口 -->
  <view wx:if="{{resourceGroups.length}}">
    <view class="weui-cells__title">
      {{subtitle}}
    </view>
    <view class="res-wrap">
    <view class="res-list" wx:for="{{resourceGroups}}" wx:for-item="g" wx:key="key">
      <view class="rg-head {{expandedGroups[g.key] ? '' : 'rg-head-folded'}} {{g.clickable && !stageLocked ? 'rg-head-active' : ''}}" data-group-key="{{g.key}}" bindtap="onToggleGroup">
        <view class="rg-head-left">
          <view class="rg-dot rg-dot-{{g.key}}"></view>
          <view class="rg-label rg-label-{{g.key}}">{{g.label}}</view>
          <view class="rg-count">{{g.items.length}} 项</view>
        </view>
        <view class="rg-head-right">
          <view class="rg-progress" wx:if="{{g.clickable && !stageLocked && groupProgress[g.key].todayMin > 0}}">
            <text class="rg-progress-val">{{groupProgress[g.key].todayMin}}m</text>
          </view>
          <view class="rg-progress rg-progress-empty" wx:elif="{{g.clickable && !stageLocked}}">
            <text>待学习</text>
          </view>
          <view class="rg-progress rg-progress-locked" wx:elif="{{g.clickable && stageLocked}}">
            <text wx:if="{{stageStatus === 'completed'}}">已完成</text>
            <text wx:else>未开始</text>
          </view>
          <view class="rg-arrow {{expandedGroups[g.key] ? 'rg-arrow-open' : ''}}">›</view>
        </view>
      </view>
      <view class="rg-body" wx:if="{{expandedGroups[g.key]}}">
        <!-- 资源行：左滑露出「读完 +1 / 撤销 −1」操作区（手势原语同打卡记录页） -->
        <view
          class="swipe-wrap"
          wx:for="{{g.items}}"
          wx:for-item="res"
          wx:key="id"
          data-path="{{res._path}}"
          data-swipeable="{{g.clickable && !stageLocked}}"
          bindtouchstart="onSwipeStart"
          bindtouchmove="onSwipeMove"
          bindtouchend="onSwipeEnd"
        >
          <!-- 滑到一半露出的操作区（未解锁 / 不参与打卡的行不渲染） -->
          <view class="swipe-bg" wx:if="{{g.clickable && !stageLocked}}">
            <view
              class="swipe-act swipe-act-read"
              catchtap="onFinishRead"
              data-group-key="{{g.key}}"
              data-resource-id="{{res.id}}"
            >
              <text class="swipe-act-main">读完</text>
              <text class="swipe-act-sub">+1</text>
            </view>
            <view
              class="swipe-act swipe-act-undo {{readCounts[g.key + '|' + res.id] >= 1 ? '' : 'swipe-act-off'}}"
              catchtap="onUndoFinishRead"
              data-group-key="{{g.key}}"
              data-resource-id="{{res.id}}"
            >
              <text class="swipe-act-main">撤销</text>
              <text class="swipe-act-sub">−1</text>
            </view>
          </view>

          <view
            class="r-row swipe-fg {{g.clickable && !stageLocked ? 'r-row-click' : ''}} {{resTotals[g.key + '|' + res.name] ? 'r-row-done' : ''}}"
            style="transform: translateX({{res._dx}}rpx); transition: {{res._anim ? 'transform 0.25s ease' : 'none'}};"
            data-group-key="{{g.key}}"
            data-group-label="{{g.label}}"
            data-resource-id="{{res.id}}"
            data-resource-name="{{res.name}}"
            bindtap="onResourceTap"
          >
            <view class="r-no" wx:if="{{readCounts[g.key + '|' + res.id] >= 1}}">{{readCounts[g.key + '|' + res.id]}}</view>
            <view class="r-no r-no-char" wx:else>{{res.name[0]}}</view>
            <view class="r-body">
              <view class="r-name">{{res.name}}<text class="r-tag" wx:if="{{res.custom}}">自定义</text></view>
              <!-- 已打卡副文：时长按「原始投入」展示（家长视角「今天听了多久」）；
                   熏听行补一句有效时长，常规1/2 有效为 0 时显示「本阶段不计入」，
                   这样 ×0 档也能看到「今天打过卡」的痕迹 -->
              <view class="r-sub" wx:if="{{resTotals[g.key + '|' + res.name]}}">
                <text>今日已打卡 {{resTotals[g.key + '|' + res.name]}} 分钟</text>
                <text wx:if="{{g.key === 'listening_audio'}}"> · {{resEffective[g.key + '|' + res.name] ? '有效 ' + resEffective[g.key + '|' + res.name] + ' 分钟' : '本阶段不计入'}}</text>
                <text wx:else> · 可继续追加</text>
              </view>
              <view class="r-sub r-sub-hint" wx:elif="{{g.clickable && !stageLocked}}">点击打卡 · 左滑标记读完</view>
              <view class="r-sub r-sub-locked" wx:elif="{{g.clickable && stageLocked}}">
                <text wx:if="{{stageStatus === 'completed'}}">本阶段已完成，仅可查看</text>
                <text wx:else>当前阶段未解锁，仅可查看</text>
              </view>
              <view class="r-sub r-sub-note" wx:else>仅供参考，不参与打卡</view>
            </view>
            <view class="r-right">
              <view class="r-badge" wx:if="{{resTotals[g.key + '|' + res.name]}}">{{resTotals[g.key + '|' + res.name]}}m</view>
              <view class="r-arrow" wx:if="{{g.clickable && !stageLocked}}">›</view>
              <view class="r-arrow" wx:else>·</view>
            </view>
          </view>
        </view>
        <!-- 空分组提示：熏听分组官方不含素材，给一句引导（其余空分组只说明为空） -->
        <view class="rg-empty" wx:if="{{!g.items.length}}">
          <text wx:if="{{g.key === 'listening_audio'}}">还没有熏听素材，去「设置 → 我的资源」添加</text>
          <text wx:else>该分组暂无资源</text>
        </view>
      </view>
    </view>
    </view>
  </view>

  <!-- 关键要点（移动到底部） -->
  <view wx:if="{{stage.key_points.length}}">
    <view class="weui-cells__title">关键要点</view>
    <view class="weui-cells">
      <view class="weui-cell" wx:for="{{stage.key_points}}" wx:key="text">
        <view class="weui-cell__bd">
          <text class="kp-text"><block wx:for="{{item.segs}}" wx:for-item="seg" wx:key="t"><text class="{{seg.hi ? 'kp-text-hi' : ''}}">{{seg.t}}</text></block></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成阶段按钮（仅当前常规阶段展示）：填色展示进度，复用 WeUI 按钮令牌 -->
  <view wx:if="{{canPromote}}" class="promote-btn-area">
    <view class="promote-target" wx:if="{{requiredHours > 0}}">已投入 {{investedHoursText}}h / 目标 {{requiredHours}}h</view>
    <button
      class="weui-btn weui-btn_block {{promoteEnabled ? 'weui-btn_primary' : 'weui-btn_default'}}"
      style="{{promoteFillStyle}}"
      bindtap="onPromoteTap"
    >
      <text wx:if="{{promoteEnabled}}">{{promoteLabel}}</text>
      <text wx:else>{{promoteLabel}} · {{progressPercent}}%</text>
    </button>
  </view>
</view>

<!-- 晋级测试弹窗（half-sheet 外壳 + 弹层表单原语）：
     阶段名并入标题，原先独立那块浅灰「阶段说明块」取消，说明句改用全局 .weui-cells__tips -->
<half-sheet
  show="{{showPromoteModal}}"
  title="{{stage.stage_name}} · 晋级测试校验"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closePromoteModal"
>
  <!-- 晋级要求 / 测试结果 / 快捷值：一张卡片三节，与打卡弹窗、目标时长弹窗同一套原语 -->
  <view class="form-card">
    <view class="form-row form-row-static">
      <view class="form-label">晋级要求</view>
      <view class="form-right">
        <text class="form-static">稳定 {{promoteTargetPhaseText}}</text>
      </view>
    </view>
    <view class="weui-divider"></view>
    <view class="form-row">
      <view class="form-label">测试结果</view>
      <view class="form-right">
        <input
          class="form-field"
          type="number"
          placeholder="请输入 phase 数字"
          value="{{youquTestInput}}"
          bindinput="onYouquTestInput"
        />
        <text class="form-unit">phase</text>
      </view>
    </view>
    <!-- 快捷值 = 该阶段的目标 phase，点一下填入；与输入框内容一致时高亮 -->
    <block wx:if="{{promoteTargetPhaseText}}">
      <view class="weui-divider"></view>
      <view class="form-row">
        <view class="seg-control">
          <view
            class="seg-item {{youquTestInput === promoteTargetPhaseStr ? 'seg-active' : ''}}"
            data-val="{{promoteTargetPhase}}"
            bindtap="quickYouquPhase"
          >{{promoteTargetPhaseText}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="weui-cells__tips">开启小小优趣成长计划后，晋级需测试结果达标</view>

  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closePromoteModal">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="submitPromote">确认晋级</button>
  </view>
</half-sheet>

<!-- 打卡弹窗（half-sheet 外壳 + 表单原语 + seg-control） -->
<half-sheet
  show="{{showCheckin}}"
  title="{{currentResource}}"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeCheckin"
>
  <!-- 学习时长 / 快捷时长 / 备注：一张卡片三节（与「目标时长」弹窗同构） -->
  <view class="form-card">
    <view class="form-row">
      <view class="form-label">学习时长</view>
      <view class="form-right">
        <input
          class="form-field"
          type="number"
          placeholder="请输入"
          value="{{durationInput}}"
          bindinput="onDurationInput"
        />
        <text class="form-unit">分钟</text>
        <!-- 熏听折算系数就地显示（贴着输入单位，视线不用下移到卡片底部）：
             只给系数，具体换算交给下方 .listen-tip；×0 阶段不写「×0」而写「不计入」，
             避免让家长以为「乘 0」是某种正常规则 -->
        <text class="form-factor" wx:if="{{listeningFactor !== 1}}">{{listeningFactor > 0 ? '×' + listeningFactor : '不计入'}}</text>
      </view>
    </view>
    <view class="weui-divider"></view>
    <view class="form-row">
      <view class="seg-control seg-control-grid">
        <view class="seg-item {{durationInput==='10' ? 'seg-active' : ''}}" data-val="10" bindtap="quickDuration">10</view>
        <view class="seg-item {{durationInput==='15' ? 'seg-active' : ''}}" data-val="15" bindtap="quickDuration">15</view>
        <view class="seg-item {{durationInput==='20' ? 'seg-active' : ''}}" data-val="20" bindtap="quickDuration">20</view>
        <view class="seg-item {{durationInput==='25' ? 'seg-active' : ''}}" data-val="25" bindtap="quickDuration">25</view>
        <view class="seg-item {{durationInput==='30' ? 'seg-active' : ''}}" data-val="30" bindtap="quickDuration">30</view>
      </view>
    </view>
    <view class="weui-divider"></view>
    <view class="form-row">
      <view class="form-label">备注</view>
      <input
        class="form-field"
        placeholder="如：第1-2册（下次自动填充）"
        value="{{remarkInput}}"
        bindinput="onRemarkInput"
        maxlength="50"
      />
    </view>

    <!-- 熏听分组：按阶段折算的说明（含「X 分钟计 Y 分钟」实时换算）。
         换算值随学习时长实时变化，故贴在卡片底部作注脚、不夹在两行输入之间 -->
    <view class="listen-tip" wx:if="{{listeningTip}}">{{listeningTip}}</view>
  </view>

  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closeCheckin">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="submitCheckin">打卡</button>
  </view>
</half-sheet>
