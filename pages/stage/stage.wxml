<view class="container" wx:if="{{stage}}">
  <!-- 阶段资源（核心：打卡）放在上半区，突出入口 -->
  <view class="res-wrap" wx:if="{{resourceGroups.length}}">
    <view class="res-head">
      <view class="res-head-left">
        <view class="res-hl-stage">{{stage.stage_name}}</view>
      </view>
      <view class="res-head-sub">
        <text class="res-hl-text">积累</text>
        <text class="res-hl-bold">{{stage.vocabulary_target}}</text>
        <text class="res-hl-paren">（</text>
        <text class="res-hl-time">{{stage.time_investment}}</text>
        <text class="res-hl-sep">｜</text>
        <text class="res-hl-phase">{{stage.target_phase}}</text>
        <text class="res-hl-paren">）</text>
      </view>
    </view>
    <view class="res-divider"></view>

    <view class="res-list" wx:for="{{resourceGroups}}" wx:for-item="g" wx:for-index="gidx" wx:key="key">
      <view class="rg-head {{g.clickable && !stageLocked ? 'rg-head-active' : ''}}" data-group-key="{{g.key}}" bindtap="onToggleGroup">
        <view class="rg-head-left">
          <view class="rg-dot rg-dot-{{g.key}}"></view>
          <view class="rg-label rg-label-{{g.key}}">{{g.label}}</view>
          <view class="rg-count">{{g.items.length}} 项</view>
        </view>
        <view class="rg-head-right">
          <view class="rg-progress" wx:if="{{g.clickable && !stageLocked && groupProgress[g.key].todayMin > 0}}">
            <text class="rg-progress-val">{{groupProgress[g.key].todayMin}}m</text>
            <text class="rg-progress-sep">·</text>
            <text class="rg-progress-read">已读 {{groupProgress[g.key].readCount}}</text>
          </view>
          <view class="rg-progress rg-progress-empty" wx:elif="{{g.clickable && !stageLocked}}">
            <text>待学习</text>
          </view>
          <view class="rg-progress rg-progress-locked" wx:elif="{{g.clickable && stageLocked}}">
            <text wx:if="{{stageStatus === 'completed'}}">已完成</text>
            <text wx:else>未开始</text>
          </view>
          <view class="rg-arrow {{expandedGroups[g.key] ? 'rg-arrow-open' : ''}}">›</view>
        </view>
      </view>
      <view class="rg-body" wx:if="{{expandedGroups[g.key]}}">
        <view
          class="r-row {{g.clickable && !stageLocked ? 'r-row-click' : ''}} {{resTotals[g.key + '|' + g.items[ridx]] ? 'r-row-done' : ''}}"
          wx:for="{{g.items}}"
          wx:for-item="rname"
          wx:for-index="ridx"
          wx:key="*this"
          data-group-key="{{g.key}}"
          data-group-label="{{g.label}}"
          data-resource="{{rname}}"
          bindtap="onResourceTap"
        >
          <view class="r-no" wx:if="{{readCounts[g.key + '|' + rname] >= 1}}">{{readCounts[g.key + '|' + rname]}}</view>
          <view class="r-no r-no-char" wx:else>{{rname[0]}}</view>
          <view class="r-body">
            <view class="r-name">{{rname}}</view>
            <view class="r-sub" wx:if="{{resTotals[g.key + '|' + rname]}}">今日已打卡 {{resTotals[g.key + '|' + rname]}} 分钟 · 可继续追加</view>
            <view class="r-sub r-sub-hint" wx:elif="{{g.clickable && !stageLocked}}">点击输入学习时长并打卡</view>
            <view class="r-sub r-sub-locked" wx:elif="{{g.clickable && stageLocked}}">
              <text wx:if="{{stageStatus === 'completed'}}">本阶段已完成，仅可查看</text>
              <text wx:else>当前阶段未解锁，仅可查看</text>
            </view>
            <view class="r-sub r-sub-note" wx:else>仅供参考，不参与打卡</view>
          </view>
          <view class="r-right">
            <view class="r-badge" wx:if="{{resTotals[g.key + '|' + rname]}}">{{resTotals[g.key + '|' + rname]}}m</view>
            <view class="r-arrow" wx:if="{{g.clickable && !stageLocked}}">›</view>
            <view class="r-arrow r-arrow-gray" wx:else>·</view>
          </view>
        </view>
      </view>
      <view class="rg-body rg-body-collapsed" wx:else>
        <view class="rg-collapsed-hint" wx:if="{{g.clickable}}">{{g.items.length}} 项资源，点击展开</view>
        <view class="rg-collapsed-hint rg-collapsed-note" wx:else>{{g.items.length}} 项资源，仅供参考</view>
      </view>
    </view>
  </view>

  <!-- 关键要点（移动到底部） -->
  <view class="card key-point-card" wx:if="{{stage.key_points.length}}">
    <view class="res-head">
      <view class="res-head-left">
        <view class="res-hl-stage">关键要点</view>
      </view>
      <view class="res-head-sub">
        <text class="res-hl-text">执行</text>
        <text class="res-hl-bold">{{stage.stage_name}}</text>
        <text class="res-hl-text">时的重点提醒，共</text>
        <text class="res-hl-bold">{{stage.key_points.length}}</text>
        <text class="res-hl-text">条</text>
      </view>
    </view>
    <view class="res-divider"></view>
    
    <!-- 方案A：紧凑列表 -->
    <view class="kp-list">
      <view class="kp-item {{item.highlighted ? 'kp-item-hi' : ''}}" wx:for="{{stage.key_points}}" wx:key="index">
        <view class="kp-dot {{item.highlighted ? 'kp-dot-hi' : ''}}"></view>
        <view class="kp-body">
          <text class="kp-text">{{item.text}}</text>
          <view class="kp-tag kp-tag-hi" wx:if="{{item.highlighted}}">重要</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 晋级卡片（仅当前常规阶段展示） -->
  <view class="card promote-card" wx:if="{{canPromote}}">
    <view class="res-head">
      <view class="res-head-left">
        <view class="res-hl-stage">阶段晋级</view>
      </view>
      <view class="res-head-sub">
        <text class="res-hl-text">当前阶段</text>
        <text class="res-hl-bold">{{stage.stage_name}}</text>
        <text class="res-hl-text">时间达标后可晋级下一阶段</text>
      </view>
    </view>
    <view class="res-divider"></view>

    <view class="promote-progress">
      <view class="promote-progress-bar">
        <view class="promote-progress-fill {{timeMet ? 'promote-progress-fill-done' : ''}}" style="width: {{progressPercent}}%;"></view>
      </view>
      <view class="promote-progress-text">
        <text class="promote-progress-hours">{{requiredType === 'accumulated' ? '常规1-6累计已投入' : '已投入'}} {{investedHoursText}}h</text>
        <text class="promote-progress-target" wx:if="{{requiredHours}}">目标 {{requiredHours}}h</text>
      </view>
    </view>

    <view class="promote-status {{timeMet ? 'promote-status-met' : ''}}">
      <text wx:if="{{timeMet}}">✓ 时间投入已达标</text>
      <text wx:else>时间投入未达标，继续加油</text>
    </view>

    <view
      class="promote-btn {{promoteEnabled ? 'promote-btn-active' : 'promote-btn-disabled'}}"
      bindtap="onPromoteTap"
    >
      <text wx:if="{{promoteEnabled}}">申请晋级</text>
      <text wx:else>时间不足，暂不可晋级</text>
    </view>
  </view>
</view>

<!-- 小小优趣测试结果弹窗 -->
<view class="pm-mask {{showPromoteModal ? 'pm-mask-show' : ''}}" bindtap="closePromoteModal" catchtouchmove="noop">
  <view class="pm-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="pm-handle"></view>

    <view class="pm-head">
      <view class="pm-title">晋级测试校验</view>
      <view class="pm-close" catchtap="closePromoteModal">×</view>
    </view>

    <view class="pm-stage-info">
      <view class="pm-stage-name">{{stage.stage_name}}</view>
      <view class="pm-stage-tip">开启小小优趣成长计划后，晋级需测试结果达标</view>
    </view>

    <view class="pm-form">
      <view class="pm-form-item">
        <text class="pm-form-label">晋级要求</text>
        <view class="pm-form-value">稳定 {{promoteTargetPhaseText}}</view>
      </view>
      <view class="pm-form-item">
        <text class="pm-form-label">测试结果</text>
        <view class="pm-form-control">
          <input
            class="pm-num-input"
            type="number"
            placeholder="请输入 phase 数字"
            value="{{youquTestInput}}"
            bindinput="onYouquTestInput"
          />
          <text class="pm-form-unit">phase</text>
        </view>
      </view>
    </view>

    <view class="pm-quick-row">
      <view class="pm-quick-btn" data-val="{{promoteTargetPhase}}" bindtap="quickYouquPhase">{{promoteTargetPhaseText}}</view>
    </view>

    <view class="pm-actions">
      <button class="pm-btn pm-btn-cancel" bindtap="closePromoteModal">取消</button>
      <button class="pm-btn pm-btn-ok" bindtap="submitPromote">确认晋级</button>
    </view>
  </view>
</view>

<!-- 打卡弹窗(底部半屏) -->
<view class="ci-mask {{showCheckin ? 'ci-mask-show' : ''}}" bindtap="closeCheckin" catchtouchmove="noop">
  <view class="ci-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="ci-handle"></view>

    <view class="ci-head">
      <view class="ci-title">{{currentResource}}</view>
      <view class="ci-close" catchtap="closeCheckin">×</view>
    </view>

    <view class="ci-form">
      <view class="ci-form-item">
        <text class="ci-form-label">学习时长</text>
        <view class="ci-form-control">
          <input
            class="ci-num-input"
            type="number"
            placeholder="请输入"
            value="{{durationInput}}"
            bindinput="onDurationInput"
          />
          <text class="ci-form-unit">分钟</text>
        </view>
      </view>

      <view class="ci-quick-row">
        <view class="ci-quick-btn" data-val="10" bindtap="quickDuration">10</view>
        <view class="ci-quick-btn" data-val="15" bindtap="quickDuration">15</view>
        <view class="ci-quick-btn" data-val="20" bindtap="quickDuration">20</view>
        <view class="ci-quick-btn" data-val="30" bindtap="quickDuration">30</view>
      </view>
    </view>

    <view class="ci-form">
      <view class="ci-form-item">
        <text class="ci-form-label">备注</text>
        <input
          class="ci-text-input"
          placeholder="如：第1-2册（下次自动填充）"
          value="{{remarkInput}}"
          bindinput="onRemarkInput"
          maxlength="50"
        />
      </view>

      <view class="ci-form-item" bindtap="onReadFinish">
        <text class="ci-form-label">已读完</text>
        <view class="ci-form-control">
          <text class="ci-read-count">{{currentReadCount}} 次</text>
          <view class="ci-read-tag">读完</view>
          <text class="ci-form-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="ci-actions">
      <button class="ci-btn ci-btn-cancel" bindtap="closeCheckin">取消</button>
      <button class="ci-btn ci-btn-ok" bindtap="submitCheckin">打卡</button>
    </view>
  </view>
</view>
