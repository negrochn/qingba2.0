<view class="container {{fontClass}} {{darkClass}}" wx:if="{{stage}}">
  <!-- 阶段资源（核心：打卡）放在上半区，突出入口 -->
  <view wx:if="{{resourceGroups.length}}">
    <view class="weui-cells__title">
      {{stage.stage_name + '：积累' + stage.vocabulary_target + '（' + stage.time_investment + ' | ' + stage.target_phase + '）'}}
    </view>
    <view class="res-wrap">
    <view class="res-list" wx:for="{{resourceGroups}}" wx:for-item="g" wx:for-index="gidx" wx:key="key">
      <view class="rg-head {{expandedGroups[g.key] ? '' : 'rg-head-folded'}} {{g.clickable && !stageLocked ? 'rg-head-active' : ''}}" data-group-key="{{g.key}}" bindtap="onToggleGroup">
        <view class="rg-head-left">
          <view class="rg-dot rg-dot-{{g.key}}"></view>
          <view class="rg-label rg-label-{{g.key}}">{{g.label}}</view>
          <view class="rg-count">{{g.items.length}} 项</view>
        </view>
        <view class="rg-head-right">
          <view class="rg-progress" wx:if="{{g.clickable && !stageLocked && groupProgress[g.key].todayMin > 0}}">
            <text class="rg-progress-val">{{groupProgress[g.key].todayMin}}m</text>
            <text class="rg-progress-sep">·</text>
            <text class="rg-progress-read">已读 {{groupProgress[g.key].readCount}}</text>
          </view>
          <view class="rg-progress rg-progress-empty" wx:elif="{{g.clickable && !stageLocked}}">
            <text>待学习</text>
          </view>
          <view class="rg-progress rg-progress-locked" wx:elif="{{g.clickable && stageLocked}}">
            <text wx:if="{{stageStatus === 'completed'}}">已完成</text>
            <text wx:else>未开始</text>
          </view>
          <view class="rg-arrow {{expandedGroups[g.key] ? 'rg-arrow-open' : ''}}">›</view>
        </view>
      </view>
      <view class="rg-body" wx:if="{{expandedGroups[g.key]}}">
        <view
          class="r-row {{g.clickable && !stageLocked ? 'r-row-click' : ''}} {{resTotals[g.key + '|' + res.name] ? 'r-row-done' : ''}}"
          wx:for="{{g.items}}"
          wx:for-item="res"
          wx:for-index="ridx"
          wx:key="id"
          data-group-key="{{g.key}}"
          data-group-label="{{g.label}}"
          data-resource-id="{{res.id}}"
          data-resource-name="{{res.name}}"
          bindtap="onResourceTap"
        >
          <view class="r-no" wx:if="{{readCounts[g.key + '|' + res.id] >= 1}}">{{readCounts[g.key + '|' + res.id]}}</view>
          <view class="r-no r-no-char" wx:else>{{res.name[0]}}</view>
          <view class="r-body">
            <view class="r-name">{{res.name}}<text class="r-tag" wx:if="{{res.custom}}">自定义</text></view>
            <view class="r-sub" wx:if="{{resTotals[g.key + '|' + res.name]}}">今日已打卡 {{resTotals[g.key + '|' + res.name]}} 分钟 · 可继续追加</view>
            <view class="r-sub r-sub-hint" wx:elif="{{g.clickable && !stageLocked}}">点击输入学习时长并打卡</view>
            <view class="r-sub r-sub-locked" wx:elif="{{g.clickable && stageLocked}}">
              <text wx:if="{{stageStatus === 'completed'}}">本阶段已完成，仅可查看</text>
              <text wx:else>当前阶段未解锁，仅可查看</text>
            </view>
            <view class="r-sub r-sub-note" wx:else>仅供参考，不参与打卡</view>
          </view>
          <view class="r-right">
            <view class="r-badge" wx:if="{{resTotals[g.key + '|' + res.name]}}">{{resTotals[g.key + '|' + res.name]}}m</view>
            <view class="r-arrow" wx:if="{{g.clickable && !stageLocked}}">›</view>
            <view class="r-arrow" wx:else>·</view>
          </view>
        </view>
      </view>
    </view>
    </view>
  </view>

  <!-- 关键要点（移动到底部） -->
  <view wx:if="{{stage.key_points.length}}">
    <view class="weui-cells__title">关键要点</view>
    <view class="weui-cells">
      <view class="weui-cell" wx:for="{{stage.key_points}}" wx:key="text">
        <view class="weui-cell__bd">
          <text class="kp-text {{item.highlighted ? 'kp-text-hi' : ''}}">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成阶段按钮（仅当前常规阶段展示）：填色展示进度，复用 WeUI 按钮令牌 -->
  <view wx:if="{{canPromote}}" class="promote-btn-area">
    <button
      class="weui-btn weui-btn_block {{promoteEnabled ? 'weui-btn_primary' : 'weui-btn_default'}}"
      style="{{promoteFillStyle}}"
      bindtap="onPromoteTap"
    >
      <text wx:if="{{promoteEnabled}}">{{promoteLabel}}</text>
      <text wx:else>{{promoteLabel}} · {{progressPercent}}%</text>
    </button>
  </view>
</view>

<!-- 小小优趣测试结果弹窗 -->
<view class="pm-mask {{fontClass}} {{darkClass}} {{showPromoteModal ? 'pm-mask-show' : ''}}" bindtap="closePromoteModal" catchtouchmove="noop">
  <view class="pm-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="pm-handle"></view>

    <view class="pm-head">
      <view class="pm-title">晋级测试校验</view>
      <view class="pm-close" catchtap="closePromoteModal">×</view>
    </view>

    <view class="pm-stage-info">
      <view class="pm-stage-name">{{stage.stage_name}}</view>
      <view class="pm-stage-tip">开启小小优趣成长计划后，晋级需测试结果达标</view>
    </view>

    <view class="pm-form">
      <view class="pm-form-item">
        <text class="pm-form-label">晋级要求</text>
        <view class="pm-form-value">稳定 {{promoteTargetPhaseText}}</view>
      </view>
      <view class="pm-form-item">
        <text class="pm-form-label">测试结果</text>
        <view class="pm-form-control">
          <input
            class="pm-num-input"
            type="number"
            placeholder="请输入 phase 数字"
            value="{{youquTestInput}}"
            bindinput="onYouquTestInput"
          />
          <text class="pm-form-unit">phase</text>
        </view>
      </view>
    </view>

    <view class="pm-quick-row">
      <view class="pm-quick-btn" data-val="{{promoteTargetPhase}}" bindtap="quickYouquPhase">{{promoteTargetPhaseText}}</view>
    </view>

    <view class="pm-actions">
      <button class="pm-btn pm-btn-cancel" bindtap="closePromoteModal">取消</button>
      <button class="pm-btn pm-btn-ok" bindtap="submitPromote">确认晋级</button>
    </view>
  </view>
</view>

<!-- 打卡弹窗（skill 原语组合：原语 4 action-sheet + 原语 13/15 form-page/form-input + 原语 14 seg-control） -->
<view class="sheet-mask {{fontClass}} {{darkClass}} {{showCheckin ? 'sheet-mask-show' : ''}}" bindtap="closeCheckin" catchtouchmove="noop">
  <view class="action-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="sheet-handle"></view>

    <view class="sheet-head">
      <view class="sheet-head-title">{{currentResource}}</view>
      <view class="sheet-close" catchtap="closeCheckin">×</view>
    </view>

    <!-- 表单卡片 1：学习时长 + 快捷时长 -->
    <view class="form-card">
      <view class="form-row">
        <view class="form-label">学习时长</view>
        <view class="form-right">
          <input
            class="form-field"
            type="number"
            placeholder="请输入"
            value="{{durationInput}}"
            bindinput="onDurationInput"
          />
          <text class="form-unit">分钟</text>
        </view>
      </view>
      <view class="weui-divider"></view>
      <view class="form-row">
        <view class="seg-control seg-control-grid">
          <view class="seg-item {{durationInput==='10' ? 'seg-active' : ''}}" data-val="10" bindtap="quickDuration">10</view>
          <view class="seg-item {{durationInput==='15' ? 'seg-active' : ''}}" data-val="15" bindtap="quickDuration">15</view>
          <view class="seg-item {{durationInput==='20' ? 'seg-active' : ''}}" data-val="20" bindtap="quickDuration">20</view>
          <view class="seg-item {{durationInput==='25' ? 'seg-active' : ''}}" data-val="25" bindtap="quickDuration">25</view>
          <view class="seg-item {{durationInput==='30' ? 'seg-active' : ''}}" data-val="30" bindtap="quickDuration">30</view>
        </view>
      </view>
    </view>

    <!-- 表单卡片 2：备注 + 已读完 -->
    <view class="form-card">
      <view class="form-row">
        <view class="form-label">备注</view>
        <input
          class="form-field"
          placeholder="如：第1-2册（下次自动填充）"
          value="{{remarkInput}}"
          bindinput="onRemarkInput"
          maxlength="50"
        />
      </view>
      <view class="weui-divider"></view>
      <view class="form-row" bindtap="onReadFinish">
        <view class="form-label">已读完</view>
        <view class="form-right">
          <text class="form-read-count">{{currentReadCount}} 次</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </view>

    <view class="weui-btn-area_inline">
      <button class="weui-btn weui-btn_default" bindtap="closeCheckin">取消</button>
      <button class="weui-btn weui-btn_primary" bindtap="submitCheckin">打卡</button>
    </view>
  </view>
</view>
