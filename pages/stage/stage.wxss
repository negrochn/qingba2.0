/* ====== 关键要点（模块移到底部） ====== */
.key-point-card {
  background: #fffdf7;
  border: 2rpx solid #f3e6c8;
  border-radius: 20rpx;
}

.section-title-kp {
  border-left-color: #f0a020 !important;
  color: #8a5a00 !important;
}

.kp-summary {
  font-size: 24rpx;
  color: #a9894a;
  margin: -6rpx 0 18rpx;
  padding-left: 16rpx;
}

.point {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #f0e3c0;
}

.point:last-child {
  border-bottom: none;
}

.point-idx {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  background: #f7edd2;
  color: #8a5a00;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 18rpx;
  margin-top: 4rpx;
}

.point-body {
  flex: 1;
  min-width: 0;
}

.point-hi .point-idx {
  background: linear-gradient(135deg, #f0a020 0%, #f7c25f 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(240, 160, 32, 0.35);
}

.point-hi .point-text {
  color: #4a90d9;
  font-weight: 500;
}

.point-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #555;
  display: inline;
}

.point-tag {
  display: inline-block;
  vertical-align: middle;
  margin-left: 12rpx;
  margin-top: -2rpx;
  font-size: 20rpx;
  color: #f0a020;
  background: #fff3da;
  border: 1rpx solid #f3ddab;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  line-height: 1.5;
}

.point-tag-hi {
  color: #fff;
  background: linear-gradient(135deg, #f0a020 0%, #f7c25f 100%);
  border-color: transparent;
}

/* 资源行里不可打卡的提示（灰色说明行） */
.r-sub-note {
  color: #b0b9c5;
  font-style: italic;
}

/* ====== 阶段资源（核心打卡，上半区） ====== */
.res-wrap {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx 20rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 22rpx rgba(59, 99, 171, 0.08);
  border: 2rpx solid #e8eef7;
  position: relative;
  overflow: hidden;
}

.res-head {
  display: flex;
  flex-direction: column;
  padding: 22rpx 10rpx 18rpx;
  position: relative;
  z-index: 1;
  gap: 10rpx;
}

.res-head-left {
  display: flex;
  align-items: center;
}

.res-head-accent {
  width: 6rpx;
  height: 38rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4a90d9 0%, #6ab0f3 100%);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.res-hl-stage {
  font-size: 34rpx;
  font-weight: 800;
  color: #153b72;
  letter-spacing: 2rpx;
}

.res-head-sub {
  padding-left: 22rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #5a6f8a;
  letter-spacing: 0.5rpx;
}

.res-hl-bold {
  font-weight: 700;
  color: #1f5fb0;
}

.res-hl-time {
  font-weight: 600;
  color: #2a5896;
}

.res-hl-phase {
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  margin: 0 4rpx;
  display: inline-block;
  vertical-align: 2rpx;
}

.res-hl-sep {
  color: #99a6b8;
  font-weight: 500;
}

.res-hl-paren {
  color: #99a6b8;
  font-weight: 600;
}

.res-hl-text {
  color: #5a6f8a;
}

.res-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #dbe4f1 20%, #dbe4f1 80%, transparent 100%);
  margin: 4rpx 8rpx 16rpx;
}


.res-list {
  margin-bottom: 24rpx;
}

.res-list:last-child {
  margin-bottom: 0;
}

.rg-head {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx 14rpx;
  margin-bottom: 8rpx;
}

.rg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.rg-dot-blue { background: #4a90d9; }
.rg-dot-gray { background: #c2cbd7; }

.rg-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #334;
}

.rg-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.rg-count {
  font-size: 22rpx;
  color: #99a;
}

.rg-body {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(40, 70, 120, 0.05);
  border: 2rpx solid #eef2f7;
}

.r-row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #f0f3f7;
  min-height: 92rpx;
  box-sizing: border-box;
}

.r-row:last-child {
  border-bottom: none;
}

.r-row-click:active {
  background: #f2f6fd;
}

.r-row-done {
  background: linear-gradient(90deg, #f2fbf5 0%, #ffffff 55%);
}

.r-row-done:active {
  background: #e5f5ea;
}

.r-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #eef3fa;
  color: #57779c;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.r-row-done .r-no {
  background: #dff0e5;
  color: #2f7a4a;
}

.r-body {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.r-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2a3140;
  line-height: 1.4;
}

.r-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #3fae68;
  line-height: 1.4;
}

.r-sub-hint {
  color: #99a5b7;
}

.r-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.r-badge {
  background: linear-gradient(135deg, #3fae68, #65c687);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(63, 174, 104, 0.28);
}

.r-arrow {
  color: #4a90d9;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.r-arrow-gray {
  color: #cfd4dc;
  font-weight: 700;
  font-size: 48rpx;
}

/* ====== 底部打卡弹窗 ====== */
.ci-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}

.ci-mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.ci-sheet {
  width: 100%;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.ci-mask-show .ci-sheet {
  transform: translateY(0);
}

.ci-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e3e8ee;
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

.ci-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.ci-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f4a84;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}

.ci-sort {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4a90d9;
  background: #eef5ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.ci-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: #aaa;
  border-radius: 50%;
}

.ci-close:active { background: #f3f4f6; color: #555; }

.ci-dur-row-full {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.ci-label-inline {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #445;
  font-weight: 500;
  padding-right: 20rpx;
}

.ci-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f4a84;
  text-align: center;
}

.ci-input-inline {
  text-align: center;
}

.ci-unit-fix {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4a90d9;
  font-weight: 600;
  padding: 0 18rpx 0 14rpx;
}

.ci-remark-row {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.ci-input-remark {
  text-align: left;
  font-weight: 400;
  font-size: 28rpx;
  color: #333;
  height: 72rpx;
}

.ci-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.ci-quick-item {
  flex: 1 1 22%;
  min-width: 120rpx;
  text-align: center;
  padding: 18rpx 0;
  background: #f5f7fa;
  color: #445;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #eaeef3;
}

.ci-quick-item:active {
  background: #eaf2ff;
  border-color: #bcd3ef;
  color: #2c5a96;
}

.ci-actions {
  display: flex;
  justify-content: center;
  align-items: center;
}

.ci-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  text-align: center;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
}

.ci-btn::after { border: none; }

.ci-btn-cancel {
  background: #f2f4f7;
  color: #556;
  margin-right: 4%;
}

.ci-btn-ok {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  color: #fff;
  font-weight: 600;
}

.ci-btn-ok:active { opacity: 0.88; }
