.stage-hero {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.stage-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.stage-target {
  font-size: 26rpx;
  opacity: 0.95;
}

.metrics {
  display: flex;
  margin-bottom: 24rpx;
  gap: 18rpx;
}

.metric {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a90d9;
}

.info-text {
  color: #555;
  font-size: 26rpx;
  line-height: 1.8;
}

.info-text.strong {
  color: #8a5a00;
  font-weight: 500;
}

.highlight-card {
  background: linear-gradient(135deg, #fff8ec 0%, #fff3da 100%);
  border-left: 8rpx solid #f0a020;
}

.point {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.point:last-child {
  border-bottom: none;
}

.point-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin-top: 14rpx;
  margin-right: 16rpx;
}

.point-hi .point-text {
  color: #4a90d9;
  font-weight: 500;
}

.dot-hi {
  background: #4a90d9;
}

.point-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #555;
}

/* ====== 资源(整行卡片) ====== */
.res-card {
  background: linear-gradient(180deg, #fff 0%, #fbfcff 100%);
  border: 2rpx solid #e8eef7;
}

.section-title-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border-left: none;
  padding-left: 0;
}

.title-main {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f4a84;
}

.title-sub {
  font-size: 22rpx;
  color: #8897aa;
  margin-top: 6rpx;
}

.res-list {
  margin-bottom: 28rpx;
}

.res-list:last-child {
  margin-bottom: 0;
}

.rg-head {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx 14rpx;
  margin-bottom: 8rpx;
}

.rg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.rg-dot-blue { background: #4a90d9; }
.rg-dot-gray { background: #c2cbd7; }

.rg-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #334;
}

.rg-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.rg-count {
  font-size: 22rpx;
  color: #99a;
}

.rg-body {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(40, 70, 120, 0.05);
  border: 2rpx solid #eef2f7;
}

.r-row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #f0f3f7;
  min-height: 92rpx;
  box-sizing: border-box;
}

.r-row:last-child {
  border-bottom: none;
}

.r-row-click:active {
  background: #f2f6fd;
}

.r-row-done {
  background: linear-gradient(90deg, #f2fbf5 0%, #ffffff 55%);
}

.r-row-done:active {
  background: #e5f5ea;
}

.r-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #eef3fa;
  color: #57779c;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.r-row-done .r-no {
  background: #dff0e5;
  color: #2f7a4a;
}

.r-body {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.r-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2a3140;
  line-height: 1.4;
}

.r-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #3fae68;
  line-height: 1.4;
}

.r-sub-hint {
  color: #99a5b7;
}

.r-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.r-badge {
  background: linear-gradient(135deg, #3fae68, #65c687);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(63, 174, 104, 0.28);
}

.r-arrow {
  color: #4a90d9;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.r-arrow-gray {
  color: #cfd4dc;
  font-weight: 700;
  font-size: 48rpx;
}

/* ====== 底部打卡弹窗 ====== */
.ci-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}

.ci-mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.ci-sheet {
  width: 100%;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.ci-mask-show .ci-sheet {
  transform: translateY(0);
}

.ci-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e3e8ee;
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

.ci-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.ci-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f4a84;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}

.ci-sort {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4a90d9;
  background: #eef5ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.ci-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: #aaa;
  border-radius: 50%;
}

.ci-close:active { background: #f3f4f6; color: #555; }

.ci-dur-row-full {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.ci-label-inline {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #445;
  font-weight: 500;
  padding-right: 20rpx;
}

.ci-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f4a84;
  text-align: center;
}

.ci-input-inline {
  text-align: center;
}

.ci-unit-fix {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4a90d9;
  font-weight: 600;
  padding: 0 18rpx 0 14rpx;
}

.ci-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.ci-quick-item {
  flex: 1 1 22%;
  min-width: 120rpx;
  text-align: center;
  padding: 18rpx 0;
  background: #f5f7fa;
  color: #445;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #eaeef3;
}

.ci-quick-item:active {
  background: #eaf2ff;
  border-color: #bcd3ef;
  color: #2c5a96;
}

.ci-actions {
  display: flex;
  justify-content: center;
  align-items: center;
}

.ci-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  text-align: center;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
}

.ci-btn::after { border: none; }

.ci-btn-cancel {
  background: #f2f4f7;
  color: #556;
  margin-right: 4%;
}

.ci-btn-ok {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  color: #fff;
  font-weight: 600;
}

.ci-btn-ok:active { opacity: 0.88; }
