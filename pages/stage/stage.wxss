.stage-hero {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.stage-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.stage-target {
  font-size: 26rpx;
  opacity: 0.95;
}

.metrics {
  display: flex;
  margin-bottom: 24rpx;
  gap: 18rpx;
}

.metric {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a90d9;
}

.info-text {
  color: #555;
  font-size: 26rpx;
  line-height: 1.8;
}

.info-text.strong {
  color: #8a5a00;
  font-weight: 500;
}

.highlight-card {
  background: linear-gradient(135deg, #fff8ec 0%, #fff3da 100%);
  border-left: 8rpx solid #f0a020;
}

.point {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.point:last-child {
  border-bottom: none;
}

.point-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin-top: 14rpx;
  margin-right: 16rpx;
}

.point-hi .point-text {
  color: #4a90d9;
  font-weight: 500;
}

.dot-hi {
  background: #4a90d9;
}

.point-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #555;
}

.res-group {
  margin-bottom: 24rpx;
}

.res-group:last-child {
  margin-bottom: 0;
}

.res-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #4a90d9;
}

.res-tags {
  display: flex;
  flex-wrap: wrap;
}

.res-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  background: #f5f7fa;
  color: #555;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin: 6rpx 8rpx 6rpx 0;
}
