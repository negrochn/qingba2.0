.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

/* ====== 分组标题（微信原生风格，位于卡片外） ====== */
.st-group-head {
  display: flex;
  align-items: center;
  padding: 16rpx 40rpx 12rpx;
}

.st-group-title {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
  flex-shrink: 0;
}

.st-group-sub {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.5;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ====== 关键要点（方案A：紧凑列表）（支持深色模式） ====== */
.key-point-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx 24rpx;
  margin: 0 24rpx 24rpx;
  position: relative;
}

/* 要点列表 */
.kp-list {
  margin-top: 8rpx;
}

/* 单条要点 */
.kp-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: var(--card);
}

.kp-item:last-child {
  margin-bottom: 0;
}

/* 重要条目高亮 */
.kp-item-hi {
  background: linear-gradient(90deg, #fff8f0 0%, #fff 100%);
  border-left: 4rpx solid #ff7a45;
}

/* 小圆点 */
.kp-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text3);
  margin-right: 16rpx;
  margin-top: 12rpx;
}

.kp-dot-hi {
  background: #ff7a45;
  box-shadow: 0 0 8rpx rgba(255, 122, 69, 0.4);
}

/* 内容区 */
.kp-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 文本 */
.kp-text {
  flex: 1;
  min-width: 0;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
}

.kp-item-hi .kp-text {
  color: #8a4a20;
}

/* 重要标签 */
.kp-tag {
  display: inline-flex;
  align-items: center;
  font-size: calc(20rpx * var(--fs, 1));
  color: #ff7a45;
  background: #fff2e8;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.kp-tag-hi {
  color: #fff;
  background: linear-gradient(135deg, #ff7a45 0%, #ff9c6e 100%);
  box-shadow: 0 2rpx 6rpx rgba(255, 122, 69, 0.3);
}

/* 资源行里不可打卡的提示（灰色说明行） */
.r-sub-note {
  color: var(--text3);
  font-style: italic;
}

/* ====== 阶段资源（核心打卡，上半区） ====== */
.res-wrap {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx 20rpx;
  margin: 0 24rpx 24rpx;
  position: relative;
  overflow: hidden;
}

.res-hl-bold {
  color: #1f5fb0;
}

.res-hl-time {
  color: #2a5896;
}

.res-hl-phase {
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-size: calc(22rpx * var(--fs, 1));
  margin: 0 4rpx;
  display: inline-block;
  vertical-align: 2rpx;
}

.res-hl-sep {
  color: var(--text3);
}

.res-hl-paren {
  color: var(--text3);
}

.res-hl-text {
  color: var(--text2);
}

.res-list {
  margin-bottom: 24rpx;
}

.res-list:last-child {
  margin-bottom: 0;
}

.rg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 14rpx;
  margin-bottom: 8rpx;
}

/* 折叠状态：底部分割线分隔相邻分组 */
.rg-head-folded {
  border-bottom: 1rpx solid var(--divider);
}

/* 最后一个分组不需要分割线 */
.res-list:last-child .rg-head-folded {
  border-bottom: none;
}

.rg-head-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rg-head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rg-head-active {
  cursor: pointer;
}

.rg-head-active:active {
  background: var(--cell-active);
  border-radius: 12rpx;
}

.rg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
/* 主线绘本（红） */
.rg-dot-main_picture_books { background: #e74c3c; box-shadow: 0 0 8rpx rgba(231,76,60,0.5); }
.rg-label-main_picture_books { color: #e74c3c; }

/* 主线分级（橙） */
.rg-dot-main_graded_readers { background: #e67e22; box-shadow: 0 0 8rpx rgba(230,126,34,0.5); }
.rg-label-main_graded_readers { color: #e67e22; }

/* 主线动画（黄） */
.rg-dot-main_animations { background: #f1c40f; box-shadow: 0 0 8rpx rgba(241,196,15,0.5); }
.rg-label-main_animations { color: #d4a017; }

/* 辅线分级（绿） */
.rg-dot-sub_graded_readers { background: #2ecc71; box-shadow: 0 0 8rpx rgba(46,204,113,0.5); }
.rg-label-sub_graded_readers { color: #27ae60; }

/* 辅线动画（青） */
.rg-dot-sub_animations { background: #1abc9c; box-shadow: 0 0 8rpx rgba(26,188,156,0.5); }
.rg-label-sub_animations { color: #16a085; }

/* 趣味拓展（蓝） */
.rg-dot-fun_extensions { background: #3498db; box-shadow: 0 0 8rpx rgba(52,152,219,0.5); }
.rg-label-fun_extensions { color: #2980b9; }

/* 科普拓展（靛） */
.rg-dot-science_extensions { background: #9b59b6; box-shadow: 0 0 8rpx rgba(155,89,182,0.5); }
.rg-label-science_extensions { color: #8e44ad; }

/* 融合APP（紫） */
.rg-dot-fusion_apps { background: #8e44ad; box-shadow: 0 0 8rpx rgba(142,68,173,0.5); }
.rg-label-fusion_apps { color: #7d3c98; }

/* 默认 */
.rg-dot-default { background: #888888; box-shadow: 0 0 8rpx rgba(136,136,136,0.5); }
.rg-label-default { color: var(--text3); }

.rg-label {
  flex: 1;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
}

.rg-tag {
  font-size: calc(20rpx * var(--fs, 1));
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.rg-count {
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text3);
}

/* 分组进度摘要 */
.rg-progress {
  display: flex;
  align-items: center;
  font-size: calc(22rpx * var(--fs, 1));
  color: #3fae68;
  margin-right: 12rpx;
  background: #f0faf4;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.rg-progress-empty {
  color: var(--text3);
  background: var(--cell-active);
}

.rg-progress-locked {
  color: var(--text3);
  background: var(--cell-active);
}

/* 锁定提示条 */
.lock-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fdf6ec, #f9efe1);
  border: 2rpx solid #f5d99a;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.lock-icon {
  margin-right: 12rpx;
  font-size: calc(24rpx * var(--fs, 1));
}

.lock-text {
  font-size: calc(26rpx * var(--fs, 1));
  color: #8b6914;
  line-height: 1.5;
}

.rg-collapsed-locked {
  color: var(--text3) !important;
  font-style: italic;
}

.r-sub-locked {
  color: var(--text3);
  font-size: calc(24rpx * var(--fs, 1));
}

.rg-progress-val {
  color: #2a9a5a;
}

.rg-progress-sep {
  margin: 0 6rpx;
  color: var(--text3);
}

.rg-progress-read {
  color: var(--text2);
}

/* 展开/折叠箭头 */
.rg-arrow {
  font-size: calc(32rpx * var(--fs, 1));
  color: var(--text3);
  font-weight: 300;
  transition: transform 0.2s;
}

.rg-arrow-open {
  transform: rotate(90deg);
}

/* 折叠状态提示 */
.rg-body-collapsed {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  min-height: 64rpx;
  background: var(--card);
  border-radius: 12rpx;
  border: 2rpx dashed var(--divider);
}

.rg-collapsed-hint {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  text-align: center;
}

.rg-collapsed-note {
  color: var(--text3);
  font-style: italic;
}

.rg-body {
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(40, 70, 120, 0.05);
  border: 2rpx solid var(--divider);
}

.r-row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid var(--divider);
  min-height: 92rpx;
  box-sizing: border-box;
}

.r-row:last-child {
  border-bottom: none;
}

.r-row-click:active {
  background: var(--cell-active);
}

.r-row-done {
  background: linear-gradient(90deg, #f2fbf5 0%, #ffffff 55%);
}

.r-row-done:active {
  background: #e5f5ea;
}

.r-no {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 14rpx;
  background: rgba(7, 193, 96, 0.10);
  color: #07C160;
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 600;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.r-no-char {
  background: linear-gradient(135deg, #5a9af0 0%, #7fb4f7 100%);
  color: #fff;
  font-size: calc(28rpx * var(--fs, 1));
}

.r-body {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.r-name {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.4;
}

.r-sub {
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: #3fae68;
  line-height: 1.4;
}

.r-sub-hint {
  color: var(--text3);
}

.r-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

/* 已读次数徽标 */
.r-read-badge {
  background: #fff7e6;
  color: #d48806;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: calc(20rpx * var(--fs, 1));
}

/* 读完按钮 */
.r-read-btn {
  background: var(--card);
  color: #ff7a45;
  border: 1rpx solid #ffd1a8;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.4;
}
.r-read-btn:active {
  background: #fff7e6;
}

.r-badge {
  background: linear-gradient(135deg, #3fae68, #65c687);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: calc(22rpx * var(--fs, 1));
  margin-right: 8rpx;
}

.r-arrow {
  color: #4a90d9;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.r-arrow-gray {
  color: var(--text3);
  font-size: 48rpx;
}

/* ====== 打卡弹窗（skill 原语组合）
   原语 4 .sheet-mask + .action-sheet
   原语 4 变体 .sheet-handle（顶部抓手条）
   原语 13/15 .form-card / .form-row / .form-label / .form-right / .form-field / .form-unit
   原语 14 .seg-control + .seg-item（4 项等宽 variant：.seg-control-grid）
   原语 10 变体 .badge-pill-brand（"读完" 绿 pill）
   原语 1 .cell-divider / .cell-arrow
   原语 16 .btn 按钮族（.btn-row 布局 + .btn-secondary 取消 + .btn-primary 打卡，胶囊变体） */

/* 原语 4 .sheet-mask + .action-sheet */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}
.sheet-mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}
.action-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;            /* radius-sheet */
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sheet-mask-show .action-sheet {
  transform: translateY(0);
}

/* 原语 4 变体：顶部抓手条（iOS 风格，可选） */
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--divider);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

/* sheet 头部（标题 + 关闭） */
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.sheet-head-title {
  flex: 1;
  min-width: 0;
  font-size: calc(32rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}
.sheet-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text3);
  border-radius: 50%;
}
.sheet-close:active {
  background: var(--cell-active);
  color: var(--text2);
}

/* 原语 13 .form-card（表单卡片：圆角白底，水平 padding 由 card 提供） */
.form-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 0 32rpx;                         /* form-row-pad-x（与 cell-pad-x 一致） */
  margin-bottom: 20rpx;
}

/* 原语 15 .form-row / .form-label / .form-right / .form-field / .form-unit */
.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;                        /* form-row-h = cell-h */
  padding: 16rpx 0;
  box-sizing: border-box;
}
.form-row:active {
  background: var(--cell-active);
}
.form-label {
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  width: 140rpx;                            /* 固定宽，保证 label 右沿对齐 */
}
.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.form-field {
  flex: 1;
  text-align: right;                        /* 与 settings 页 .cell-value 一致 */
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 64rpx;
}
.form-unit {
  flex-shrink: 0;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
  margin-left: 8rpx;
}

/* 原语 1 .cell-divider（行间分隔线，由 .form-card 限定全宽） */
.form-card .cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin: 0;
}

/* 原语 14 .seg-control + .seg-item（4 项等宽 variant：.seg-control-grid） */
.seg-control {
  display: flex;
  align-items: center;
}
.seg-control-grid .seg-item {
  flex: 1;
  text-align: center;
}
.seg-item {
  height: 56rpx;                            /* seg-item-h */
  padding: 0 32rpx;                         /* seg-item-pad-x */
  margin-left: 16rpx;                       /* seg-gap，除首个外 */
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--divider);
  border-radius: 8rpx;                      /* radius-seg */
  background: var(--card);
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  box-sizing: border-box;
}
.seg-item:first-child {
  margin-left: 0;
}
.seg-item:active {
  background: var(--cell-active);
}
.seg-active {
  border-color: var(--brand);               /* #07C160，原语 14 约定 */
  color: var(--brand);
  background: var(--card);
}

/* 原语 10 变体：.badge-pill-brand（绿底 pill，用于"读完" 标签） */
.badge-pill-brand {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 16rpx;
  background: var(--brand);                 /* #07C160，brand 绿（不参与主题切换） */
  color: var(--badge-on);                   /* #FFFFFF */
  border-radius: 16rpx;
  font-size: calc(22rpx * var(--fs, 1));
  font-weight: 500;
  flex-shrink: 0;
}

/* 原语 1 .cell-arrow（已读完行的 chevron） */
.form-row .cell-arrow {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 操作按钮行（skill 原语 16 .btn-row：居中 + gap 24rpx） */
.btn-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;                  /* btn-gap */
  margin-top: 16rpx;
}

/* 标准按钮族（skill 原语 16，仅限打卡弹窗作用域 .action-sheet） */
.action-sheet .btn {
  flex: 1;                     /* 两按钮等宽 */
  height: 88rpx;               /* btn-h = 44pt iOS */
  border-radius: 44rpx;        /* 保留胶囊风格（上次明确要胶囊） */
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 500;
  border: none;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
  color: #fff;
}
.action-sheet .btn::after { border: none; }    /* 清除小程序 button 默认边框 */
.action-sheet .btn:active { opacity: 0.88; }   /* 按下态反馈（含 primary） */

.action-sheet .btn-secondary {
  background: var(--cell-active);
  color: var(--text);          /* 黑字（更微信原生，原灰字 text2 改为黑） */
}
.action-sheet .btn-secondary:active {
  background: var(--divider);
}
.action-sheet .btn-primary {
  /* 项目主色 #4a90d9（var(--brand)），与 seg-active 选中态一致；去渐变改实心 */
  background: var(--brand);
  color: #fff;
}

/* ====== 晋级卡片（微信原生 progress 组件） ====== */
.promote-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
}

.promote-title {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  margin-bottom: 16rpx;
}

.promote-bar-row {
  display: flex;
  align-items: center;
}

.promote-bar {
  flex: 1;
  min-width: 0;
}

.promote-percent {
  margin-left: 16rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
  width: 88rpx;
  text-align: right;
  flex-shrink: 0;
}

.promote-meta {
  margin-top: 12rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text3);
  margin-bottom: 24rpx;
}

.promote-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: calc(30rpx * var(--fs, 1));
  margin: 0;
}

.promote-btn-active {
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
}

.promote-btn-active:active {
  opacity: 0.88;
}

.promote-btn-disabled {
  color: var(--text3);
  background: var(--cell-active);
}

/* ====== 晋级弹窗 ====== */
.pm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}

.pm-mask-show {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
}

.pm-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.pm-mask-show .pm-sheet {
  transform: translateY(0);
}

.pm-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--divider);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

.pm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.pm-title {
  flex: 1;
  font-size: calc(32rpx * var(--fs, 1));
  color: #1f4a84;
}

.pm-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text3);
  border-radius: 50%;
}

.pm-close:active {
  background: var(--cell-active);
  color: var(--text2);
}

.pm-stage-info {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.pm-stage-name {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  margin-bottom: 8rpx;
}

.pm-stage-tip {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

.pm-form {
  background: var(--card);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.pm-form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.pm-picker {
  display: block;
}

.pm-form-item:last-child {
  border-bottom: none;
}

.pm-form-label {
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  width: 160rpx;
}

.pm-form-value {
  flex: 1;
  text-align: right;
  font-size: calc(28rpx * var(--fs, 1));
  color: #4a90d9;
}

.pm-form-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.pm-num-input {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 64rpx;
  padding: 0 16rpx;
}

.pm-form-unit {
  flex-shrink: 0;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
}

.pm-quick-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.pm-quick-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  text-align: center;
  background: var(--cell-active);
  color: #4a90d9;
  font-size: calc(26rpx * var(--fs, 1));
  border-radius: 12rpx;
}

.pm-quick-btn:active {
  background: var(--divider);
}

.pm-actions {
  display: flex;
  justify-content: center;
  align-items: center;
}

.pm-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: calc(30rpx * var(--fs, 1));
  border: none;
  text-align: center;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
}

.pm-btn::after {
  border: none;
}

.pm-btn-cancel {
  background: var(--cell-active);
  color: var(--text2);
  margin-right: 4%;
}

.pm-btn-cancel:active {
  background: var(--divider);
}

.pm-btn-ok {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  color: #fff;
}

.pm-btn-ok:active {
  opacity: 0.88;
}

/* ====== 深色模式适配（微信小程序深色规范） ====== */
.dm-dark .kp-item-hi {
  background: linear-gradient(90deg, #2a2016 0%, #1c1c1e 100%);
}

.dm-dark .kp-item-hi .kp-text {
  color: #e0a56a;
}

