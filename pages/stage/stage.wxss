/* ====== 关键要点（方案A：紧凑列表） ====== */
.key-point-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 22rpx rgba(59, 99, 171, 0.08);
  border: 2rpx solid #e8eef7;
  position: relative;
}

/* 要点列表 */
.kp-list {
  margin-top: 8rpx;
}

/* 单条要点 */
.kp-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #fafbfc;
}

.kp-item:last-child {
  margin-bottom: 0;
}

/* 重要条目高亮 */
.kp-item-hi {
  background: linear-gradient(90deg, #fff8f0 0%, #fff 100%);
  border-left: 4rpx solid #ff7a45;
}

/* 小圆点 */
.kp-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c0c8d0;
  margin-right: 16rpx;
  margin-top: 12rpx;
}

.kp-dot-hi {
  background: #ff7a45;
  box-shadow: 0 0 8rpx rgba(255, 122, 69, 0.4);
}

/* 内容区 */
.kp-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 文本 */
.kp-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4a5870;
}

.kp-item-hi .kp-text {
  color: #8a4a20;
  font-weight: 500;
}

/* 重要标签 */
.kp-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: #ff7a45;
  background: #fff2e8;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1.5;
  font-weight: 500;
  flex-shrink: 0;
}

.kp-tag-hi {
  color: #fff;
  background: linear-gradient(135deg, #ff7a45 0%, #ff9c6e 100%);
  box-shadow: 0 2rpx 6rpx rgba(255, 122, 69, 0.3);
}

/* 资源行里不可打卡的提示（灰色说明行） */
.r-sub-note {
  color: #b0b9c5;
  font-style: italic;
}

/* ====== 阶段资源（核心打卡，上半区） ====== */
.res-wrap {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx 20rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 22rpx rgba(59, 99, 171, 0.08);
  border: 2rpx solid #e8eef7;
  position: relative;
  overflow: hidden;
}

.res-head {
  display: flex;
  flex-direction: column;
  padding: 22rpx 10rpx 18rpx;
  position: relative;
  z-index: 1;
  gap: 10rpx;
}

.res-head-left {
  display: flex;
  align-items: center;
}

.res-head-accent {
  width: 6rpx;
  height: 38rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4a90d9 0%, #6ab0f3 100%);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.res-hl-stage {
  font-size: 34rpx;
  font-weight: 800;
  color: #153b72;
  letter-spacing: 2rpx;
}

.res-head-sub {
  padding-left: 22rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #5a6f8a;
  letter-spacing: 0.5rpx;
}

.res-hl-bold {
  font-weight: 700;
  color: #1f5fb0;
}

.res-hl-time {
  font-weight: 600;
  color: #2a5896;
}

.res-hl-phase {
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  margin: 0 4rpx;
  display: inline-block;
  vertical-align: 2rpx;
}

.res-hl-sep {
  color: #99a6b8;
  font-weight: 500;
}

.res-hl-paren {
  color: #99a6b8;
  font-weight: 600;
}

.res-hl-text {
  color: #5a6f8a;
}

.res-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #dbe4f1 20%, #dbe4f1 80%, transparent 100%);
  margin: 4rpx 8rpx 16rpx;
}


.res-list {
  margin-bottom: 24rpx;
}

.res-list:last-child {
  margin-bottom: 0;
}

.rg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 14rpx;
  margin-bottom: 8rpx;
}

.rg-head-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rg-head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rg-head-active {
  cursor: pointer;
}

.rg-head-active:active {
  background: #f8fafc;
  border-radius: 12rpx;
}

.rg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
/* 主线绘本 */
.rg-dot-main_picture_books { background: #4a90d9; box-shadow: 0 0 8rpx rgba(74,144,217,0.5); }
.rg-label-main_picture_books { color: #1a5fb0; }

/* 主线分级 */
.rg-dot-main_graded_readers { background: #7b5fd6; box-shadow: 0 0 8rpx rgba(123,95,214,0.5); }
.rg-label-main_graded_readers { color: #4a26a8; }

/* 主线动画 */
.rg-dot-main_animations { background: #ff7a45; box-shadow: 0 0 8rpx rgba(255,122,69,0.5); }
.rg-label-main_animations { color: #c4390e; }

/* 辅线分级 */
.rg-dot-sub_graded_readers { background: #13c2c2; box-shadow: 0 0 8rpx rgba(19,194,194,0.5); }
.rg-label-sub_graded_readers { color: #006d75; }

/* 辅线动画 */
.rg-dot-sub_animations { background: #f759ab; box-shadow: 0 0 8rpx rgba(247,89,171,0.5); }
.rg-label-sub_animations { color: #b0156e; }

/* 趣味拓展 */
.rg-dot-fun_extensions { background: #73d13d; box-shadow: 0 0 8rpx rgba(115,209,61,0.5); }
.rg-label-fun_extensions { color: #389e0d; }

/* 科普拓展 */
.rg-dot-science_extensions { background: #ffc53d; box-shadow: 0 0 8rpx rgba(255,197,61,0.5); }
.rg-label-science_extensions { color: #ad6800; }

/* 融合APP */
.rg-dot-fusion_apps { background: #9254de; box-shadow: 0 0 8rpx rgba(146,84,222,0.5); }
.rg-label-fusion_apps { color: #531dab; }

/* 默认 */
.rg-dot-default { background: #bfbfbf; }
.rg-label-default { color: #8c8c8c; }

.rg-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #334;
}

.rg-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.rg-count {
  font-size: 22rpx;
  color: #99a;
}

/* 分组进度摘要 */
.rg-progress {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #3fae68;
  margin-right: 12rpx;
  background: #f0faf4;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.rg-progress-empty {
  color: #bbb;
  background: #f5f6f8;
}

.rg-progress-locked {
  color: #c8cdd4;
  background: #f5f6f8;
}

/* 锁定提示条 */
.lock-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fdf6ec, #f9efe1);
  border: 2rpx solid #f5d99a;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.lock-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.lock-text {
  font-size: 26rpx;
  color: #8b6914;
  line-height: 1.5;
}

.rg-collapsed-locked {
  color: #b0b4bb !important;
  font-style: italic;
}

.r-sub-locked {
  color: #b0b4bb;
  font-size: 24rpx;
}

.rg-progress-val {
  font-weight: 600;
  color: #2a9a5a;
}

.rg-progress-sep {
  margin: 0 6rpx;
  color: #ccc;
}

.rg-progress-read {
  color: #666;
}

/* 展开/折叠箭头 */
.rg-arrow {
  font-size: 32rpx;
  color: #c0c8d0;
  font-weight: 300;
  transition: transform 0.2s;
}

.rg-arrow-open {
  transform: rotate(90deg);
}

/* 折叠状态提示 */
.rg-body-collapsed {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  min-height: 64rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  border: 2rpx dashed #e5e8ee;
}

.rg-collapsed-hint {
  font-size: 24rpx;
  color: #99a;
  text-align: center;
}

.rg-collapsed-note {
  color: #b0b9c5;
  font-style: italic;
}

.rg-body {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(40, 70, 120, 0.05);
  border: 2rpx solid #eef2f7;
}

.r-row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #f0f3f7;
  min-height: 92rpx;
  box-sizing: border-box;
}

.r-row:last-child {
  border-bottom: none;
}

.r-row-click:active {
  background: #f2f6fd;
}

.r-row-done {
  background: linear-gradient(90deg, #f2fbf5 0%, #ffffff 55%);
}

.r-row-done:active {
  background: #e5f5ea;
}

.r-no {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #eaf2ff;
  color: #2e6bb8;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.r-no-char {
  background: linear-gradient(135deg, #5a9af0 0%, #7fb4f7 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.r-row-done .r-no {
  background: #dff0e5;
  color: #2f7a4a;
}

.r-body {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.r-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2a3140;
  line-height: 1.4;
}

.r-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #3fae68;
  line-height: 1.4;
}

.r-sub-hint {
  color: #99a5b7;
}

.r-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

/* 已读次数徽标 */
.r-read-badge {
  background: #fff7e6;
  color: #d48806;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
}

/* 读完按钮 */
.r-read-btn {
  background: #fff;
  color: #ff7a45;
  border: 1rpx solid #ffd1a8;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}
.r-read-btn:active {
  background: #fff7e6;
}

.r-badge {
  background: linear-gradient(135deg, #3fae68, #65c687);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(63, 174, 104, 0.28);
}

.r-arrow {
  color: #4a90d9;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.r-arrow-gray {
  color: #cfd4dc;
  font-weight: 700;
  font-size: 48rpx;
}

/* ====== 底部打卡弹窗 ====== */
.ci-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}

.ci-mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.ci-sheet {
  width: 100%;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.ci-mask-show .ci-sheet {
  transform: translateY(0);
}

.ci-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e3e8ee;
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}

.ci-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.ci-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f4a84;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}

.ci-sort {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4a90d9;
  background: #eef5ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.ci-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: #aaa;
  border-radius: 50%;
}

.ci-close:active { background: #f3f4f6; color: #555; }

/* Form container - WeChat style card */
.ci-form {
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.ci-form-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.ci-form-item:last-child {
  border-bottom: none;
}

.ci-form-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
}

.ci-form-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.ci-num-input {
  flex: 1;
  text-align: right;
  font-size: 34rpx;
  color: #111;
  font-weight: 500;
  height: 64rpx;
  padding: 0 16rpx;
}

.ci-form-unit {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.ci-text-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 64rpx;
  text-align: right;
}

.ci-text-input::placeholder {
  color: #bbb;
}

/* Quick buttons row */
.ci-quick-row {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0 20rpx;
}

.ci-quick-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #fff;
  color: #333;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e5e5;
}

.ci-quick-btn:active {
  background: #e8f4ff;
  border-color: #4a90d9;
  color: #4a90d9;
}

.ci-read-count {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.ci-read-tag {
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 500;
  margin: 0 8rpx;
}

.ci-form-arrow {
  font-size: 36rpx;
  color: #c0c0c0;
}

.ci-form-item:active {
  background: #e8f4ff;
}

.ci-actions {
  display: flex;
  justify-content: center;
  align-items: center;
}

.ci-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  text-align: center;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
}

.ci-btn::after { border: none; }

.ci-btn-cancel {
  background: #f2f4f7;
  color: #556;
  margin-right: 4%;
}

.ci-btn-cancel:active {
  background: #e0e3e8;
}

.ci-btn-ok {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  color: #fff;
  font-weight: 600;
}

.ci-btn-ok:active { opacity: 0.88; }
