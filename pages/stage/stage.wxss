/* ====== 阶段详情页样式（按 WeUI 规范重构） ======
   设计令牌统一引用全局 --*（已对齐 WeUI，见 ui-design-spec / app.wxss）：
   --bg/--card/--card2/--text/--text2/--text3/--divider/--brand/--danger/--cell-active
   字号：主文 34rpx(17px) · 次级/分组标题 28rpx(14px) · 三级/占位 24rpx(12px)
   间距：页面与 cell 内边距 32rpx · 圆角 按钮 16rpx / 卡片 16~24rpx / 徽标 16~20rpx
   深色模式：仅分类色与品牌绿低透明底需两套值，集中在下方变量块覆盖，其余颜色走 var() 自动跟随。 */

/* === 颜色变量：浅色默认（挂在根节点 .container，随 dm-* 切换） === */
.container {
  /* 8 类资源语义色（区分分类；浅色为实色） */
  --dot-mpb: #e74c3c;   /* 主线绘本 */
  --dot-mgr: #e67e22;   /* 主线分级 */
  --dot-man: #f1c40f;   /* 主线动画 */
  --dot-sgr: #2ecc71;   /* 辅线分级 */
  --dot-san: #1abc9c;   /* 辅线动画 */
  --dot-fex: #3498db;   /* 趣味拓展 */
  --dot-sex: #9b59b6;   /* 科普拓展 */
  --dot-fap: #8e44ad;   /* 融合APP */
  --dot-def: #888888;   /* 默认 */
  /* 品牌绿低透明底（扁平纯色，无渐变） */
  --brand-soft: rgba(7, 193, 96, 0.1);
  --brand-softer: rgba(7, 193, 96, 0.06);
  /* 序号首字母方块底色 / 行尾箭头色（深浅各一档） */
  --no-char: #5a9af0;
  --row-arrow: var(--text3);
}

/* 深色：分类色提亮 + 品牌绿底加深 + 箭头转品牌绿（仅一处覆盖，免去逐条 .dm-dark） */
.dm-dark {
  --dot-mpb: #ff6b6b;
  --dot-mgr: #f5b041;
  --dot-man: #f7dc6f;
  --dot-sgr: #58d68d;
  --dot-san: #48c9b0;
  --dot-fex: #5dade2;
  --dot-sex: #bb8fce;
  --dot-fap: #af7ac5;
  --dot-def: #b2b2b2;
  --brand-soft: rgba(7, 193, 96, 0.16);
  --brand-softer: rgba(7, 193, 96, 0.14);
  --no-char: #4a8fd9;
  --row-arrow: var(--brand);
}

@media (prefers-color-scheme: dark) {
  .dm-auto {
    --dot-mpb: #ff6b6b;
    --dot-mgr: #f5b041;
    --dot-man: #f7dc6f;
    --dot-sgr: #58d68d;
    --dot-san: #48c9b0;
    --dot-fex: #5dade2;
    --dot-sex: #bb8fce;
    --dot-fap: #af7ac5;
    --dot-def: #b2b2b2;
    --brand-soft: rgba(7, 193, 96, 0.16);
    --brand-softer: rgba(7, 193, 96, 0.14);
    --no-char: #4a8fd9;
    --row-arrow: var(--brand);
  }
}

/* ====== 关键要点（复用全局 .weui-cell，文字走 token） ====== */
.kp-text {
  display: block;
  font-size: calc(34rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
}
.kp-text-hi { color: var(--text); }

/* ====== 阶段资源分组（核心打卡，上半区） ====== */
.res-wrap {
  background: var(--card);
  position: relative;
  overflow: hidden;
}

/* 每个分组块底部通栏分割线，分隔相邻分组（展开/折叠都生效） */
.res-list { border-bottom: 1rpx solid var(--divider); }
.res-list:last-child { border-bottom: none; }

/* 分组头（左：彩色圆点+标签+数量；右：进度摘要+箭头） */
.rg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
  padding: 24rpx 32rpx;
}
.rg-head-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.rg-head-right { display: flex; align-items: center; flex-shrink: 0; }
.rg-head-active:active {
  background: var(--cell-active);
  border-radius: 12rpx;
}

/* 分类彩色圆点（扁平纯色，无外发光） */
.rg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: var(--dot-def);
}
.rg-dot-main_picture_books { background: var(--dot-mpb); }
.rg-dot-main_graded_readers { background: var(--dot-mgr); }
.rg-dot-main_animations { background: var(--dot-man); }
.rg-dot-sub_graded_readers { background: var(--dot-sgr); }
.rg-dot-sub_animations { background: var(--dot-san); }
.rg-dot-fun_extensions { background: var(--dot-fex); }
.rg-dot-science_extensions { background: var(--dot-sex); }
.rg-dot-fusion_apps { background: var(--dot-fap); }

.rg-label {
  flex: 1;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}
.rg-label-main_picture_books { color: var(--dot-mpb); }
.rg-label-main_graded_readers { color: var(--dot-mgr); }
.rg-label-main_animations { color: var(--dot-man); }
.rg-label-sub_graded_readers { color: var(--dot-sgr); }
.rg-label-sub_animations { color: var(--dot-san); }
.rg-label-fun_extensions { color: var(--dot-fex); }
.rg-label-science_extensions { color: var(--dot-sex); }
.rg-label-fusion_apps { color: var(--dot-fap); }
.rg-label-default { color: var(--text3); }

.rg-count {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* 分组进度摘要（品牌绿浅底标签） */
.rg-progress {
  display: flex;
  align-items: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--brand);
  margin-right: 12rpx;
  background: var(--brand-soft);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.rg-progress-empty,
.rg-progress-locked { color: var(--text3); background: var(--cell-active); }
.rg-progress-val { color: var(--brand); }
.rg-progress-sep { margin: 0 6rpx; color: var(--text3); }
.rg-progress-read { color: var(--text2); }

/* 展开/折叠箭头 */
.rg-arrow {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  font-weight: 300;
  transition: transform 0.2s;
}
.rg-arrow-open { transform: rotate(90deg); }

/* 展开内容区（扁平，顶部细分隔线） */
.rg-body {
  background: var(--card);
  border-top: 1rpx solid var(--divider);
  overflow: hidden;
}

/* 资源行（序号/首字母 + 名称/副文 + 徽标/箭头） */
.r-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
  min-height: 144rpx;
  box-sizing: border-box;
}
.r-row:last-child { border-bottom: none; }
.r-row-click:active { background: var(--cell-active); }

/* 已打卡行：品牌绿浅底（纯色，无渐变） */
.r-row-done { background: var(--brand-softer); }
.r-row-done:active { background: var(--brand-soft); }

/* 序号方块：品牌绿浅底 */
.r-no {
  flex-shrink: 0;
  margin-right: 32rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
/* 首字母占位：纯色蓝 */
.r-no-char { background: var(--no-char); color: #fff; }

.r-body { flex: 1; min-width: 0; margin-right: 12rpx; }
.r-name {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.4;
}
.r-sub {
  margin-top: 6rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--brand);
  line-height: 1.4;
}
.r-sub-hint { color: var(--text3); }
.r-sub-locked { color: var(--text3); font-size: calc(28rpx * var(--fs, 1)); }
.r-sub-note { color: var(--text3); font-style: italic; }

.r-right { display: flex; align-items: center; flex-shrink: 0; gap: 8rpx; }

/* 时长徽标（品牌绿，无渐变） */
.r-badge {
  background: var(--brand);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: calc(28rpx * var(--fs, 1));
  margin-right: 8rpx;
}

/* 行尾箭头：跟随 --row-arrow（浅色占位灰 / 深色品牌绿） */
.r-arrow {
  color: var(--row-arrow);
  font-size: 49rpx;
  line-height: 1;
  font-weight: 300;
}

/* ====== 完成阶段按钮（复用全局 .weui-btn，仅控制外边距） ====== */
.promote-btn-area { margin: 32rpx 32rpx 0; }

/* ====== 打卡弹窗（action-sheet 原语 + 表单原语） ====== */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}
.sheet-mask-show { background: rgba(0, 0, 0, 0.5); pointer-events: auto; }
.action-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sheet-mask-show .action-sheet { transform: translateY(0); }

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--divider);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.sheet-head-title {
  flex: 1;
  min-width: 0;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}
.sheet-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 53rpx;
  color: var(--text3);
  border-radius: 50%;
}
.sheet-close:active { background: var(--cell-active); color: var(--text2); }

/* 表单卡片（圆角白底） */
.form-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.form-row:active { background: var(--cell-active); }
.form-label {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  width: 140rpx;
}
.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.form-field {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 64rpx;
}
.form-unit {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  margin-left: 8rpx;
}
.form-card .weui-divider { height: 1rpx; background: var(--divider); margin: 0; }

/* 快捷时长分段控件（等宽 variant：.seg-control-grid） */
.seg-control { display: flex; align-items: center; flex: 1; }
.seg-control-grid .seg-item { flex: 1; text-align: center; }
.seg-item {
  height: 56rpx;
  padding: 0 32rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--divider);
  border-radius: 8rpx;
  background: var(--card);
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  box-sizing: border-box;
}
.seg-item:first-child { margin-left: 0; }
.seg-item:active { background: var(--cell-active); }
.seg-active { border-color: var(--brand); color: var(--brand); background: var(--card); }

/* 已读完行 chevron */
.form-row .icon-right {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 弹窗内按钮：两按钮等宽 + 与表单留白 */
.action-sheet .weui-btn { flex: 1; }
.action-sheet .weui-btn-area_inline { margin-top: 16rpx; }

/* ====== 晋级测试弹窗 ====== */
.pm-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}
.pm-mask-show { background: rgba(0, 0, 0, 0.5); pointer-events: auto; }
.pm-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.pm-mask-show .pm-sheet { transform: translateY(0); }

.pm-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--divider);
  border-radius: 4rpx;
  margin: 8rpx auto 24rpx;
}
.pm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.pm-title { flex: 1; font-size: calc(34rpx * var(--fs, 1)); color: var(--text); }
.pm-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 53rpx;
  color: var(--text3);
  border-radius: 50%;
}
.pm-close:active { background: var(--cell-active); color: var(--text2); }

.pm-stage-info {
  background: var(--card2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.pm-stage-name {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  margin-bottom: 8rpx;
}
.pm-stage-tip {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

.pm-form {
  background: var(--card);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.pm-form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.pm-form-item:last-child { border-bottom: none; }
.pm-form-label {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  width: 160rpx;
}
.pm-form-value {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--brand);
}
.pm-form-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.pm-num-input {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 64rpx;
  padding: 0 16rpx;
}
.pm-form-unit {
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}
.pm-quick-row { display: flex; gap: 12rpx; margin-bottom: 32rpx; }
.pm-quick-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  text-align: center;
  background: var(--cell-active);
  color: var(--brand);
  font-size: calc(28rpx * var(--fs, 1));
  border-radius: 12rpx;
}
.pm-quick-btn:active { background: var(--divider); }
.pm-actions { display: flex; justify-content: center; align-items: center; }

/* 弹窗底部按钮：WeUI 矩形圆角（无胶囊） */
.pm-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: calc(34rpx * var(--fs, 1));
  border: none;
  text-align: center;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
}
.pm-btn::after { border: none; }
.pm-btn-cancel { background: var(--cell-active); color: var(--text2); margin-right: 4%; }
.pm-btn-cancel:active { background: var(--divider); }
.pm-btn-ok { background: var(--brand); color: #fff; }
.pm-btn-ok:active { opacity: 0.88; }

/* 详情页字体基准：常规路径 34rpx 起算（子节点 calc(Nrpx*var(--fs)) 已同步；此处供 input 继承） */
.sheet-mask,
.pm-mask { font-size: calc(34rpx * var(--fs, 1)); }
