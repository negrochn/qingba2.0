}

.dm-dark .lock-text { color: #e0a56a; }

.dm-dark .r-read-badge { color: #ffd666; background: rgba(255, 214, 102, 0.16); }
.dm-dark .r-read-btn { color: #ff9c6e; border-color: rgba(255, 156, 110, 0.4); }
.dm-dark .r-read-btn:active { background: rgba(255, 214, 102, 0.16); }

.dm-dark .r-arrow { color: #8ab4ff; }

.dm-dark .pm-title {
  color: #6f9ee8;
}


.dm-dark .pm-form-value { color: #8ab4ff; }
.dm-dark .pm-quick-btn { color: #8ab4ff; }

