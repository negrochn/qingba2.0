/* 设置页 - WeUI 风格分组列表，组件原语见全局 app.wxss（.weui-cells / .weui-cell 等） */
page {
  background: var(--bg);
}

/* 「数据与备份」入口的提醒红点：数据量达标且超期未备份时常驻显示 */
.backup-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  vertical-align: middle;
}
