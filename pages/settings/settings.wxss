/* 设置页 - 微信小程序原生分组列表风格（支持深色模式） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组 ===== */
.group {
  margin-bottom: 24rpx;
}

.group-title {
  padding: 16rpx 40rpx 12rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
}

.group-card {
  background: var(--card);
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* ===== 列表项 ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.cell-picker {
  display: block;
}

.cell-picker .cell:active,
.cell:active {
  background: var(--cell-active);
}

.cell-label {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

.cell-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.cell-desc {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  margin-top: 8rpx;
}

.cell-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 60%;
}

.cell-value {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

.cell-value.placeholder {
  color: var(--text3);
  opacity: 0.7;
}

.cell-desc-right {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
}

.cell-arrow {
  font-size: calc(36rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
}

/* 危险操作 */
.cell-danger .cell-label {
  color: #fa5151;
}

.cell-danger .cell-desc-right {
  color: #f5a3a3;
}

/* 分隔线：左侧留白（微信原生 inset） */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 32rpx;
}
