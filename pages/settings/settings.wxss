/* 设置详情页 - 微信小程序原生风格（品牌蓝 #4a90d9） */

page {
  background: #f5f6f8;
}

.container {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 卡片：扁平白卡，无投影无装饰边框 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 12rpx;
  margin-bottom: 24rpx;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: "";
  display: inline-block;
  flex-shrink: 0;
  width: 6rpx;
  height: 28rpx;
  background: #4a90d9;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* ===== 操作项 ===== */
.action-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.danger .action-title {
  color: #e74c3c;
}

.action-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.action-icon.backup {
  background: #e8f5e9;
}

.action-icon.import {
  background: #eef4fd;
}

.action-icon.delete {
  background: #ffebee;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
}

.action-arrow {
  font-size: 32rpx;
  color: #c0c8d0;
}

/* ===== 信息项 ===== */
.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #1a1a1a;
}

.info-value {
  font-size: 28rpx;
  color: #888;
}

/* ===== 学习进度 ===== */
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.picker-label {
  font-size: 28rpx;
  color: #1a1a1a;
}

.picker-value-wrap {
  display: flex;
  align-items: center;
}

.picker-value {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 500;
}

.picker-arrow {
  font-size: 32rpx;
  color: #c0c8d0;
  margin-left: 8rpx;
}

.stage-preview {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #eef4fd;
  border-radius: 12rpx;
}

.stage-preview.empty {
  background: #f7f8fa;
  border: 2rpx dashed #ebedf0;
  color: #aaa;
  text-align: center;
  font-size: 26rpx;
  padding: 28rpx;
}

.stage-preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.stage-preview-desc {
  font-size: 24rpx;
  color: #666;
}

/* ===== 原生 Picker 样式优化 ===== */
.stage-picker {
  width: 100%;
}

.stage-picker .picker-item {
  font-size: 32rpx;
  min-height: 88rpx;
}

/* ===== 小小优趣成长计划开关 ===== */
.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-top: 1rpx solid #ebedf0;
}

.switch-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.switch-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
