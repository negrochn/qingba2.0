<view class="container">

  <!-- 学习进度卡片 -->
  <view class="card">
    <view class="card-head">
      <view class="card-accent"></view>
      <view class="card-title">学习进度</view>
    </view>

    <view class="picker-item" bindtap="onOpenStagePicker">
      <view class="picker-label">当前阶段</view>
      <view class="picker-value-wrap">
        <view class="picker-value">{{currentStageDisplay || '未设置'}}</view>
        <view class="picker-arrow">›</view>
      </view>
    </view>

    <view class="stage-preview" wx:if="{{currentStage}}">
      <view class="stage-preview-title">{{currentStage.name}} · {{currentStage.targetPhase}}</view>
      <view class="stage-preview-desc">积累 {{currentStage.vocabularyTarget}} · {{currentStage.timeInvestment}}</view>
    </view>
    <view class="stage-preview empty" wx:else>
      请选择当前学习阶段
    </view>
  </view>

  <!-- 阶段选择弹窗 -->
  <view class="modal-mask {{stagePickerShow ? 'show' : ''}}" bindtap="onCloseStagePicker" wx:if="{{stagePickerShow}}">
    <view class="modal-sheet stage-sheet" catchtap="">
      <view class="modal-title">选择当前阶段</view>
      <view class="modal-desc">选择正在学习的阶段，路线页会自动高亮</view>
      <view class="stage-list">
        <view
          class="stage-option {{index === currentStageIndex ? 'active' : ''}}"
          wx:for="{{stageOptions}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onSelectStage"
        >
          <view class="stage-option-check" wx:if="{{index === currentStageIndex}}">✓</view>
          <view class="stage-option-check" wx:else></view>
          <view class="stage-option-info">
            <view class="stage-option-name">{{item.name}}</view>
            <view class="stage-option-phase">{{item.id === 'regular_1' ? 'phase5' : item.id === 'regular_2' ? 'phase6' : item.id === 'regular_3' ? 'phase7' : item.id === 'regular_4' ? 'phase8' : item.id === 'regular_5' ? 'phase9' : item.id === 'regular_6' ? 'phase10' : 'phase10+'}}</view>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="onCloseStagePicker">取消</button>
      </view>
    </view>
  </view>

  <!-- 数据管理卡片 -->
  <view class="card">
    <view class="card-head">
      <view class="card-accent"></view>
      <view class="card-title">数据管理</view>
    </view>

    <!-- 备份 -->
    <view class="action-item" bindtap="onBackup">
      <view class="action-icon backup">📤</view>
      <view class="action-info">
        <view class="action-title">导出备份</view>
        <view class="action-desc">生成 JSON 文件，保存到本地或分享给好友</view>
      </view>
      <view class="action-arrow">›</view>
    </view>

    <!-- 导入 -->
    <view class="action-item" bindtap="onImport">
      <view class="action-icon import">📥</view>
      <view class="action-info">
        <view class="action-title">导入备份</view>
        <view class="action-desc">从微信聊天记录中选择 JSON 文件</view>
      </view>
      <view class="action-arrow">›</view>
    </view>

    <!-- 清空数据 -->
    <view class="action-item danger" bindtap="onClearData">
      <view class="action-icon delete">🗑️</view>
      <view class="action-info">
        <view class="action-title">清空数据</view>
        <view class="action-desc" wx:if="{{totalCount > 0}}">共 {{totalCount}} 条记录将被删除</view>
        <view class="action-desc" wx:else>暂无数据</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="card">
    <view class="card-head">
      <view class="card-accent"></view>
      <view class="card-title">数据统计</view>
    </view>

    <view class="stat-grid">
      <view class="stat-item">
        <view class="stat-num">{{totalCount}}</view>
        <view class="stat-label">打卡次数</view>
      </view>
      <view class="stat-divider"></view>

      <view class="stat-item">
        <view class="stat-num">{{totalDays}}</view>
        <view class="stat-label">学习天数</view>
      </view>

      <view class="stat-divider"></view>

      <view class="stat-item">
        <view class="stat-num">{{totalHours}}</view>
        <view class="stat-label">累计时长(h)</view>
      </view>
    </view>
  </view>

  <!-- 关于版本 -->
  <view class="card">
    <view class="card-head">
      <view class="card-accent"></view>
      <view class="card-title">关于</view>
    </view>

    <view class="info-item">
      <view class="info-label">版本号</view>
      <view class="info-value">2.0.0</view>
    </view>
    <view class="info-item">
      <view class="info-label">数据存储</view>
      <view class="info-value">本地存储</view>
    </view>
  </view>

</view>
