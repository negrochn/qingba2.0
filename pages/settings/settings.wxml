<view class="container">

  <!-- 打卡进度卡片 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">打卡进度</view>
    </view>

    <picker mode="selector" range="{{stageOptions}}" range-key="name" value="{{currentStageIndex}}" bindchange="onStageChange" class="stage-picker">
      <view class="picker-item">
        <view class="picker-label">当前阶段</view>
        <view class="picker-value-wrap">
          <view class="picker-value">{{currentStageDisplay || '未设置'}}</view>
          <view class="picker-arrow">›</view>
        </view>
      </view>
    </picker>

    <view class="stage-preview" wx:if="{{currentStage}}">
      <view class="stage-preview-title">{{currentStage.name}} · {{currentStage.targetPhase}}</view>
      <view class="stage-preview-desc">积累 {{currentStage.vocabularyTarget}} · {{currentStage.timeInvestment}}</view>
    </view>
    <view class="stage-preview empty" wx:else>
      请选择当前学习阶段
    </view>

    <view class="switch-item">
      <view class="switch-info">
        <view class="picker-label">小小优趣成长计划</view>
        <view class="switch-desc">开启后，常规阶段达标可解锁下一阶段</view>
      </view>
      <switch checked="{{youquEnabled}}" bindchange="onYouquPlanChange" color="#4a90d9" />
    </view>
  </view>

  <!-- 数据管理卡片 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">数据管理</view>
    </view>

    <!-- 导出备份 -->
    <picker mode="selector" range="{{exportOptions}}" range-key="label" bindchange="onExportModeChange">
      <view class="action-item">
        <view class="action-icon backup">📤</view>
        <view class="action-info">
          <view class="action-title">导出备份</view>
          <view class="action-desc">生成 docx 备份文件，可打开/转发</view>
        </view>
        <view class="action-arrow">›</view>
      </view>
    </picker>

    <!-- 导入备份 -->
    <picker mode="selector" range="{{importOptions}}" range-key="label" bindchange="onImportModeChange">
      <view class="action-item">
        <view class="action-icon import">📥</view>
        <view class="action-info">
          <view class="action-title">导入备份</view>
          <view class="action-desc">支持 txt / json / docx 备份文件</view>
        </view>
        <view class="action-arrow">›</view>
      </view>
    </picker>

    <!-- 清空数据 -->
    <picker wx:if="{{totalCount > 0}}" mode="selector" range="{{clearOptions}}" range-key="label" bindchange="onClearScopeChange">
      <view class="action-item danger">
        <view class="action-icon delete">🗑️</view>
        <view class="action-info">
          <view class="action-title">清空数据</view>
          <view class="action-desc">请选择要清空的范围</view>
        </view>
        <view class="action-arrow">›</view>
      </view>
    </picker>
    <view wx:else class="action-item danger">
      <view class="action-icon delete">🗑️</view>
      <view class="action-info">
        <view class="action-title">清空数据</view>
        <view class="action-desc">暂无数据</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
  </view>

  <!-- 开发者工具（压力测试）仅开发版显示 -->
  <view class="card" wx:if="{{showDevTools}}">
    <view class="card-head">
      <view class="card-title">开发者工具</view>
    </view>

    <view class="action-item" bindtap="onStressTest">
      <view class="action-icon">🧪</view>
      <view class="action-info">
        <view class="action-title">生成测试数据</view>
        <view class="action-desc">按真实计划生成：每阶段约80-90小时，日期从今天往回推算</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
  </view>

  <!-- 关于版本 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">关于</view>
    </view>

    <view class="info-item">
      <view class="info-label">版本号</view>
      <view class="info-value">{{appVersion}}</view>
    </view>
    <view class="info-item">
      <view class="info-label">数据存储</view>
      <view class="info-value">本地存储</view>
    </view>
  </view>

</view>
