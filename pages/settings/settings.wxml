<view class="container {{fontClass}} {{darkClass}}">

  <!-- 当前进度：状态项（我现在学到哪），与下方「学习设置」（偏好配置）分开 -->
  <view class="weui-cells__title">当前进度</view>
  <view class="weui-cells">
    <!-- 孩子管理：多孩功能的唯一管理入口（常驻，单孩也可进来改名/添加） -->
    <view class="weui-cell weui-cell_access" bindtap="goChildManage">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">孩子管理</view>
        <view class="weui-cell__desc">多个孩子各自记录打卡与进度</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value">{{childCountText}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goRoutePicker">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">当前路线</view>
        <view class="weui-cell__desc">打卡、记录与统计均跟随当前路线</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value">{{currentRouteName}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goStagePicker">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">当前阶段</view>
        <view class="weui-cell__desc">决定路线页解锁与推荐资源</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value {{currentStage ? '' : 'placeholder'}}">{{currentStageDisplay || '未设置'}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <!-- 学习设置：偏好配置（时长怎么算），跟随当前路线 / 阶段 -->
  <view class="weui-cells__title">学习设置</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" bindtap="goTargetSetting">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">阶段目标时长</view>
        <view class="weui-cell__desc">决定进度百分比与晋级判定，可逐阶段自定义</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value">{{targetSummary}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goMyResources">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">我的资源</view>
        <view class="weui-cell__desc">管理官方与自定义资源</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">小小优趣成长计划</view>
        <view class="weui-cell__desc">开启后，完成阶段需测试结果达标</view>
      </view>
      <switch checked="{{youquEnabled}}" bindchange="onYouquPlanChange" color="#07c160" />
    </view>
    <view class="weui-cell">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">熏听</view>
        <view class="weui-cell__desc">开启后可打卡「熏听」，时长按阶段系数折算</view>
      </view>
      <switch checked="{{listeningEnabled}}" bindchange="onListeningChange" color="#07c160" />
    </view>
  </view>

  <!-- 开发者工具（仅开发版显示） -->
  <block wx:if="{{showDevTools}}">
    <view class="weui-cells__title">开发者工具</view>
    <view class="weui-cells">
      <view class="weui-cell weui-cell_access" bindtap="onStressTest">
        <view class="weui-cell__bd">压力测试</view>
        <view class="weui-cell__ft">
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </view>
  </block>

  <!-- 关于 -->
  <view class="weui-cells__title">关于</view>
  <view class="weui-cells">
    <view class="weui-cell">
      <view class="weui-cell__bd">关于小程序</view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value">{{appVersionText}}</text>
      </view>
    </view>
  </view>

</view>

