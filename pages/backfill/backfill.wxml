<view class="container {{fontClass}} {{darkClass}}">
  <!-- 日期 / 阶段 一块白底分组；「学习内容」标题分隔出记录行块（含添加按钮）。
       行间线统一走 .weui-cell::before 与 .bf-row::before 的 left:32rpx 缩进细线；
       首行 cell-first 显式关线（picker 多包了一层，:first-child 判不到） -->
  <view class="bf-rows">
    <picker mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDateChange">
      <view class="weui-cell weui-cell_access cell-first">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">日期</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{dateText}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">阶段</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{selectedStageName || '请选择'}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
  </view>

  <view class="weui-cells__title">学习内容</view>
  <view class="bf-rows">
    <view class="bf-row" wx:for="{{rows}}" wx:key="rid">
      <view class="bf-res" data-rid="{{item.rid}}" bindtap="openPicker">
        <text class="bf-res-name {{item.resourceName ? '' : 'placeholder'}}">{{item.resourceName || '选择资源'}}</text>
        <text class="bf-res-group" wx:if="{{item.groupLabel}}">{{item.groupLabel}}</text>
      </view>
      <view class="bf-dur">
        <!-- 弹层打开期间把 <input> 整体移出 DOM、换成纯文本：
             键盘必须有「聚焦的输入框」作宿主，输入框不在了，它就不可能继续挂着、也不会被弹层的
             入场动画重新拉起。这是结构性保证 —— 不依赖 focus 属性的未文档化语义、不依赖
             wx.hideKeyboard 在哪些机型生效、也不依赖收键盘与弹层渲染谁先谁后（前两种做法真机均无效）。
             代价仅是：弹层打开期间时长以纯文本呈现，视觉与输入框一致（同宽同档同对齐） -->
        <input
          wx:if="{{!pickerShow}}"
          class="bf-dur-input"
          type="number"
          placeholder="0"
          placeholder-class="bf-dur-ph"
          value="{{item.durationInput}}"
          focus="{{focusRowKey === item.rid}}"
          data-rid="{{item.rid}}"
          confirm-type="done"
          bindfocus="onDurationFocus"
          bindinput="onDurationInput"
          bindconfirm="onDurationConfirm"
        />
        <text wx:else class="bf-dur-input bf-dur-static {{item.durationInput ? '' : 'bf-dur-ph'}}">{{item.durationInput || '0'}}</text>
        <text class="bf-dur-unit">分钟</text>
      </view>
      <view class="bf-del iconfont icon-close" data-rid="{{item.rid}}" catchtap="onRemoveRow"></view>
    </view>

    <view class="bf-add" bindtap="onAddRow">＋ 添加一条</view>
  </view>

  <!-- 熏听折算说明：仅当行里出现熏听素材时出现 -->
  <view class="weui-cells__tips" wx:if="{{listeningTip}}">{{listeningTip}}</view>
  <view class="weui-cells__tips">同一天可以添加多条，不同资源 / 时长各占一条。补录后可在「打卡记录」里编辑或删除。</view>

  <!-- 底部固定栏：实时汇总 + 一次提交 -->
  <view class="bf-footer">
    <view class="bf-summary">{{totalText}}</view>
    <button
      class="weui-btn weui-btn_block {{canSubmit ? 'weui-btn_primary' : 'weui-btn_disabled'}}"
      bindtap="submit"
    >确认补录</button>
  </view>

  <!-- 资源选择器（双列：左分组 / 右资源） -->
  <resource-picker
    show="{{pickerShow}}"
    stage-id="{{selectedStageId}}"
    value="{{pickerValue}}"
    font-class="{{fontClass}}"
    dark-class="{{darkClass}}"
    bind:change="onResourceChange"
    bind:close="onPickerClose"
  />

</view>
