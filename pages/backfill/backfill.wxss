/* 补录页（一次补一天的多条）
   weui-cells / weui-cell 等基础样式见全局 app.wxss。

   字号只用 WeUI 标准 UI 三档（34 / 28 / 24rpx），不使用已废弃的 22 / 26 / 30 / 32 / 36rpx。 */

page {
  background: var(--bg);
}

/* 底部固定栏占位：避免内容被遮住；顶部留白顶替原「补录日期」标题 */
.container {
  padding-top: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx);
}

/* ===== 记录行（「学习内容」块专用；日期 / 阶段已改用全局 .weui-cells） =====
   为何这块仍自绘：行不是 .weui-cell —— 资源名两行 + 时长输入 + 删除按钮 + 「＋ 添加一条」，
   行高与内边距策略（左侧 32rpx、右侧留给 88rpx 热区）都与 .weui-cell 的四周 32rpx 不同，
   硬套 .weui-cell 反而要写更多覆盖。外观仍对齐它：白底 + 上下 1px 通栏线（细线统一方案） */
.bf-rows {
  position: relative;
  background: var(--card);
}

.bf-rows::before,
.bf-rows::after {
  content: ' ';
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  pointer-events: none;
}

.bf-rows::before { top: 0; transform-origin: top; }
.bf-rows::after { bottom: 0; transform-origin: bottom; }

.bf-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding-left: 32rpx;
  box-sizing: border-box;
}

/* 行间缩进细线（缩进 32rpx 与 .weui-cell 一致，首行不画） */
.bf-row::before {
  content: ' ';
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.bf-row:first-child::before { display: none; }

/* picker 会把每个 cell 包成「它自己」的首个子节点，于是全局的
   `.weui-cell:first-child::before { display: none }` 对两行都生效 —— 不是「只关首行」，
   而是把日期与阶段的行间线一起关掉了（原先那句「:first-child 判不到」的注释把因果写反了，
   补的 .cell-first 显式关线其实是死代码）。
   这里反过来处理：给非首个 picker 里的 cell 显式开线，首行（日期）保持无线。
   特异性 (0,3,0) 高于全局的 (0,2,0)，且页面样式加载在 app.wxss 之后 */
.weui-cells > picker:not(:first-child) .weui-cell::before { display: block; }

.bf-res {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

/* 资源名与分组小字收紧行高（1.2）：page 的 line-height 是 1.6，两行叠起来会把
   「已选资源」的行撑到约 127rpx，比同块的日期 / 阶段行（112rpx）高出一截；
   收紧后内容约 104rpx，由 .bf-row 的 min-height: 112rpx 兜住，全块行高一致 */
.bf-res-name {
  font-size: calc(34rpx * var(--fs, 1));
  line-height: 1.2;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bf-res-name.placeholder { color: var(--text3); }

/* 分组标签：辅助档 24rpx（FG-2） */
.bf-res-group {
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.2;
  color: var(--text3);
  margin-top: 2rpx;
}

.bf-dur {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-right: 8rpx;
}

/* 时长输入框：宽 160rpx（原 120rpx，再宽会让资源名放不下最长的素材名）、
   高 88rpx（项目「可点项最小热区」口径，与 .cell-input / .form-field 同值） */
.bf-dur-input {
  width: 160rpx;
  height: 88rpx;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.bf-dur-ph { color: var(--text3); }

/* 弹层打开期间替代 <input> 的纯文本（见 wxml 注释）：
   复用 .bf-dur-input 的宽 / 高 / 右对齐 / 字号，只补 line-height 让它在 88rpx 盒子里垂直居中，
   避免切换时行宽与行高跳动 */
.bf-dur-static { line-height: 88rpx; }

/* 单位：与输入框数字同档 34rpx，与 .form-unit（stage 打卡弹窗 / editRecord）一致。
   原先用辅助档 24rpx，虽然 flex 居中让两者盒子中心对齐，但字号差一档会让
   上下边界和基线都错开，看起来「分钟」矮了一截、与数字不齐 */
.bf-dur-unit {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}

/* 删除：热区 88rpx 宽、与行等高（满足 7~9mm 最小点击区） */
.bf-del {
  flex-shrink: 0;
  width: 88rpx;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}

.bf-del:active { background: var(--cell-active); }

/* 「＋ 添加一条」：主文档 34rpx，左右内距对齐 .weui-cell 的 32rpx。
   高度交给 min-height（与 .bf-row 同值），不靠上下 padding 撑 ——
   靠 padding 撑的话会跟着 page 的 line-height 1.6 变成约 118rpx，比资源行高 6rpx */
.bf-add {
  min-height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--brand);
}

.bf-add:active { background: var(--cell-active); }

/* ===== 底部固定栏 ===== */
.bf-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--card);
  box-sizing: border-box;
}

/* 顶边细线 */
.bf-footer::before {
  content: ' ';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

/* 汇总：辅助档 24rpx（FG-1） */
.bf-summary {
  flex-shrink: 0;
  max-width: 280rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
}

.bf-footer .weui-btn {
  flex: 1;
  max-width: none;
  margin: 0;
  padding: 20rpx 32rpx;
}


