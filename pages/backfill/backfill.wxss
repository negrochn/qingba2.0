/* 补录页（一次补一天的多条）
   weui-cells / weui-cell 等基础样式见全局 app.wxss。

   字号只用 WeUI 标准 UI 三档（34 / 28 / 24rpx），不使用已废弃的 22 / 26 / 30 / 32 / 36rpx。 */

page {
  background: var(--bg);
}

/* 底部固定栏占位：避免内容被遮住 */
.container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx);
}

/* ===== 记录行 ===== */
/* 自绘分组块，外观对齐 .weui-cells：白底 + 上下 1px 通栏线（细线统一方案） */
.bf-rows {
  position: relative;
  background: var(--card);
}

.bf-rows::before,
.bf-rows::after {
  content: ' ';
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  pointer-events: none;
}

.bf-rows::before { top: 0; transform-origin: top; }
.bf-rows::after { bottom: 0; transform-origin: bottom; }

.bf-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding-left: 32rpx;
  box-sizing: border-box;
}

/* 行间缩进细线（缩进 32rpx 与 .weui-cell 一致，首行不画） */
.bf-row::before {
  content: ' ';
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

.bf-row:first-child::before { display: none; }

.bf-res {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

.bf-res-name {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bf-res-name.placeholder { color: var(--text3); }

/* 分组标签：辅助档 24rpx（FG-2） */
.bf-res-group {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  margin-top: 2rpx;
}

.bf-dur {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-right: 8rpx;
}

/* 输入框高度 88rpx：满足可点项最小热区 */
.bf-dur-input {
  width: 120rpx;
  height: 88rpx;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.bf-dur-ph { color: var(--text3); }

/* 单位：辅助档 24rpx（FG-2） */
.bf-dur-unit {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
}

/* 删除：热区 88rpx 宽、与行等高（满足 7~9mm 最小点击区） */
.bf-del {
  flex-shrink: 0;
  width: 88rpx;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
}

.bf-del:active { background: var(--cell-active); }

/* 「＋ 添加一条」：主文档 34rpx，内距对齐 .weui-cell 的 32rpx */
.bf-add {
  padding: 32rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--brand);
}

.bf-add:active { background: var(--cell-active); }

/* ===== 底部固定栏 ===== */
.bf-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--card);
  box-sizing: border-box;
}

/* 顶边细线 */
.bf-footer::before {
  content: ' ';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: top;
}

/* 汇总：辅助档 24rpx（FG-1） */
.bf-summary {
  flex-shrink: 0;
  max-width: 280rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
}

.bf-footer .weui-btn {
  flex: 1;
  max-width: none;
  margin: 0;
  padding: 20rpx 32rpx;
}


