<view class="container {{fontClass}} {{darkClass}}">
  <!-- 整页只留一块 cells：日期 / 阶段 / 资源 / 时长 / 快捷时长 / 备注。
       去掉两个分组标题与两条 tips —— 标题每组约 78rpx 且各带一组通栏线，
       而这些信息靠行首标签已能区分；行间线由 .weui-cell::before 自动画，
       少一层分组也就少一次视线跳转 -->
  <view class="weui-cells">
    <picker mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDateChange">
      <view class="weui-cell weui-cell_access cell-first">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">日期</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{dateText}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">阶段</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value {{selectedStageId ? '' : 'placeholder'}}">{{selectedStageName || '请选择'}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <!-- 分组 + 资源：两列联动（左列分组、右列该分组的资源） -->
    <picker
      mode="multiSelector"
      range="{{multiRange}}"
      value="{{multiValue}}"
      disabled="{{groups.length === 0}}"
      bindcolumnchange="onColumnChange"
      bindchange="onMultiConfirm"
    >
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text">资源</view>
          <view class="weui-cell__desc" wx:if="{{selectedGroupLabel}}">{{selectedGroupLabel}}</view>
        </view>
        <view class="weui-cell__ft">
          <!-- 未选阶段时 picker 是 disabled，右侧文案接过原 tips 的引导职责 -->
          <text class="weui-cell__ft_value {{selectedResourceName ? '' : 'placeholder'}}">{{selectedResourceName || (groups.length ? '请选择' : '请先选阶段')}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <!-- 时长 / 备注：与上面同属一块 cells，
         行间线由 .weui-cell::before 自动画，不再需要 weui-divider 分节 -->
    <view class="weui-cell">
      <view class="weui-cell__bd">
        <text class="weui-cell__bd_text">时长</text>
      </view>
      <view class="weui-cell__ft cell-ft-flex">
        <input
          class="cell-input"
          type="number"
          placeholder="请输入"
          placeholder-class="cell-input-ph"
          value="{{durationInput}}"
          bindinput="onDurationInput"
        />
        <text class="cell-unit">分钟</text>
      </view>
    </view>

    <!-- 备注与时长同构：行首标签 + 右对齐输入，用 placeholder 说明「选填」 -->
    <view class="weui-cell">
      <view class="weui-cell__bd">
        <text class="weui-cell__bd_text">备注</text>
      </view>
      <view class="weui-cell__ft cell-ft-flex">
        <input
          class="cell-input"
          placeholder="选填，如：第1-2册"
          placeholder-class="cell-input-ph"
          value="{{remarkInput}}"
          bindinput="onRemarkInput"
          maxlength="50"
        />
      </view>
    </view>
  </view>

  <!-- 熏听折算说明：选中熏听分组的资源时出现 -->
  <view class="weui-cells__tips" wx:if="{{listeningTip}}">{{listeningTip}}</view>

  <view class="weui-btn-area">
    <button
      class="weui-btn weui-btn_block {{canSubmit ? 'weui-btn_primary' : 'weui-btn_disabled'}}"
      bindtap="submit"
    >保存修改</button>
  </view>

</view>
