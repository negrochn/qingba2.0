<view class="container {{fontClass}} {{darkClass}}">
  <!-- 打卡信息：日期 / 阶段 / 资源三项同类信息合并为一组 ——
       分三组时各要一个分组标题（约 78rpx）和一组上下边线，纯属浪费 -->
  <view class="weui-cells__title">打卡信息</view>
  <view class="weui-cells">
    <picker mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDateChange">
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">日期</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{dateText}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <text class="weui-cell__bd_text">阶段</text>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value {{selectedStageId ? '' : 'placeholder'}}">{{selectedStageName || '请选择'}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>

    <!-- 分组 + 资源：两列联动（左列分组、右列该分组的资源） -->
    <picker
      mode="multiSelector"
      range="{{multiRange}}"
      value="{{multiValue}}"
      disabled="{{groups.length === 0}}"
      bindcolumnchange="onColumnChange"
      bindchange="onMultiConfirm"
    >
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text">资源</view>
          <view class="weui-cell__desc" wx:if="{{selectedGroupLabel}}">{{selectedGroupLabel}}</view>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value {{selectedResourceName ? '' : 'placeholder'}}">{{selectedResourceName || '请选择'}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
  </view>
  <!-- 两条提示互斥：未选阶段时更需要「先选阶段」的引导 -->
  <view class="weui-cells__tips" wx:if="{{groups.length === 0}}">选择阶段后可挑选分组与资源。</view>
  <view class="weui-cells__tips" wx:else>修改后会计入阶段时长与统计。</view>

  <!-- 学习记录：时长 / 快捷时长 / 备注
       合并进同一张卡片，用分隔线分节 —— 省一个分组标题与一份卡片间距 -->
  <view class="weui-cells__title">学习记录</view>
  <view class="form-card">
    <view class="form-row">
      <view class="form-label">时长</view>
      <view class="form-right">
        <input
          class="form-field"
          type="number"
          placeholder="请输入"
          value="{{durationInput}}"
          bindinput="onDurationInput"
        />
        <text class="form-unit">分钟</text>
      </view>
    </view>
    <view class="weui-divider"></view>
    <view class="form-row">
      <view class="seg-control seg-control-grid">
        <view class="seg-item {{durationInput==='10' ? 'seg-active' : ''}}" data-val="10" bindtap="quickDuration">10</view>
        <view class="seg-item {{durationInput==='15' ? 'seg-active' : ''}}" data-val="15" bindtap="quickDuration">15</view>
        <view class="seg-item {{durationInput==='20' ? 'seg-active' : ''}}" data-val="20" bindtap="quickDuration">20</view>
        <view class="seg-item {{durationInput==='25' ? 'seg-active' : ''}}" data-val="25" bindtap="quickDuration">25</view>
        <view class="seg-item {{durationInput==='30' ? 'seg-active' : ''}}" data-val="30" bindtap="quickDuration">30</view>
      </view>
    </view>
    <view class="weui-divider"></view>
    <!-- 备注不单独占标签位：满宽输入，用 placeholder 说明，长备注也能看全 -->
    <view class="form-row">
      <input
        class="form-field form-field-full"
        placeholder="备注，选填，如：第1-2册"
        value="{{remarkInput}}"
        bindinput="onRemarkInput"
        maxlength="50"
      />
    </view>
  </view>

  <view class="weui-btn-area">
    <button
      class="weui-btn weui-btn_block {{canSubmit ? 'weui-btn_primary' : 'weui-btn_disabled'}}"
      bindtap="submit"
    >保存修改</button>
  </view>

</view>
