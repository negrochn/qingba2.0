/* 编辑记录页：原生 picker（阶段 selector / 分组+资源 multiSelector 两列联动）
   + 表单（原语 13/15）+ 分段控件（原语 14）
   weui-cells / weui-cell 等基础样式见全局 app.wxss */

page {
  background: var(--bg);
}

/* 注：原先的 .bf-custom（自定义资源尾标）已删除 ——
   改两列 picker 后资源名只能渲染纯文本，「自定义」标记改为拼在名字里（见 editRecord.js 的 _itemLabel） */

/* 按钮区上边距收窄：全局 .weui-btn-area 是 96rpx（原语给卡片堆叠留的呼吸位），
   本页上方只有一张卡片，96rpx 会显得空。页面样式加载在 app.wxss 之后，同特异性即覆盖 */
.weui-btn-area { padding-top: 32rpx; }

/* ===== 表单卡片（打卡弹窗同款） ===== */
.form-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.form-row:active { background: var(--cell-active); }
.form-label {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  width: 140rpx;
}
.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.form-field {
  flex: 1;
  text-align: right;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  height: 64rpx;
}
.form-field-full { text-align: left; }
.form-unit {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  margin-left: 8rpx;
}
.form-card .weui-divider { height: 1px; background: var(--divider); margin: 0; }

/* 快捷时长分段控件（等宽 variant） */
.seg-control { display: flex; align-items: center; flex: 1; }
.seg-control-grid .seg-item { flex: 1; text-align: center; }
.seg-item {
  height: 56rpx;
  padding: 0 32rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--divider);
  border-radius: 8rpx;
  background: var(--card);
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  box-sizing: border-box;
}
.seg-item:first-child { margin-left: 0; }
.seg-item:active { background: var(--cell-active); }
.seg-active { border-color: var(--brand); color: var(--brand); background: var(--card); }
