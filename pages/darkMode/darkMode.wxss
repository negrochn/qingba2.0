/* 深色模式选择页 - 跟随系统 toggle + 手动选择（原语：picker-page 单选） */
/* 页面背景由 app.wxss 的 .container 提供（避免 page 上 var(--bg) 永远取默认值） */

/* 自定义 iOS 胶囊开关（深浅模式样式一致；项目原语，见 skill ui-design-spec） */
.switch {
  position: relative;
  flex-shrink: 0;
  width: 100rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #e9e9e9;
  transition: background-color 0.2s ease;
}
.switch-on {
  background: #07c160;
}
.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  transition: left 0.2s ease;
}
.switch-on .switch-knob {
  left: 48rpx;
}
