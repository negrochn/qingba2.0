/* 深色模式选择页 - 微信风格：跟随系统 toggle + 手动选择（原语 3 picker-page 单选） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组（原语 1 .group） ===== */
.group {
  margin-bottom: 24rpx;
}

.group-title {
  padding: 16rpx 32rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
}

.group-card {
  background: var(--card);
  margin: 0; /* 全宽平铺 */
  border-radius: 0;
  overflow: hidden;
}

/* ===== 自定义 toggle（iOS 胶囊开关，深浅模式样式一致） ===== */
.switch {
  position: relative;
  flex-shrink: 0;
  width: 100rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #e9e9e9;
  transition: background-color 0.2s ease;
}

.switch-on {
  background: #07c160;
}

.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  transition: left 0.2s ease;
}

.switch-on .switch-knob {
  left: 48rpx;
}

