<view class="container {{fontClass}} {{darkClass}}">

  <!-- ① 欢迎条：英文日期 + 欢迎语（左），孩子切换器（右，仅多孩显示） -->
  <view class="home-header">
    <view class="home-greet">
      <view class="home-date">{{dateText}}</view>
      <view class="home-greet-sub">{{greetText}}<text wx:if="{{dayNumber > 0}}" class="home-greet-day">Day {{dayNumber}}</text></view>
    </view>
    <!-- 孩子切换器：仅多孩时显示，纯头像（点按弹切换弹层，名字/对勾在弹层内核对）；阶段进度已并入下方统计卡 -->
    <view class="home-child-av" wx:if="{{isMultiChild}}" bindtap="openChildSheet" hover-class="home-child-av-hover">
      <view class="cp-av cp-av--{{activeChildColor}}">{{activeChildInitial}}</view>
    </view>
  </view>

  <!-- 欢迎卡：未设置当前阶段时显示，替代全 0 的统计模块（WeUI msg 范式：无图标、单主操作） -->
  <view class="home-welcome" wx:if="{{!hasStage}}">
    <view class="home-welcome__text-area">
      <view class="home-welcome__title">欢迎使用庆爸2.0</view>
      <view class="home-welcome__desc">{{journeyText}}</view>
    </view>
    <view class="home-welcome__cells weui-cells">
      <view class="weui-cell weui-cell_access" bindtap="goRoutePicker">
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text">当前路线</view>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{routeName}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
      <view class="weui-cell weui-cell_access" bindtap="goStagePicker">
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text">当前阶段</view>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value home-welcome__stage-hint">未设置</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </view>
    <view class="home-welcome__tips">所有阶段均已开放，时间投入到位即可进入下一阶段；路线与阶段均可随时调整</view>
  </view>

  <!-- 毕业卡：主链终点已完成时替代统计区（纯庆祝，无操作入口）。
       成果数字为全程口径（天陪伴 / 小时累计 / 天打卡），进行态的统计卡片不渲染 -->
  <view class="home-grad" wx:elif="{{graduated}}">
    <view class="home-grad__badge-wrap">
      <view class="home-grad__dot home-grad__dot--1"></view>
      <view class="home-grad__dot home-grad__dot--2"></view>
      <view class="home-grad__dot home-grad__dot--3"></view>
      <view class="home-grad__dot home-grad__dot--4"></view>
      <view class="home-grad__dot home-grad__dot--5"></view>
      <view class="home-grad__dot home-grad__dot--6"></view>
      <view class="home-grad__dot home-grad__dot--7"></view>
      <view class="home-grad__dot home-grad__dot--8"></view>
      <view class="home-grad__badge">
        <text class="iconfont icon-check home-grad__check"></text>
      </view>
    </view>
    <view class="home-grad__title">{{gradTitle}}</view>
    <view class="home-grad__subtitle">{{gradSubtitle}}</view>
    <view class="home-grad__stats">
      <view class="home-grad__stat">
        <view class="home-grad__num">{{companionDays}}</view>
        <view class="home-grad__unit">天陪伴</view>
      </view>
      <view class="home-grad__stat">
        <view class="home-grad__num">{{allHours}}</view>
        <view class="home-grad__unit">小时累计</view>
      </view>
      <view class="home-grad__stat">
        <view class="home-grad__num">{{allDays}}</view>
        <view class="home-grad__unit">天打卡</view>
      </view>
    </view>
    <view class="home-grad__tips">剩下的路，交给他自己</view>
  </view>

  <block wx:else>
  <!-- ② Hero 卡：本周时长 + 周一~周日柱状图（头部右侧承接原 header 的阶段进度） -->
  <view class="home-hero">
    <view class="home-hero-head">
      <view class="home-hero-title">本周时长</view>
      <view class="home-hero-stage" wx:if="{{stageName}}">{{stageName}}<text wx:if="{{!stageNoTarget}}"> · {{stagePercent}}%</text></view>
    </view>
    <view class="home-hero-num">
      <text class="home-hero-val">{{weekHours}}</text>
      <text class="home-hero-unit">h</text>
      <text class="home-hero-delta">{{weekDeltaText}}</text>
    </view>
    <view class="home-hero-bars">
      <view class="home-bar" wx:for="{{weekBars}}" wx:key="day">
        <view class="home-bar-track">
          <view class="home-bar-fill {{item.isToday ? 'is-today' : ''}}" style="height: {{item.percent}}%"></view>
        </view>
        <text class="home-bar-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ③ 2×2 关键指标（阶段时长、今日打卡、打卡天数均为当前阶段口径） -->
  <view class="home-grid">
    <view class="home-stat" data-mode="minutes" bindtap="openTodaySheet">
      <text class="home-stat-arrow iconfont icon-right"></text>
      <view class="home-stat-num">{{todayHours}}<text class="home-stat-unit">h</text></view>
      <view class="home-stat-label">今日时长</view>
    </view>
    <view class="home-stat" data-mode="count" bindtap="openTodaySheet">
      <text class="home-stat-arrow iconfont icon-right"></text>
      <view class="home-stat-num">{{todayCount}}<text class="home-stat-unit">次</text></view>
      <view class="home-stat-label">今日打卡</view>
    </view>
    <view class="home-stat">
      <text class="home-stat-arrow iconfont icon-right"></text>
      <view class="home-stat-num">{{totalHours}}<text class="home-stat-unit">h</text></view>
      <view class="home-stat-label">阶段时长</view>
    </view>
    <view class="home-stat">
      <text class="home-stat-arrow iconfont icon-right"></text>
      <view class="home-stat-num">{{streakDays}}<text class="home-stat-unit">天</text></view>
      <view class="home-stat-label">连续打卡</view>
    </view>
  </view>
  </block>

</view>

<!-- 今日明细弹窗：今日时长 / 今日打卡 共用一套面板，随入口切换度量
     无底部操作区，故不传 footer -->
<half-sheet
  show="{{sheetVisible}}"
  title="{{sheetTitle}}"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  bind:close="closeSheet"
>
  <view class="hs-summary" wx:if="{{sheetItems.length > 0}}">
    <text class="hs-summary-main">{{sheetSummaryMain}}</text>
    <text class="hs-summary-sub">{{sheetSummarySub}}</text>
  </view>

  <scroll-view class="hs-list" scroll-y wx:if="{{sheetItems.length > 0}}">
    <view class="hs-rank-row" wx:for="{{sheetItems}}" wx:key="key">
      <view class="hs-rank-fill" style="width: {{item.percent}}%;"></view>
      <view class="hs-rank-cover">{{item.char}}</view>
      <view class="hs-rank-name">{{item.name}}</view>
      <text class="hs-rank-dur">{{item.valueText}}</text>
    </view>
  </scroll-view>

  <view class="hs-empty" wx:else>今天还没有打卡记录</view>
</half-sheet>

<!-- 切换孩子弹层（纯切换）：切换后 onShow 重读 per-child 键即为新孩子视图 -->
<child-picker
  show="{{childSheetVisible}}"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  bind:close="closeChildSheet"
  bind:changed="onChildChanged"
/>
