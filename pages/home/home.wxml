<view class="container">

  <!-- Hero：累计学习时长 -->
  <view class="hero-card">
    <view class="hero-top">
      <text class="hero-label">累计学习时长</text>
      <view class="hero-arrow">›</view>
    </view>
    <view class="hero-bottom">
      <view class="hero-num-wrap">
        <text class="hero-num">{{heroHours}}</text>
        <text class="hero-dot">.</text>
        <text class="hero-num hero-num-decimal">{{heroDecimal}}</text>
        <text class="hero-unit">h</text>
      </view>
      <view class="hero-illus">
        <view class="illus-circle"></view>
        <view class="illus-book">📖</view>
        <view class="illus-star">✦</view>
      </view>
    </view>
  </view>

  <!-- 三栏统计 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-num">{{totalCount}}</view>
      <view class="stat-label">累计次数</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{totalDays}}</view>
      <view class="stat-label">累计天数</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{totalHoursText}}</view>
      <view class="stat-label">总时长(h)</view>
    </view>
  </view>

  <!-- 月份汇总 -->
  <view class="month-header">
    <view class="month-left">
      <view class="month-picker" bindtap="onToggleMonthPicker">
        <text class="month-text">{{monthDisplay}}</text>
        <text class="month-arrow {{monthPickerOpen ? 'up' : ''}}">▾</text>
      </view>
      <view class="year-text">{{yearText}}</view>
    </view>
    <view class="month-right">
      <view class="month-total-num">
        <text>{{monthTotalHours}}</text>
        <text class="month-total-unit">h</text>
      </view>
      <view class="month-total-sub">累计{{monthCount}}次，共{{monthDays}}天</view>
    </view>
  </view>

  <!-- 记录列表（扁平，无分组） -->
  <view class="record-list" wx:if="{{records.length > 0}}">
    <block wx:for="{{records}}" wx:key="id" wx:for-item="r" wx:for-index="idx">
      <view
        class="swipe-wrap"
        data-idx="{{idx}}"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
      >
        <view class="swipe-bg">
          <view
            class="swipe-del"
            catchtap="deleteRecord"
            data-id="{{r.id}}"
          >删除</view>
        </view>
        <view
          class="swipe-fg record-row"
          style="transform: translateX({{r._dx}}rpx); transition: {{r._anim ? 'transform 0.25s ease' : 'none'}};"
        >
          <view class="record-avatar">{{r.firstChar}}</view>
          <view class="record-main">
            <view class="record-line1">
              <view class="record-title">
                <text class="record-res-name">{{r.resourceName}}</text>
              </view>
              <text class="record-date">{{r.dateText}}</text>
            </view>
            <view class="record-line2">
              <view class="record-tags">
                <text class="tag-stage">{{r.stageName}}</text>
                <text class="tag-group tag-group-{{r.groupKey}}">{{r.groupLabel}}</text>
                <text class="record-remark" wx:if="{{r.remark}}">{{r.remark}}</text>
              </view>
              <text class="record-duration">{{r.durationText}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-wrap" wx:else>
    <view class="empty-icon">📖</view>
    <view class="empty-text">本月暂无打卡记录</view>
    <view class="empty-hint">在「路线」中点击资源即可开始打卡</view>
  </view>

</view>

<!-- 简易月份选择器弹层 -->
<view class="mp-mask {{monthPickerOpen ? 'show' : ''}}" bindtap="onCloseMonthPicker" wx:if="{{monthPickerOpen}}">
  <view class="mp-sheet" catchtap="">
    <view class="mp-title">选择月份</view>
    <picker-view indicator-style="height: 80rpx;" class="mp-pv" value="{{pickerValue}}" bindchange="onPickerChange">
      <picker-view-column>
        <view wx:for="{{yearRange}}" wx:key="*this" class="mp-item">{{item}}年</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{monthRange}}" wx:key="*this" class="mp-item">{{item}}月</view>
      </picker-view-column>
    </picker-view>
    <view class="mp-actions">
      <button class="mp-btn mp-cancel" bindtap="onCloseMonthPicker">取消</button>
      <button class="mp-btn mp-ok" bindtap="onConfirmMonthPicker">确定</button>
    </view>
  </view>
</view>
