<view class="container {{fontClass}} {{darkClass}}">

  <!-- 阶段 Hero 卡 -->
  <view class="hero-card">
    <view class="hero-name-row">
      <text class="hero-name">{{stageName || '未设置阶段'}}</text>
      <text class="hero-badge" wx:if="{{stageCompleted}}">✓ 已达成目标</text>
      <text class="hero-badge" wx:elif="{{stageDone}}">✓ 已达标</text>
      <text class="hero-tag" wx:elif="{{stageName}}">当前阶段</text>
    </view>
    <view class="hero-desc" wx:if="{{stageDesc}}">{{stageDesc}}</view>
    <block wx:if="{{hasTarget}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{stagePercent}}%"></view>
      </view>
      <view class="progress-meta">
        <text>{{stageHoursText}}h / {{targetHoursText}}</text>
        <text>{{stagePercent}}%</text>
      </view>
    </block>
    <view class="hero-hint" wx:if="{{!stageName}}">在「路线」页设置当前阶段后开始打卡</view>
  </view>

  <!-- 今日状态条 -->
  <view class="today-card">
    <view class="today-left">
      <text class="today-label">今日</text>
      <text class="today-num" wx:if="{{todayCount > 0}}">{{todayMinutesText}} · {{todayCount}}次打卡</text>
      <text class="today-num today-empty" wx:else>今天还没打卡</text>
    </view>
    <view class="today-btn" bindtap="goRoute">去打卡</view>
  </view>

  <!-- 阶段统计 2×2（纯阶段口径） -->
  <view class="section-head">
    <text class="section-title">阶段统计</text>
    <text class="section-count">{{stageName}}</text>
  </view>
  <view class="summary-card">
    <view class="sum-grid">
      <view class="sg-cell sg-tl">
        <view class="sg-label">阶段累计</view>
        <view class="sg-num">
          <text class="sg-val">{{stageTotalHours}}</text>
          <text class="sg-unit">h</text>
        </view>
      </view>
      <view class="sg-cell sg-tr">
        <view class="sg-label">已读完</view>
        <view class="sg-num">
          <text class="sg-val">{{stageReadCount}}</text>
          <text class="sg-unit">次</text>
        </view>
      </view>
      <view class="sg-cell sg-bl">
        <view class="sg-label">本周</view>
        <view class="sg-num">
          <text class="sg-val">{{stageWeekHours}}</text>
          <text class="sg-unit">h</text>
        </view>
      </view>
      <view class="sg-cell sg-br">
        <view class="sg-label">打卡天数</view>
        <view class="sg-num">
          <text class="sg-val">{{stageDaysCount}}</text>
          <text class="sg-unit">天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分组时长分布 -->
  <block wx:if="{{hasGroupData}}">
    <view class="section-head group-head">
      <text class="section-title">分组时长分布</text>
      <text class="section-count">累计占比</text>
    </view>
    <view class="group-card">
      <view class="group-row" wx:for="{{groupBars}}" wx:key="key" wx:for-item="g">
        <text class="group-label">{{g.label}}</text>
        <view class="group-track">
          <view class="group-fill" style="width: {{g.percent}}%"></view>
        </view>
        <text class="group-minutes">{{g.minutesText}}</text>
      </view>
    </view>
  </block>

  <!-- 今日打卡明细 -->
  <block wx:if="{{todayRecords.length > 0}}">
    <view class="section-head group-head">
      <text class="section-title">今日打卡</text>
      <text class="section-count">共 {{todayRecords.length}} 条</text>
    </view>
    <view class="record-list">
      <block wx:for="{{todayRecords}}" wx:key="id" wx:for-item="r" wx:for-index="idx">
        <view
          class="swipe-wrap"
          data-idx="{{idx}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
        >
          <view class="swipe-bg">
            <view
              class="swipe-del"
              catchtap="deleteRecord"
              data-id="{{r.id}}"
            >删除</view>
          </view>
          <view
            class="swipe-fg record-row"
            style="transform: translateX({{r._dx}}rpx); transition: {{r._anim ? 'transform 0.25s ease' : 'none'}};"
          >
            <view class="record-avatar">{{r.firstChar}}</view>
            <view class="record-main">
              <view class="record-line1">
                <text class="record-res-name">{{r.resourceName}}</text>
                <text class="record-duration">{{r.durationText}}</text>
              </view>
              <view class="record-line2">
                <view class="record-tags">
                  <text class="tag-group tag-group-{{r.groupKey}}">{{r.groupLabel}}</text>
                  <text class="record-remark" wx:if="{{r.remark}}">{{r.remark}}</text>
                </view>
                <text class="record-date">{{r.timeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>

</view>

<!-- 首次启动引导（全屏遮罩，覆盖 tabBar） -->
<view class="ob-overlay {{fontClass}} {{darkClass}}" wx:if="{{showOnboard}}" catchtouchmove="noop">
  <view class="ob-content">
    <view class="ob-logo">📚</view>
    <view class="ob-title">庆爸 2.0</view>
    <view class="ob-desc">孩子英语听力训练打卡工具<br/>常规1-6 → 准桥梁，逐级解锁</view>

    <view class="ob-form">
      <picker class="ob-picker" mode="selector" range="{{stageOptions}}" range-key="name" value="{{onboardStageIndex}}" bindchange="onStageChange">
        <view class="ob-form-row">
          <text class="ob-form-label">当前阶段</text>
          <text class="ob-form-value">{{stageOptions[onboardStageIndex].name}}</text>
        </view>
      </picker>

      <view class="ob-hint">所选阶段之前的所有阶段将标记为已完成</view>
    </view>

    <button class="ob-btn" bindtap="confirmOnboard">开始使用</button>
  </view>
</view>
