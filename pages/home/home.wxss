/* ===== 首页样式（WeUI 令牌化） ===== */

/* ① 欢迎条：左问候 / 右日期 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
}
.home-greet-hi {
  font-size: calc(40rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}
.home-greet-sub {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
  margin-top: 4rpx;
}
.home-date {
  flex-shrink: 0;
  margin-top: 10rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
  text-align: right;
}

/* ② Hero 卡：品牌绿渐变 + 7 日柱状图 */
.home-hero {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 白底卡片 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  color: var(--text);                  /* 黑字 */
}
.home-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-hero-title {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}
.home-hero-scope {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
}
.home-hero-num {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 8rpx;
}
.home-hero-val {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 600;
  line-height: 1.1;
  color: var(--text);
}
.home-hero-unit {
  font-size: calc(30rpx * var(--fs, 1));
  margin-left: 8rpx;
  color: var(--text2);
}
.home-hero-delta {
  font-size: calc(24rpx * var(--fs, 1));
  margin-left: 16rpx;
  color: var(--text3);
}
.home-hero-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 24rpx;
  height: 176rpx;
}
.home-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-bar-track {
  width: 16rpx;
  height: 128rpx;
  background: rgba(0, 0, 0, 0.05);          /* 浅灰轨道 */
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.home-bar-fill {
  width: 100%;
  background: rgba(7, 193, 96, 0.28);        /* 非今日：浅品牌绿 */
  border-radius: 8rpx;
}
.home-bar-fill.is-today {
  background: #07C160;                       /* 今日：品牌绿高亮 */
}
.home-bar-label {
  font-size: calc(20rpx * var(--fs, 1));
  margin-top: 10rpx;
  opacity: 0.8;
}
.home-bar-label.is-today {
  opacity: 1;
  font-weight: 600;
}

/* ③ 2×2 指标卡 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx;
}
.home-stat {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.home-stat-arrow {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text4);
  line-height: 1;
}
.home-stat-num {
  font-size: calc(56rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  line-height: 1.1;
  margin: 8rpx 0 12rpx;
}
.home-stat-unit {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  margin-left: 4rpx;
}
.home-stat-label {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}
