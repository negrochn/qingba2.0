/* 首页：方案A - 单卡式汇总 + 紧凑列表 */

page {
  background: #f5f6f8;
}

.container {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 概览区 + 记录区（统一头部在外结构） ===== */
.overview-section {
  margin-bottom: 24rpx;
}

/* 卡片：头部移出后，内部仅保留2×2指标 */
.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 24rpx;
  /* padding: 20rpx 12rpx; */
  box-shadow: 0 6rpx 24rpx rgba(60, 90, 140, 0.06);
}

/* 两个区块共用的 section-head（左右两端对齐） */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 打卡概览：头部右侧 — 年份 + 月份选择器 */
.overview-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.overview-year {
  font-size: 24rpx;
  color: #999;
}

.overview-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f2f5fa;
  border-radius: 24rpx;
}

.overview-month {
  font-size: 26rpx;
  color: #4a5568;
  font-weight: 500;
}

.overview-arrow {
  font-size: 20rpx;
  color: #888;
  transition: transform 0.2s;
}

.overview-arrow.up {
  transform: rotate(180deg);
}

/* 4 指标 2×2 紧凑网格（副文字行删除 → 更紧凑） */
.sum-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  background: #fff;
  border-radius: 20rpx;
  /* padding: 14rpx 0; */
  row-gap: 10rpx;
}

.sg-cell {
  position: relative;
  text-align: center;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
}

.sg-cell.clickable {
  cursor: pointer;
  transition: opacity 0.2s;
}

.sg-cell.clickable:active {
  opacity: 0.7;
}

/* 右列加左分隔线 */
.sg-tr::before,
.sg-br::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18%;
  bottom: 18%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent 0%, #e5e9f0 30%, #e5e9f0 70%, transparent 100%);
}

/* 第二行（bl br）加顶部分隔线 */
.sg-bl::after,
.sg-br::after {
  content: '';
  position: absolute;
  top: 0;
  left: 14%;
  right: 14%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #e5e9f0 30%, #e5e9f0 70%, transparent 100%);
}

/* 左下角、右下角：淡蓝→淡粉渐变底，突出阶段维度 */
.sg-bl,
.sg-br {
  background: linear-gradient(135deg, rgba(106, 176, 243, 0.05) 0%, rgba(252, 190, 227, 0.06) 100%);
}

.sg-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.sg-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.sg-val {
  font-size: 52rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.05;
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}

.sg-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a8f99;
}

.sg-read {
  background: linear-gradient(135deg, #4a90d9 0%, #c13a8d 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ===== 记录区 ===== */
.record-section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.record-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 滑动删除 */
.swipe-wrap {
  position: relative;
  overflow: hidden;
}

.swipe-wrap:not(:last-child) .record-row::after {
  content: '';
  position: absolute;
  left: 80rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f2f5;
}

.record-row {
  position: relative;
}

.swipe-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 150rpx;
  display: flex;
  align-items: stretch;
}

.swipe-del {
  width: 100%;
  height: 100%;
  background: #ff4d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.swipe-fg {
  position: relative;
  background: #fff;
  z-index: 1;
}

/* 单行记录 */
.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 16rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

/* 首字小图标 */
.record-avatar {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #5a9af0 0%, #7fb4f7 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 第一行 */
.record-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-res-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.record-date {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #aaa;
}

/* 第二行 */
.record-line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.tag-stage {
  font-size: 20rpx;
  color: #7a5200;
  background: #fff7e6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-group {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 各分类标签颜色 */
.tag-group-main_picture_books { color: #1a5fb0; background: #e8f1fb; }
.tag-group-main_graded_readers { color: #4a26a8; background: #f0eafc; }
.tag-group-main_animations { color: #c4390e; background: #fff1ea; }
.tag-group-sub_graded_readers { color: #006d75; background: #e6fffb; }
.tag-group-sub_animations { color: #b0156e; background: #fff0f6; }
.tag-group-fun_extensions { color: #389e0d; background: #f0ffe0; }
.tag-group-science_extensions { color: #ad6800; background: #fffbe6; }
.tag-group-fusion_apps { color: #531dab; background: #f5f0ff; }
.tag-group-default { color: #888; background: #f5f5f5; }

.record-remark {
  font-size: 20rpx;
  color: #52c41a;
  background: #f0fff0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-duration {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #2a3a50;
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
  line-height: 1;
  align-self: flex-end;
  padding-bottom: 2rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #aaa;
}

/* ===== 月份选择器弹层 ===== */
.mp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 2000;
  pointer-events: none;
  transition: background 0.2s;
  display: flex;
  align-items: flex-end;
}

.mp-mask.show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.mp-sheet {
  width: 100%;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.mp-title {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.mp-pv {
  width: 100%;
  height: 400rpx;
}

.mp-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

.mp-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.mp-btn {
  width: 45%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  padding: 0;
  line-height: 1;
}

.mp-btn::after {
  border: none;
}

.mp-cancel {
  background: #f2f4f7;
  color: #556;
}

.mp-ok {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  color: #fff;
  font-weight: 600;
}
