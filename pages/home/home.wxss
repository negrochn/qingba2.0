/* ===== 首页样式（WeUI 令牌化） ===== */

/* ① 欢迎条：左「英文日期 + 欢迎语」/ 右「当前阶段」 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
}
.home-greet {
  flex: 1;
  min-width: 0;
}
.home-date {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  font-weight: 400;
  color: var(--text2);
  line-height: 1.4;
}
.home-greet-sub {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  margin-top: 4rpx;
}
.home-greet-day {
  color: var(--brand);              /* 品牌绿：弱化区里靠颜色而非字号突出 */
}
.home-stage {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding-top: 4rpx;
  text-align: right;
}
.home-stage-name {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级，右侧值 */
  color: var(--text2);
  line-height: 1.4;
}
.home-stage-percent {
  margin-top: 4rpx;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
  line-height: 1.4;
}

/* 欢迎卡：WeUI msg 范式（结果/引导页），无图标、单主操作 */
.home-welcome {
  margin: 16rpx 32rpx 24rpx;
  padding: 64rpx 32rpx 48rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景，与 Hero 同参数 */
  text-align: center;
}
.home-welcome__text-area {
  padding: 0 32rpx;
  margin-bottom: 64rpx;
}
.home-welcome__title {
  margin-bottom: 24rpx;
  font-size: calc(44rpx * var(--fs, 1));   /* weui-msg__title 22px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
}
.home-welcome__desc {
  font-size: calc(30rpx * var(--fs, 1));   /* 空状态说明专用档 */
  line-height: 1.6;
  color: var(--text2);
}
.home-welcome__opr-area {
  margin-bottom: 48rpx;                    /* 卡片内收窄，不用 .weui-btn-area 的 96rpx */
}
.home-welcome__tips {
  font-size: calc(28rpx * var(--fs, 1));   /* weui-msg__tips 14px */
  line-height: 1.4;
  color: var(--text3);
}

/* ② Hero 卡：白底卡片 + 7 日柱状图（扁平纯色，无阴影） */
.home-hero {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景 */
  color: var(--text);                  /* 主文字 */
}
.home-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-hero-title {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
}

.home-hero-num {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 8rpx;
}
.home-hero-val {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.1;
  color: var(--text);
}
.home-hero-unit {
  font-size: calc(30rpx * var(--fs, 1));
  margin-left: 8rpx;
  color: var(--text2);
}
.home-hero-delta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  margin-left: 16rpx;
  color: var(--text2);
}
.home-hero-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 24rpx;
  height: auto;                     /* 由 track(192rpx) + 标签自然撑开 */
}
.home-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-bar-track {
  width: 64rpx;
  height: 192rpx;
  background: transparent;                   /* 透明轨道，数据完全由 fill 体现 */
  border-radius: 28rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.home-bar-fill {
  width: 100%;
  background: rgba(7, 193, 96, .14);         /* 统一低透明品牌绿（今日/非今日一致） */
  border-radius: 28rpx;
}
.home-bar-label {
  font-size: calc(24rpx * var(--fs, 1));
  margin-top: 10rpx;
  opacity: 0.8;
}
.home-bar-label.is-today {
  opacity: 1;
}

/* ③ 2×2 指标卡 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
}
.home-stat {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.home-stat:active { background: var(--cell-active); }
.home-stat-arrow {
  position: absolute;
  top: 44rpx;
  right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
}
.home-stat-num {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  line-height: 1.1;
  margin: 0 0 32rpx;
}
.home-stat-unit {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  margin-left: 4rpx;
}
.home-stat-label {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}

/* ===== 今日明细弹窗（今日时长 / 今日打卡 共用） ===== */
.hs-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.2s ease;
  display: flex;
  align-items: flex-end;
}
.hs-mask-show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}
.hs-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.hs-mask-show .hs-sheet { transform: translateY(0); }

.hs-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 24rpx;
  border-radius: 4rpx;
  background: var(--divider);
}
.hs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.hs-title {
  flex: 1;
  min-width: 0;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
}
.hs-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 53rpx;
  color: var(--text3);
  border-radius: 50%;
}
.hs-close:active { background: var(--cell-active); color: var(--text2); }

/* 汇总：大数字（主）+ 副信息 */
.hs-summary {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.hs-summary-main {
  font-size: calc(56rpx * var(--fs, 1));
  line-height: 1.1;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}
.hs-summary-sub {
  margin-left: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

/* 明细列表（滚动区，滚动自身不挂 catchtouchmove） */
.hs-list { max-height: 56vh; }

/* 排行榜行（对齐统计页「时长排行榜 / 读完排行榜」：底衬进度 + 首字方块 + 右侧数值） */
.hs-rank-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.hs-rank-row:last-child { margin-bottom: 0; }
.hs-rank-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(7, 193, 96, .14);
  z-index: 0;
}
.hs-rank-cover {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--card2);
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30rpx * var(--fs, 1));
}
.hs-rank-name {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hs-rank-dur {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

.hs-empty {
  padding: 72rpx 0 48rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}
