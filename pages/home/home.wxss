.container {
  padding: 24rpx 0 40rpx;
}

/* Section */
.section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

/* 记录列表 */
.record-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 月份选择器 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.month-nav {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #4a90d9;
  border-radius: 50%;
  background: #eef4fb;
  line-height: 1;
}

.month-nav:active {
  background: #dce8f7;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 月度汇总 */
.month-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.ms-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ms-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #4a90d9;
  margin-bottom: 6rpx;
}

.ms-label {
  font-size: 22rpx;
  color: #999;
}

.ms-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 日期分组头 */
.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
  background: #f7f9fc;
  border-top: 1rpx solid #eef1f5;
}

.date-header:first-child {
  border-top: none;
}

.date-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
}

.date-total {
  font-size: 24rpx;
  color: #4a90d9;
  font-weight: 600;
}

/* 本月空状态 */
.no-month {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.no-month-text {
  font-size: 28rpx;
  color: #aaa;
}

/* 滑动删除 */
.swipe-wrap {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #f5f5f5;
}

.swipe-wrap:last-child {
  border-bottom: none;
}

.swipe-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 0;
}

.swipe-del {
  width: 150rpx;
  height: 100%;
  background: #e74c3c;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-fg {
  position: relative;
  background: #fff;
  z-index: 2;
  will-change: transform;
}

.swipe-fg.swipe-open {
  /* 保持打开视觉提示 */
}

/* 记录项 */
.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #fff;
}

.record-left {
  flex-shrink: 0;
  width: 96rpx;
}

.record-time {
  font-size: 26rpx;
  color: #aaa;
  font-variant-numeric: tabular-nums;
}

.record-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.record-res {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.record-remark-sub {
  font-size: 22rpx;
  color: #d48806;
}

.record-stage {
  font-size: 22rpx;
  color: #999;
}

.record-group {
  font-size: 20rpx;
  color: #4a90d9;
  background: #eef4fb;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.record-right {
  flex-shrink: 0;
}

.record-duration {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a90d9;
}
