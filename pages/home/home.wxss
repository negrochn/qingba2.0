/* 首页：微信原生风格重构（扁平白卡 + 发丝分隔线 + 统一间距）（支持深色模式） */

page {
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== 区块头（微信原生分组标题风格，与设置页 group-title 一致） ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 12rpx;
}

.section-title {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text4);
  line-height: 1.4;
}

.section-count {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text4);
  line-height: 1.4;
}

/* ===== 阶段 Hero 卡 ===== */
.hero-card {
  background: linear-gradient(135deg, #00c25f 0%, #3fd98a 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin: 0 24rpx 24rpx;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-name {
  font-size: 44rpx;
  line-height: 1.2;
}

.hero-tag,
.hero-badge {
  font-size: calc(20rpx * var(--fs, 1));
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.hero-tag {
  background: rgba(255, 255, 255, 0.2);
}

.hero-badge {
  background: rgba(255, 255, 255, 0.95);
  color: #2e7d32;
}

.hero-desc {
  font-size: calc(24rpx * var(--fs, 1));
  opacity: 0.85;
  margin-top: 12rpx;
}

.progress-track {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: calc(22rpx * var(--fs, 1));
  opacity: 0.9;
}

.hero-hint {
  font-size: calc(24rpx * var(--fs, 1));
  opacity: 0.85;
  margin-top: 16rpx;
}

/* ===== 今日状态条 ===== */
.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin: 0 24rpx 24rpx;
}

.today-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.today-label {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text4);
}

.today-num {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

.today-empty {
  color: var(--text4);
  font-weight: 400;
  font-size: calc(26rpx * var(--fs, 1));
}

.today-btn {
  background: #00c25f;
  color: #fff;
  font-size: calc(26rpx * var(--fs, 1));
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}

.today-btn:active {
  opacity: 0.85;
}

/* ===== 阶段统计 2×2 网格（发丝分隔线，无渐变） ===== */
.summary-card {
  background: var(--card);
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.sum-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  background: var(--card);
}

.sg-cell {
  position: relative;
  text-align: center;
  padding: 28rpx 12rpx;
  box-sizing: border-box;
}

/* 右列加左侧发丝线 */
.sg-tr::before,
.sg-br::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22%;
  bottom: 22%;
  width: 1rpx;
  background: var(--divider);
}

/* 第二行加顶部发丝线 */
.sg-bl::after,
.sg-br::after {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1rpx;
  background: var(--divider);
}

.sg-label {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text4);
  margin-bottom: 12rpx;
}

.sg-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.sg-val {
  font-size: 48rpx;
  color: var(--text);
  line-height: 1.05;
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

.sg-unit {
  font-size: calc(22rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text4);
}

/* ===== 分组时长分布（纯 CSS 条形图） ===== */
.group-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  margin: 0 24rpx 24rpx;
}

.group-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.group-row:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--divider);
}

.group-label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.group-track {
  flex: 1;
  height: 14rpx;
  background: var(--divider);
  border-radius: 7rpx;
  overflow: hidden;
}

.group-fill {
  height: 100%;
  background: #00c25f;
  border-radius: 7rpx;
}

.group-minutes {
  flex-shrink: 0;
  width: 96rpx;
  text-align: right;
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text3);
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

/* ===== 首次启动引导（全屏遮罩）===== */
.ob-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ob-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.ob-logo {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 32rpx;
}

.ob-title {
  font-size: calc(48rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
}

.ob-desc {
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text4);
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.ob-form {
  width: 100%;
  background: var(--card);
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.ob-picker {
  display: block;
}

.ob-form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.ob-picker:not(:first-child) .ob-form-row {
  border-top: 1rpx solid var(--divider);
}

.ob-form-label {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

.ob-form-value {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text3);
}

.ob-hint {
  padding: 16rpx 32rpx 24rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text4);
  line-height: 1.6;
}

.ob-btn {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: calc(32rpx * var(--fs, 1));
  background: #00c25f;
  color: #fff;
  border: none;
  padding: 0;
}

.ob-btn::after {
  border: none;
}

.ob-btn:active {
  background: #3a7bc0;
}
