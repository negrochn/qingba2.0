/* 首页：微信原生风格重构（扁平白卡 + 发丝分隔线 + 统一间距）（支持深色模式） */

page {
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 区块头（微信原生分组标题风格，与设置页 group-title 一致） ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 12rpx;
}

.section-title {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
}

.section-count {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
}

/* ===== 阶段 Hero 卡 ===== */
.hero-card {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin: 0 24rpx 24rpx;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-name {
  font-size: 44rpx;
  line-height: 1.2;
}

.hero-tag,
.hero-badge {
  font-size: calc(20rpx * var(--fs, 1));
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.hero-tag {
  background: rgba(255, 255, 255, 0.2);
}

.hero-badge {
  background: rgba(255, 255, 255, 0.95);
  color: #2e7d32;
}

.hero-desc {
  font-size: calc(24rpx * var(--fs, 1));
  opacity: 0.85;
  margin-top: 12rpx;
}

.progress-track {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: calc(22rpx * var(--fs, 1));
  opacity: 0.9;
}

.hero-hint {
  font-size: calc(24rpx * var(--fs, 1));
  opacity: 0.85;
  margin-top: 16rpx;
}

/* ===== 今日状态条 ===== */
.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin: 0 24rpx 24rpx;
}

.today-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.today-label {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
}

.today-num {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

.today-empty {
  color: var(--text3);
  font-weight: 400;
  font-size: calc(26rpx * var(--fs, 1));
}

.today-btn {
  background: #4a90d9;
  color: #fff;
  font-size: calc(26rpx * var(--fs, 1));
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}

.today-btn:active {
  opacity: 0.85;
}

/* ===== 阶段统计 2×2 网格（发丝分隔线，无渐变） ===== */
.summary-card {
  background: var(--card);
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.sum-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  background: var(--card);
}

.sg-cell {
  position: relative;
  text-align: center;
  padding: 28rpx 12rpx;
  box-sizing: border-box;
}

/* 右列加左侧发丝线 */
.sg-tr::before,
.sg-br::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22%;
  bottom: 22%;
  width: 1rpx;
  background: var(--divider);
}

/* 第二行加顶部发丝线 */
.sg-bl::after,
.sg-br::after {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1rpx;
  background: var(--divider);
}

.sg-label {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  margin-bottom: 12rpx;
}

.sg-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.sg-val {
  font-size: 48rpx;
  color: var(--text);
  line-height: 1.05;
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

.sg-unit {
  font-size: calc(22rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text3);
}

/* ===== 分组时长分布（纯 CSS 条形图） ===== */
.group-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  margin: 0 24rpx 24rpx;
}

.group-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.group-row:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--divider);
}

.group-label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.group-track {
  flex: 1;
  height: 14rpx;
  background: var(--divider);
  border-radius: 7rpx;
  overflow: hidden;
}

.group-fill {
  height: 100%;
  background: #4a90d9;
  border-radius: 7rpx;
}

.group-minutes {
  flex-shrink: 0;
  width: 96rpx;
  text-align: right;
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
}

/* ===== 今日打卡明细 ===== */
.record-list {
  background: var(--card);
  border-radius: 16rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.swipe-wrap {
  position: relative;
  overflow: hidden;
}

.swipe-wrap:not(:last-child) .record-row::after {
  content: '';
  position: absolute;
  left: 80rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--divider);
}

.swipe-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 150rpx;
  display: flex;
  align-items: stretch;
}

.swipe-del {
  width: 100%;
  height: 100%;
  background: #ff4d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(28rpx * var(--fs, 1));
}

.swipe-fg {
  position: relative;
  background: var(--card);
  z-index: 1;
}

.record-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 16rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.record-avatar {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #4a90d9;
  color: #fff;
  font-size: calc(26rpx * var(--fs, 1));
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-res-name {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.record-duration {
  flex-shrink: 0;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  font-family: "DIN Alternate", -apple-system, Helvetica, Arial, sans-serif;
  line-height: 1;
}

.record-line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.tag-group {
  font-size: calc(20rpx * var(--fs, 1));
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 各分类标签颜色 */
.tag-group-main_picture_books { color: #1a5fb0; background: #e8f1fb; }
.tag-group-main_graded_readers { color: #4a26a8; background: #f0eafc; }
.tag-group-main_animations { color: #c4390e; background: #fff1ea; }
.tag-group-sub_graded_readers { color: #006d75; background: #e6fffb; }
.tag-group-sub_animations { color: #b0156e; background: #fff0f6; }
.tag-group-fun_extensions { color: #389e0d; background: #f0ffe0; }
.tag-group-science_extensions { color: #ad6800; background: #fffbe6; }
.tag-group-fusion_apps { color: #531dab; background: #f5f0ff; }
.tag-group-default { color: var(--text3); background: var(--cell-active); }

.record-date {
  flex-shrink: 0;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text3);
}

.record-remark {
  font-size: calc(20rpx * var(--fs, 1));
  color: #52c41a;
  background: #f0fff0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 首次启动引导（全屏遮罩）===== */
.ob-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ob-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.ob-logo {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 32rpx;
}

.ob-title {
  font-size: calc(48rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.ob-desc {
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.ob-form {
  width: 100%;
  background: var(--card);
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.ob-picker {
  display: block;
}

.ob-form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.ob-picker:not(:first-child) .ob-form-row {
  border-top: 1rpx solid var(--divider);
}

.ob-form-label {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

.ob-form-value {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text2);
}

.ob-hint {
  padding: 16rpx 32rpx 24rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.6;
}

.ob-btn {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: calc(32rpx * var(--fs, 1));
  background: #4a90d9;
  color: #fff;
  border: none;
  padding: 0;
}

.ob-btn::after {
  border: none;
}

.ob-btn:active {
  background: #3a7bc0;
}
