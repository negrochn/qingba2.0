/* ===== 首页样式（WeUI 令牌化） ===== */

/* ===== 备份提醒轻条：数据仅存本机且超期未备份时出现，「×」关闭后 30 天冷却 ===== */
.home-backup-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--card);
}
.home-backup-tip__text {
  flex: 1;
  min-width: 0;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}
.home-backup-tip__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.home-backup-tip__btn {
  padding: 8rpx 20rpx;
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--brand);
}
.home-backup-tip__close {
  padding: 8rpx 8rpx 8rpx 12rpx;
  font-size: calc(36rpx * var(--fs, 1));
  line-height: 1;
  color: var(--text3);
}

/* 一次性引导弹层正文 */
.home-guide-text {
  padding: 0 32rpx 24rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.7;
}

/* ① 欢迎条：左「英文日期 + 欢迎语」/ 右「当前阶段」 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
}
.home-greet {
  flex: 1;
  min-width: 0;
}
.home-date {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  font-weight: 400;
  color: var(--text2);
  line-height: 1.4;
}
.home-greet-sub {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  margin-top: 4rpx;
}
.home-greet-day {
  color: var(--brand);              /* 品牌绿：弱化区里靠颜色而非字号突出 */
}

/* 右上角孩子切换器（仅多孩显示）：纯头像，点按弹切换弹层（名字/对勾在弹层内核对）。
   cp-av 72rpx + 外层 padding 8rpx → 点击热区 88rpx（规范 7–9mm）；
   负 margin 抵消 padding 外扩，视觉仍与页面右边距对齐 */
.home-child-av {
  flex-shrink: 0;
  margin-left: 24rpx;
  margin-top: 4rpx;
  margin-right: -8rpx;
  padding: 8rpx;
  border-radius: 50%;
}
.home-child-av-hover { opacity: 0.8; }

/* 欢迎卡：WeUI msg 范式（结果/引导页）+ 配置 cell 分组（路线/阶段），无按钮 */
.home-welcome {
  margin: 16rpx 32rpx 24rpx;
  padding: 64rpx 32rpx 48rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景，与 Hero 同参数 */
  text-align: center;
}
.home-welcome__text-area {
  padding: 0 32rpx;
  margin-bottom: 64rpx;
}
.home-welcome__title {
  margin-bottom: 24rpx;
  font-size: calc(44rpx * var(--fs, 1));   /* weui-msg__title 22px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
}
.home-welcome__desc {
  font-size: calc(30rpx * var(--fs, 1));   /* 空状态说明专用档 */
  line-height: 1.6;
  color: var(--text2);
}
.home-welcome__cells {
  margin-bottom: 40rpx;                    /* 卡内嵌配置列表：背景与卡片同为 --card，无缝 */
  text-align: left;                        /* 外层 msg 范式的居中仅供标题/副文案/tips，cell 列表恢复左对齐，与设置页同构 */
}
.home-welcome__stage-hint {
  color: var(--brand);                     /* 未设置 = 下一步动作，绿色值替代按钮引导 */
}
.home-welcome__tips {
  font-size: calc(28rpx * var(--fs, 1));   /* weui-msg__tips 14px */
  line-height: 1.4;
  color: var(--text3);
}

/* 毕业卡：WeUI msg 范式（标题居中）+ 看板大数字（原语 17）。
   庆祝元素全为纯色（项目禁渐变/外发光）：品牌绿徽章白勾 + 三色 confetti 散点。
   卡片背景/文字走主题变量，confetti 固定高饱和色深浅通用 → 深色模式零额外规则 */
.home-grad {
  margin: 16rpx 32rpx 24rpx;
  padding: 80rpx 32rpx 64rpx;
  border-radius: 20rpx;
  background: var(--card);
  text-align: center;
}
.home-grad__badge-wrap {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto;
}
.home-grad__badge {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}
.home-grad__check {
  color: #fff;                             /* 覆盖 icon-check 默认 var(--brand)：绿底上要白勾 */
  font-size: calc(72rpx * var(--fs, 1));
}
.home-grad__dot {
  position: absolute;
  border-radius: 50%;
}
.home-grad__dot--1 { width: 18rpx; height: 18rpx; background: #ffc300; left: -52rpx; top: 4rpx; }
.home-grad__dot--2 { width: 12rpx; height: 12rpx; background: #10aeff; left: -80rpx; top: 68rpx; }
.home-grad__dot--3 { width: 14rpx; height: 14rpx; background: #fa9d3b; left: -36rpx; top: 116rpx; }
.home-grad__dot--4 { width: 16rpx; height: 16rpx; background: #10aeff; right: -60rpx; top: 16rpx; }
.home-grad__dot--5 { width: 12rpx; height: 12rpx; background: #fa9d3b; right: -88rpx; top: 80rpx; }
.home-grad__dot--6 { width: 18rpx; height: 18rpx; background: #ffc300; right: -40rpx; top: 128rpx; }
.home-grad__dot--7 { width: 10rpx; height: 10rpx; background: #10aeff; left: 40rpx; top: -28rpx; }
.home-grad__dot--8 { width: 12rpx; height: 12rpx; background: #ffc300; right: 48rpx; top: -24rpx; }
.home-grad__title {
  margin-top: 44rpx;
  font-size: calc(44rpx * var(--fs, 1));   /* weui-msg__title 22px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
}
.home-grad__subtitle {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
}
.home-grad__stats {
  display: flex;
  justify-content: center;
  gap: 68rpx;
  margin-top: 60rpx;
}
.home-grad__num {
  font-size: calc(64rpx * var(--fs, 1));   /* 看板大数字档 */
  font-weight: 400;
  line-height: 1.2;
  color: var(--text);
}
.home-grad__unit {
  margin-top: 4rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
}
.home-grad__tips {
  margin-top: 60rpx;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.4;
  color: var(--text3);
}

/* ② Hero 卡：白底卡片 + 7 日柱状图（扁平纯色，无阴影） */
.home-hero {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景 */
  color: var(--text);                  /* 主文字 */
}
.home-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-hero-title {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
}
/* 头部右侧阶段进度（承接原 header 阶段块，同源信息不重复展示） */
.home-hero-stage {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
}

.home-hero-num {
  display: flex;
  flex-wrap: wrap;                  /* 极端长文案时 delta 换行而非溢出 */
  align-items: baseline;
  margin: 16rpx 0 8rpx;
}
.home-hero-val--minor {
  font-size: calc(44rpx * var(--fs, 1));   /* 有小时时，分钟数字降为次级 */
}
.home-hero-val {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.1;
  color: var(--text);
}
.home-hero-unit {
  font-size: calc(30rpx * var(--fs, 1));
  margin-left: 8rpx;
  color: var(--text2);
}
.home-hero-delta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  margin-left: 16rpx;
  color: var(--text2);
}
.home-hero-delta--up { color: var(--brand); }    /* 较上周上涨：品牌绿（进步） */
.home-hero-delta--down { color: var(--danger); } /* 较上周回退：警示红 */
/* 参考线层：高度与柱轨(192rpx)对齐，顶线 = 满刻度、中线 = 半刻度 */
.home-bars-wrap {
  position: relative;
  margin-top: 24rpx;
}
.home-bars-grid {
  position: absolute;               /* 叠在柱轨区域上，不占流内空间 */
  top: 0;
  left: 0;
  right: 0;
  height: 192rpx;                   /* 与柱轨等高：顶线=100%、中线=50% */
  pointer-events: none;
}
.home-bars-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);         /* hairline 同全项目分割线惯例 */
}
.home-bars-line--top { top: 0; }
.home-bars-line--mid { top: 50%; }
.home-bars-line--bottom { bottom: 0; }
.home-bars-scale {
  position: absolute;
  top: -30rpx;                      /* 顶线上方，借 hero-num 与柱区间的空隙 */
  right: 0;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1;
  color: var(--text3);
}
.home-hero-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: auto;                     /* 由 track(192rpx) + 标签自然撑开 */
}
.home-bar {
  position: relative;                /* 气泡定位锚点 */
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 点按气泡（echarts tooltip 效果）：随主题 --card/--text 换底色，浮于柱顶上方
   （bottom 由 JS 预计算：192rpx 轨道×percent + 标签区/间隙 68rpx，见 home.js tipBottom） */
.home-bar-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;                          /* 气泡永远最顶层（高于柱区所有叠层） */
  padding: 10rpx 18rpx;
  background: var(--card);
  color: var(--text);
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1;
  border-radius: 10rpx;
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  animation: barTipIn 0.16s ease-out;
}
/* 气泡内两行「标签 + 值」：右对齐等宽（气泡宽由最长行撑开），行距 8rpx；
   上周行整行弱化为次级色（参考值整体退后，不只弱化数值），
   「0分钟」的值再弱一档（--text3，占位语义） */
.home-bar-tip-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;                          /* 标签与值的保底间距 */
  white-space: nowrap;
}
.home-bar-tip-row + .home-bar-tip-row { margin-top: 8rpx; }
.home-bar-tip-row--sub { color: var(--text2); }
.home-bar-tip-val.is-dim { color: var(--text3); }
/* 箭头独立于气泡、以列定位：恒指列中心，不受首尾气泡 clamp 影响 */
.home-bar-tip-arrow {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;                          /* 与气泡同层，恒在其正下方 */
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-top-color: var(--card);
  border-bottom: none;
  pointer-events: none;
  animation: barTipIn 0.16s ease-out;
}
.home-bar-tip--first { left: 0; transform: none; }    /* 首列居中会溢出卡片左缘 */
.home-bar-tip--last { left: auto; right: 0; transform: none; }
@keyframes barTipIn {
  from { opacity: 0; }
}
.home-bar-track {
  position: relative;                 /* 灰柱/顶线(absolute)的定位与裁切基准 */
  width: 64rpx;
  height: 192rpx;
  background: transparent;                   /* 透明轨道，数据完全由 fill 体现 */
  border-radius: 28rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.home-bar-fill {
  position: relative;
  z-index: 2;                                 /* 叠色顺序：灰(1) < 绿(2) */
  width: 100%;
  background: rgba(7, 193, 96, .14);         /* 统一低透明品牌绿（今日/非今日一致） */
  border-radius: 28rpx;
}
/* 上周同宽叠色柱：垫在绿柱下的低透明灰。var(--text3)+opacity 随深浅主题自适应，
   两色半透明叠出深浅差——灰柱露出的上段即上周高度 */
.home-bar-last {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: var(--text3);
  opacity: 0.35;
  border-radius: 28rpx;
}
.home-bar-fill.is-active {                     /* 选中柱加深，呼应气泡 */
  background: rgba(7, 193, 96, .4);
}
.home-bar-label {
  font-size: calc(24rpx * var(--fs, 1));
  margin-top: 10rpx;
  opacity: 0.8;
}
.home-bar-label.is-today {
  opacity: 1;
}
.home-bar-label.is-active {
  opacity: 1;
  font-weight: 600;
}

/* ③ 2×2 指标卡 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
}
.home-stat {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.home-stat:active { background: var(--cell-active); }
.home-stat-arrow {
  position: absolute;
  top: 44rpx;
  right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
}
.home-stat-num {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  line-height: 1.1;
  margin: 0 0 32rpx;
}
.home-stat-unit {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  margin-left: 4rpx;
}
.home-stat-label {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}

/* 今日明细弹窗的外壳（蒙层 / 面板 / 抓手 / 头部）已迁到 components/half-sheet，
   本页只保留面板内的内容样式（汇总 / 排行榜） */

/* 汇总：大数字（主）+ 副信息 */
.hs-summary {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.hs-summary-main {
  font-size: calc(56rpx * var(--fs, 1));
  line-height: 1.1;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}
.hs-summary-unit {
  font-size: calc(28rpx * var(--fs, 1));   /* 单位字比数字低两档，对齐首页 2×2 卡「大数字 + 小单位」 */
  color: var(--text2);
  margin-left: 4rpx;
}

/* 明细列表（滚动区，滚动自身不挂 catchtouchmove） */
.hs-list { max-height: 56vh; }

/* 排行榜行（对齐统计页「时长排行榜 / 读完排行榜」：底衬进度 + 首字方块 + 右侧数值） */
.hs-rank-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.hs-rank-row:last-child { margin-bottom: 0; }
.hs-rank-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(7, 193, 96, .14);
  z-index: 0;
}
.hs-rank-cover {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--card2);
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30rpx * var(--fs, 1));
}
.hs-rank-name {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hs-rank-dur {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

.hs-empty {
  padding: 72rpx 0 48rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}
