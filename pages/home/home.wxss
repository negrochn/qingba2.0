.hero {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 24rpx;
  padding: 48rpx 36rpx 40rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.hero-eyebrow {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 26rpx 12rpx;
}

.hstat {
  flex: 1;
  text-align: center;
}

.hstat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.hstat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.hstat-sep {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.highlight-card {
  background: linear-gradient(135deg, #fff8ec 0%, #fff3da 100%);
  border-left: 8rpx solid #f0a020;
}

.core-standard {
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.8;
}

.principle {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.principle:last-child {
  border-bottom: none;
}

.principle-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.principle-text {
  flex: 1;
  color: #333;
}

.method {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.method:last-child {
  border-bottom: none;
}

.method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4a90d9;
  margin-bottom: 12rpx;
}

.method-op {
  color: #555;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.method-warn {
  background: #fff4f4;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.warn-title {
  color: #e0625a;
  font-weight: 600;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.warn-item {
  color: #b04040;
  font-size: 24rpx;
  line-height: 1.7;
}

.calc-formula {
  color: #4a90d9;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  margin: 12rpx 0 20rpx;
  padding: 16rpx 24rpx;
  background: #f0f6ff;
  border-radius: 12rpx;
}

.calc-rules {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: #fff4f4;
  border-radius: 10rpx;
  padding: 16rpx;
}

.calc-rule {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.calc-label {
  color: #555;
  flex: 1;
}

.calc-arrow {
  color: #4a90d9;
  margin: 0 12rpx;
  font-weight: 700;
}

.calc-value {
  color: #4a90d9;
  font-weight: 600;
  flex-shrink: 0;
}

.calc-value.warn {
  color: #e0625a;
}

.entry-card {
  display: flex;
  align-items: center;
  background: #4a90d9;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.3);
}

.entry-card:active {
  opacity: 0.9;
}

.entry-body {
  flex: 1;
}

.entry-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.entry-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

.entry-arrow {
  color: #fff;
  font-size: 44rpx;
}
