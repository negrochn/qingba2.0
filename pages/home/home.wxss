/* ===== 首页样式（WeUI 令牌化） ===== */

/* ① 欢迎条：左「英文日期 + 欢迎语」/ 右「当前阶段」 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
}
.home-greet {
  flex: 1;
  min-width: 0;
}
.home-date {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  font-weight: 400;
  color: var(--text2);
  line-height: 1.4;
}
.home-greet-sub {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  margin-top: 4rpx;
}
.home-stage {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding-top: 4rpx;
  text-align: right;
}
.home-stage-name {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级，右侧值 */
  color: var(--text2);
  line-height: 1.4;
}
.home-stage-percent {
  margin-top: 4rpx;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
  line-height: 1.4;
}

/* ② Hero 卡：白底卡片 + 7 日柱状图（扁平纯色，无阴影） */
.home-hero {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景 */
  color: var(--text);                  /* 主文字 */
}
.home-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-hero-title {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
}

.home-hero-num {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 8rpx;
}
.home-hero-val {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.1;
  color: var(--text);
}
.home-hero-unit {
  font-size: calc(30rpx * var(--fs, 1));
  margin-left: 8rpx;
  color: var(--text2);
}
.home-hero-delta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  margin-left: 16rpx;
  color: var(--text2);
}
.home-hero-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 24rpx;
  height: auto;                     /* 由 track(192rpx) + 标签自然撑开 */
}
.home-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-bar-track {
  width: 64rpx;
  height: 192rpx;
  background: transparent;                   /* 透明轨道，数据完全由 fill 体现 */
  border-radius: 28rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.home-bar-fill {
  width: 100%;
  background: rgba(7, 193, 96, .14);         /* 统一低透明品牌绿（今日/非今日一致） */
  border-radius: 28rpx;
}
.home-bar-label {
  font-size: calc(24rpx * var(--fs, 1));
  margin-top: 10rpx;
  opacity: 0.8;
}
.home-bar-label.is-today {
  opacity: 1;
}

/* ③ 2×2 指标卡 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
}
.home-stat {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.home-stat-arrow {
  position: absolute;
  top: 44rpx;
  right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
}
.home-stat-num {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  line-height: 1.1;
  margin: 0 0 32rpx;
}
.home-stat-unit {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  margin-left: 4rpx;
}
.home-stat-label {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}
