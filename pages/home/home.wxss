/* ===== 首页样式（WeUI 令牌化） ===== */

/* ① 欢迎条：左「英文日期 + 欢迎语」/ 右「当前阶段」 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 16rpx;
}
.home-greet {
  flex: 1;
  min-width: 0;
}
.home-date {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  font-weight: 400;
  color: var(--text2);
  line-height: 1.4;
}
.home-greet-sub {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  margin-top: 4rpx;
}
.home-greet-day {
  color: var(--brand);              /* 品牌绿：弱化区里靠颜色而非字号突出 */
}
.home-stage {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding-top: 4rpx;
  text-align: right;
}
.home-stage-name {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级，右侧值 */
  color: var(--text2);
  line-height: 1.4;
}
.home-stage-percent {
  margin-top: 4rpx;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
  line-height: 1.4;
}

/* 欢迎卡：WeUI msg 范式（结果/引导页）+ 配置 cell 分组（路线/阶段），无按钮 */
.home-welcome {
  margin: 16rpx 32rpx 24rpx;
  padding: 64rpx 32rpx 48rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景，与 Hero 同参数 */
  text-align: center;
}
.home-welcome__text-area {
  padding: 0 32rpx;
  margin-bottom: 64rpx;
}
.home-welcome__title {
  margin-bottom: 24rpx;
  font-size: calc(44rpx * var(--fs, 1));   /* weui-msg__title 22px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
}
.home-welcome__desc {
  font-size: calc(30rpx * var(--fs, 1));   /* 空状态说明专用档 */
  line-height: 1.6;
  color: var(--text2);
}
.home-welcome__cells {
  margin-bottom: 40rpx;                    /* 卡内嵌配置列表：背景与卡片同为 --card，无缝 */
  text-align: left;                        /* 外层 msg 范式的居中仅供标题/副文案/tips，cell 列表恢复左对齐，与设置页同构 */
}
.home-welcome__stage-hint {
  color: var(--brand);                     /* 未设置 = 下一步动作，绿色值替代按钮引导 */
}
.home-welcome__tips {
  font-size: calc(28rpx * var(--fs, 1));   /* weui-msg__tips 14px */
  line-height: 1.4;
  color: var(--text3);
}

/* 毕业卡：WeUI msg 范式（标题居中）+ 看板大数字（原语 17）。
   庆祝元素全为纯色（项目禁渐变/外发光）：品牌绿徽章白勾 + 三色 confetti 散点。
   卡片背景/文字走主题变量，confetti 固定高饱和色深浅通用 → 深色模式零额外规则 */
.home-grad {
  margin: 16rpx 32rpx 24rpx;
  padding: 80rpx 32rpx 64rpx;
  border-radius: 20rpx;
  background: var(--card);
  text-align: center;
}
.home-grad__badge-wrap {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto;
}
.home-grad__badge {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}
.home-grad__check {
  color: #fff;                             /* 覆盖 icon-check 默认 var(--brand)：绿底上要白勾 */
  font-size: calc(72rpx * var(--fs, 1));
}
.home-grad__dot {
  position: absolute;
  border-radius: 50%;
}
.home-grad__dot--1 { width: 18rpx; height: 18rpx; background: #ffc300; left: -52rpx; top: 4rpx; }
.home-grad__dot--2 { width: 12rpx; height: 12rpx; background: #10aeff; left: -80rpx; top: 68rpx; }
.home-grad__dot--3 { width: 14rpx; height: 14rpx; background: #fa9d3b; left: -36rpx; top: 116rpx; }
.home-grad__dot--4 { width: 16rpx; height: 16rpx; background: #10aeff; right: -60rpx; top: 16rpx; }
.home-grad__dot--5 { width: 12rpx; height: 12rpx; background: #fa9d3b; right: -88rpx; top: 80rpx; }
.home-grad__dot--6 { width: 18rpx; height: 18rpx; background: #ffc300; right: -40rpx; top: 128rpx; }
.home-grad__dot--7 { width: 10rpx; height: 10rpx; background: #10aeff; left: 40rpx; top: -28rpx; }
.home-grad__dot--8 { width: 12rpx; height: 12rpx; background: #ffc300; right: 48rpx; top: -24rpx; }
.home-grad__title {
  margin-top: 44rpx;
  font-size: calc(44rpx * var(--fs, 1));   /* weui-msg__title 22px */
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
}
.home-grad__subtitle {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
}
.home-grad__stats {
  display: flex;
  justify-content: center;
  gap: 68rpx;
  margin-top: 60rpx;
}
.home-grad__num {
  font-size: calc(64rpx * var(--fs, 1));   /* 看板大数字档 */
  font-weight: 400;
  line-height: 1.2;
  color: var(--text);
}
.home-grad__unit {
  margin-top: 4rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
}
.home-grad__tips {
  margin-top: 60rpx;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.4;
  color: var(--text3);
}

/* ② Hero 卡：白底卡片 + 7 日柱状图（扁平纯色，无阴影） */
.home-hero {
  margin: 16rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);             /* 卡片背景 */
  color: var(--text);                  /* 主文字 */
}
.home-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-hero-title {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
}

.home-hero-num {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 8rpx;
}
.home-hero-val {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.1;
  color: var(--text);
}
.home-hero-unit {
  font-size: calc(30rpx * var(--fs, 1));
  margin-left: 8rpx;
  color: var(--text2);
}
.home-hero-delta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  margin-left: 16rpx;
  color: var(--text2);
}
.home-hero-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 24rpx;
  height: auto;                     /* 由 track(192rpx) + 标签自然撑开 */
}
.home-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-bar-track {
  width: 64rpx;
  height: 192rpx;
  background: transparent;                   /* 透明轨道，数据完全由 fill 体现 */
  border-radius: 28rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.home-bar-fill {
  width: 100%;
  background: rgba(7, 193, 96, .14);         /* 统一低透明品牌绿（今日/非今日一致） */
  border-radius: 28rpx;
}
.home-bar-label {
  font-size: calc(24rpx * var(--fs, 1));
  margin-top: 10rpx;
  opacity: 0.8;
}
.home-bar-label.is-today {
  opacity: 1;
}

/* ③ 2×2 指标卡 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
}
.home-stat {
  position: relative;
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.home-stat:active { background: var(--cell-active); }
.home-stat-arrow {
  position: absolute;
  top: 44rpx;
  right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
}
.home-stat-num {
  font-size: calc(72rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text);
  line-height: 1.1;
  margin: 0 0 32rpx;
}
.home-stat-unit {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text2);
  margin-left: 4rpx;
}
.home-stat-label {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}

/* 今日明细弹窗的外壳（蒙层 / 面板 / 抓手 / 头部）已迁到 components/half-sheet，
   本页只保留面板内的内容样式（汇总 / 排行榜） */

/* 汇总：大数字（主）+ 副信息 */
.hs-summary {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.hs-summary-main {
  font-size: calc(56rpx * var(--fs, 1));
  line-height: 1.1;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}
.hs-summary-sub {
  margin-left: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

/* 明细列表（滚动区，滚动自身不挂 catchtouchmove） */
.hs-list { max-height: 56vh; }

/* 排行榜行（对齐统计页「时长排行榜 / 读完排行榜」：底衬进度 + 首字方块 + 右侧数值） */
.hs-rank-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.hs-rank-row:last-child { margin-bottom: 0; }
.hs-rank-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(7, 193, 96, .14);
  z-index: 0;
}
.hs-rank-cover {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--card2);
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30rpx * var(--fs, 1));
}
.hs-rank-name {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hs-rank-dur {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

.hs-empty {
  padding: 72rpx 0 48rpx;
  text-align: center;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}
