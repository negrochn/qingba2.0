<view class="container">

  <!-- 数据卡片 -->
  <view class="stats-card">
    <view class="sum-grid">
      <view class="sg-cell sg-tl">
        <view class="sg-label">已读完</view>
        <view class="sg-num">
          <text class="sg-val">{{totalCount}}</text>
          <text class="sg-unit">次</text>
        </view>
      </view>
      <view class="sg-cell sg-tr">
        <view class="sg-label">涉及阶段</view>
        <view class="sg-num">
          <text class="sg-val">{{stageCount}}</text>
          <text class="sg-unit">个</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 图表卡片 -->
  <view class="chart-card" wx:if="{{hasData}}">
    <canvas canvas-id="readChart" class="chart-canvas"
      bindtouchstart="onChartTouchStart"
      bindtouchmove="onChartTouchMove"
      bindtouchend="onChartTouchEnd"
      bindtouchcancel="onChartTouchEnd"></canvas>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!hasData}}">
    <text>还没有已读完的绘本，加油哦～</text>
  </view>

</view>