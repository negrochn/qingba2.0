/* 已读完统计页 */

page {
  background: #f5f5f5;
}

.container {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 数据卡片 ===== */
.stats-card {
  margin: 0 0 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(60, 90, 140, 0.06);
}

.sum-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fff;
  border-radius: 20rpx;
  row-gap: 10rpx;
}

.sg-cell {
  position: relative;
  text-align: center;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
}

.sg-tr::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18%;
  bottom: 18%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent 0%, #e5e9f0 30%, #e5e9f0 70%, transparent 100%);
}

.sg-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.sg-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.sg-val {
  font-size: 52rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.05;
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}

.sg-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a8f99;
}

/* ===== 图表卡片 ===== */
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

/* ===== 详情列表卡片 ===== */
.detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-stage {
  font-size: 24rpx;
  color: #4a90d9;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.detail-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-book {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.detail-count {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #ccc;
}