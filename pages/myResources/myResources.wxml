<view class="container {{fontClass}} {{darkClass}}">

  <!-- 以 sections 是否为空判断，而不是计数：两者一旦不一致（有资源但没有任何分组被列出），
       页面会两边都不渲染、整页空白。按 sections 判断至少能落到空态提示 -->
  <block wx:if="{{sections.length}}">
    <block wx:for="{{sections}}" wx:key="stageId" wx:for-item="sec">
      <!-- sec-anchor = 索引锚点：点击跳转实测 #sec-<stageId>，滚动联动 selectAll('.sec-anchor') -->
      <view class="weui-cells__title sec-anchor" id="sec-{{sec.stageId}}">{{sec.stageName}}</view>
      <view class="res-wrap">
        <view class="res-list" wx:for="{{sec.groups}}" wx:key="uid" wx:for-item="grp">
          <!-- 分组头（与阶段详情页同款：彩色圆点 + 名称 + 数量 + 折叠箭头） -->
          <view
            class="rg-head rg-head-active"
            data-uid="{{grp.uid}}"
            bindtap="onToggleGroup"
          >
            <view class="rg-head-left">
              <view class="rg-dot rg-dot-{{grp.key}}"></view>
              <view class="rg-label rg-label-{{grp.key}}">{{grp.label}}</view>
              <!-- 计数含隐藏项；有隐藏时追加「藏 N」（分组头空间紧，从简） -->
              <view class="rg-count">{{grp.items.length}} 项{{grp.hidCount ? ' · 藏 ' + grp.hidCount : ''}}</view>
              <!-- 分组当前不可见（如熏听开关关闭）：资源仍在，只是不参与阶段页打卡 -->
              <view class="rg-hidden" wx:if="{{grp.hidden}}">已隐藏</view>
            </view>
            <view class="rg-head-right">
              <!-- 组内拖拽排序入口：≥2 项且展开态才显示（排序是内容级操作，折叠态无内容可排） -->
              <view
                class="rg-sort"
                wx:if="{{grp.items.length > 1 && expandedGroups[grp.uid]}}"
                catchtap="openSort"
                data-stage="{{sec.stageId}}"
                data-key="{{grp.key}}"
                data-label="{{grp.label}}"
              >排序</view>
              <text class="rg-arrow iconfont {{expandedGroups[grp.uid] ? 'icon-fold' : 'icon-unfold'}}"></text>
            </view>
          </view>

          <view class="rg-body" wx:if="{{expandedGroups[grp.uid]}}">
            <!-- 左滑操作：隐藏行首钮 = 恢复（中性灰），普通行首钮 = 隐藏（橙）；非破坏左、破坏右不变 -->
            <!-- 仅位移非零（拖动中 / 滑开保持）的行整行提升（.swipe-wrap-up）：
                 右缘操作钮浮于索引条之上。按住不动不提升——否则按下态灰底会盖住索引条；
                 拖动确认后 _idxHide 会渐隐索引，提升只负责衔接渐隐前的间隙 -->
            <view
              class="swipe-wrap {{it._dx ? 'swipe-wrap-up' : ''}}"
              wx:for="{{grp.items}}"
              wx:for-item="it"
              wx:key="id"
              data-path="{{it._path}}"
              bindtouchstart="onTouchStart"
              bindtouchmove="onTouchMove"
              bindtouchend="onTouchEnd"
            >
              <view class="swipe-bg" style="width: {{it._w}}rpx;">
                <view class="swipe-act swipe-act-restore" wx:if="{{it._hid}}" catchtap="onShowItem" data-id="{{it.id}}">恢复</view>
                <view class="swipe-act swipe-act-hide" wx:else catchtap="onHideItem" data-id="{{it.id}}">隐藏</view>
                <view class="swipe-act swipe-act-del" wx:if="{{it.custom}}" catchtap="onDeleteItem" data-id="{{it.id}}">删除</view>
              </view>
              <view
                class="weui-cell swipe-fg {{it.custom ? 'weui-cell_access' : ''}} {{it._hid ? 'swipe-fg-hidden' : ''}}"
                style="transform: translateX({{it._dx}}rpx); transition: {{it._anim ? 'transform 0.25s ease' : 'none'}};"
                data-id="{{it.id}}"
                data-custom="{{it.custom}}"
                bindtap="openEdit"
              >
                <view class="weui-cell__bd">
                  {{it.name}}
                  <text class="mr-badge" wx:if="{{it.custom}}">自定义</text>
                  <text class="mr-badge" wx:if="{{it._hid}}">已隐藏</text>
                </view>
                <view class="weui-cell__ft" wx:if="{{it.custom}}">
                  <text class="iconfont icon-right"></text>
                </view>
              </view>
            </view>
            <!-- 隐藏分组说明：一行讲清「资源还在、只是不参与打卡」 -->
            <view class="mr-hidden-tip" wx:if="{{grp.hidden}}">该分组不参与打卡：资源仍保留，可在设置中开启后打卡</view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="mr-empty" wx:else>
    <view class="mr-empty-text">该路线暂无资源清单</view>
    <view class="mr-empty-tip">把自己买的书 / 动画加进来，归入对应分组即可和官方资源一起打卡、统计时长与阶段进度</view>
  </view>

  <view class="mr-add-area">
    <button class="weui-btn weui-btn_primary" bindtap="openAdd">+ 添加资源</button>
  </view>

  <!-- ===== 阶段索引条（右侧浮层） =====
       参考 TDesign Indexes 的交互形态、按项目「借做法不引包」口径自研：
       条上单字符瞄准（常规 = 阶段序号 / 准；大循环 = 前 / 一 / 牛N 序号 / 三），
       按住时气泡显短名（常规1 / 前置 / 调牛N / 标牛N / 三阶）。sections < 3 不渲染——
       一屏内的页面挂索引条纯是噪音。层级：浮于普通行之上、低于滑开行（见 .idx-bar 注释）；
       行左滑期间 / 滑开保持时 _idxHide 渐隐整条，右侧操作按钮区不与索引互扰；
       catchtouchmove 防触摸时页面跟着滚 -->
  <view
    class="idx-bar {{_idxHide ? 'idx-bar-hide' : ''}}"
    wx:if="{{idxBar.length >= 3}}"
    bindtouchstart="onIdxTouchStart"
    catchtouchmove="onIdxTouchMove"
    bindtouchend="onIdxTouchEnd"
    bindtouchcancel="onIdxTouchEnd"
  >
    <view
      class="idx-item {{idxActive === index ? 'idx-item-active' : ''}}"
      wx:for="{{idxBar}}"
      wx:key="stageId"
    >{{item.char}}</view>
  </view>
  <!-- 按住气泡：top 跟随命中项（js 实测换算，px 口径），松手消失 -->
  <view class="idx-tip" wx:if="{{idxTip}}" style="top: {{idxTipTop}}px;">{{idxTip}}</view>

</view>

<!-- 添加 / 编辑 半屏弹窗（half-sheet 外壳 + form-card 令牌），仅自定义资源 -->
<half-sheet
  show="{{showSheet}}"
  title="{{sheetTitle}}"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeSheet"
>
  <view class="form-card">
    <view class="form-row">
      <view class="form-label">资源名称</view>
      <input
        class="form-field"
        placeholder="如：家里买的XX绘本"
        value="{{nameInput}}"
        bindinput="onNameInput"
        bindblur="onNameBlur"
        maxlength="-1"
      />
    </view>
    <view class="weui-divider"></view>
    <!-- 归属：拆成「阶段」+「分组」两行原生 picker，二者联动 ——
         不同阶段的分组集合有差异，切阶段后分组列表需重建、下标归零 -->
    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="form-row">
        <view class="form-label">阶段</view>
        <view class="form-right">
          <text class="form-static">{{stageNames[stageIndex]}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
    <view class="weui-divider"></view>
    <picker mode="selector" range="{{groupNames}}" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="form-row">
        <view class="form-label">分组</view>
        <view class="form-right">
          <text class="form-static">{{groupNames[groupIndex]}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 删除统一走列表左滑（同打卡记录页），弹窗只保留取消 / 保存 -->
  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closeSheet">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="submitSheet">{{isEdit ? '保存' : '添加'}}</button>
  </view>
</half-sheet>
