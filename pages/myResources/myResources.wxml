<view class="container {{fontClass}} {{darkClass}}">

  <!-- 口径说明：官方 + 自定义全量清单，左滑隐藏 / 删除，页底可恢复 -->
  <view class="mr-tip">左滑可隐藏不用的资源：仅从打卡视图移除，历史记录与统计保留，页底可恢复。自定义资源还可编辑或删除；官方资源为只读。</view>

  <!-- 以 sections 是否为空判断，而不是计数：两者一旦不一致（有资源但没有任何分组被列出），
       页面会两边都不渲染、整页空白。按 sections 判断至少能落到空态提示 -->
  <block wx:if="{{sections.length}}">
    <block wx:for="{{sections}}" wx:key="stageId" wx:for-item="sec">
      <view class="weui-cells__title">{{sec.stageName}}</view>
      <view class="res-wrap">
        <view class="res-list" wx:for="{{sec.groups}}" wx:key="uid" wx:for-item="grp">
          <!-- 分组头（与阶段详情页同款：彩色圆点 + 名称 + 数量 + 折叠箭头） -->
          <view
            class="rg-head rg-head-active"
            data-uid="{{grp.uid}}"
            bindtap="onToggleGroup"
          >
            <view class="rg-head-left">
              <view class="rg-dot rg-dot-{{grp.key}}"></view>
              <view class="rg-label rg-label-{{grp.key}}">{{grp.label}}</view>
              <view class="rg-count">{{grp.items.length}} 项</view>
              <!-- 分组当前不可见（如熏听开关关闭）：资源仍在，只是不参与阶段页打卡 -->
              <view class="rg-hidden" wx:if="{{grp.hidden}}">已隐藏</view>
            </view>
            <view class="rg-head-right">
              <!-- 组内拖拽排序入口：≥2 项才有意义 -->
              <view
                class="rg-sort"
                wx:if="{{grp.items.length > 1}}"
                catchtap="openSort"
                data-stage="{{sec.stageId}}"
                data-key="{{grp.key}}"
                data-label="{{grp.label}}"
              >排序</view>
              <view class="rg-arrow {{expandedGroups[grp.uid] ? 'rg-arrow-open' : ''}}">›</view>
            </view>
          </view>

          <view class="rg-body" wx:if="{{expandedGroups[grp.uid]}}">
            <!-- 左滑操作：官方 = 隐藏；自定义 = 隐藏 + 删除 -->
            <view
              class="swipe-wrap"
              wx:for="{{grp.items}}"
              wx:for-item="it"
              wx:key="id"
              data-path="{{it._path}}"
              bindtouchstart="onTouchStart"
              bindtouchmove="onTouchMove"
              bindtouchend="onTouchEnd"
            >
              <view class="swipe-bg" style="width: {{it._w}}rpx;">
                <view class="swipe-act swipe-act-hide" catchtap="onHideItem" data-id="{{it.id}}">隐藏</view>
                <view class="swipe-act swipe-act-del" wx:if="{{it.custom}}" catchtap="onDeleteItem" data-id="{{it.id}}">删除</view>
              </view>
              <view
                class="weui-cell swipe-fg {{it.custom ? 'weui-cell_access' : ''}}"
                style="transform: translateX({{it._dx}}rpx); transition: {{it._anim ? 'transform 0.25s ease' : 'none'}};"
                data-id="{{it.id}}"
                data-custom="{{it.custom}}"
                bindtap="openEdit"
              >
                <view class="weui-cell__bd">
                  {{it.name}}
                  <text class="mr-badge" wx:if="{{it.custom}}">自定义</text>
                </view>
                <view class="weui-cell__ft" wx:if="{{it.custom}}">
                  <text class="iconfont icon-right"></text>
                </view>
              </view>
            </view>
            <!-- 隐藏分组说明：讲清「资源还在、只是不参与打卡」，避免误以为数据丢了 -->
            <view class="mr-hidden-tip" wx:if="{{grp.hidden}}">该分组当前不参与打卡（如「设置 → 熏听」开关已关闭）：资源仍保留，可改名或改归属；开启开关后可在阶段页打卡</view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="mr-empty" wx:else>
    <view class="mr-empty-text">该路线暂无资源清单</view>
    <view class="mr-empty-tip">把自己买的书 / 动画加进来，归入对应分组即可和官方资源一起打卡、统计时长与阶段进度</view>
  </view>

  <!-- 已隐藏资源：黑名单可逆，点「恢复」即回到分组（回到官方序或自定义排序位置） -->
  <view class="mr-hidden-sec" wx:if="{{hiddenCount}}">
    <view class="mr-hidden-head" bindtap="toggleHiddenArea">
      <view class="mr-hidden-title">已隐藏的资源（{{hiddenCount}}）</view>
      <view class="rg-arrow {{showHidden ? 'rg-arrow-open' : ''}}">›</view>
    </view>
    <view wx:if="{{showHidden}}">
      <view
        class="mr-hidden-row"
        wx:for="{{hiddenItems}}"
        wx:key="id"
        bindtap="onRestoreItem"
        data-id="{{item.id}}"
      >
        <view class="mr-hidden-main">
          <view class="mr-hidden-name">{{item.name}}</view>
          <view class="mr-hidden-loc">{{item.stageName}} · {{item.groupLabel}}</view>
        </view>
        <view class="mr-hidden-restore">恢复</view>
      </view>
    </view>
  </view>

  <view class="mr-add-area">
    <button class="weui-btn weui-btn_primary" bindtap="openAdd">+ 添加资源</button>
  </view>

</view>

<!-- 分组内拖拽排序（全屏排序态）。
     滚动冲突处理：蒙层与头部各自 catchtouchmove 挡住页面滚动，
     列表区交给 scroll-view 原生滚动；拖拽只发生在手柄上（catch 手势），
     列表其余区域照常滚动；拖到上下边缘由 scroll-top 程序化补滚 -->
<view class="sort-wrap" wx:if="{{sort.show}}">
  <view class="sort-mask" catchtap="closeSort" catchtouchmove="noop"></view>
  <view class="sort-panel">
    <view class="sort-head" catchtouchmove="noop">
      <view class="sort-title">调整顺序 · {{sort.label}}</view>
      <view class="sort-head-ops">
        <view class="sort-reset" catchtap="onSortReset">恢复默认</view>
        <view class="sort-done" catchtap="closeSort">完成</view>
      </view>
    </view>
    <view class="sort-hint">按住右侧手柄上下拖动，松手即保存</view>
    <scroll-view
      class="sort-sv"
      scroll-y
      scroll-top="{{sort.svTop}}"
      bindscroll="onSortScroll"
    >
      <view
        class="sort-row {{item._drag ? 'sort-row-drag' : ''}}"
        wx:for="{{sort.items}}"
        wx:key="id"
        style="transform: translateY({{item._y}}px) {{item._drag ? 'scale(1.02)' : ''}}; transition: {{item._drag ? 'none' : 'transform 0.2s ease'}}; z-index: {{item._drag ? 10 : 1}};"
      >
        <view class="sort-row-main">
          {{item.name}}
          <text class="mr-badge" wx:if="{{item.custom}}">自定义</text>
        </view>
        <view
          class="sort-handle"
          data-idx="{{index}}"
          catchtouchstart="onSortHandleStart"
          catchtouchmove="onSortHandleMove"
          catchtouchend="onSortHandleEnd"
          catchtouchcancel="onSortHandleEnd"
        >≡</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 添加 / 编辑 半屏弹窗（half-sheet 外壳 + form-card 令牌），仅自定义资源 -->
<half-sheet
  show="{{showSheet}}"
  title="{{sheetTitle}}"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeSheet"
>
  <view class="form-card">
    <view class="form-row">
      <view class="form-label">资源名称</view>
      <input
        class="form-field"
        placeholder="如：家里买的XX绘本"
        value="{{nameInput}}"
        bindinput="onNameInput"
        bindblur="onNameBlur"
        maxlength="-1"
      />
    </view>
    <view class="weui-divider"></view>
    <!-- 归属：拆成「阶段」+「分组」两行原生 picker，二者联动 ——
         不同阶段的分组集合有差异，切阶段后分组列表需重建、下标归零 -->
    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="form-row">
        <view class="form-label">阶段</view>
        <view class="form-right">
          <text class="form-static">{{stageNames[stageIndex]}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
    <view class="weui-divider"></view>
    <picker mode="selector" range="{{groupNames}}" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="form-row">
        <view class="form-label">分组</view>
        <view class="form-right">
          <text class="form-static">{{groupNames[groupIndex]}}</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 删除统一走列表左滑（同打卡记录页），弹窗只保留取消 / 保存 -->
  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closeSheet">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="submitSheet">{{isEdit ? '保存' : '添加'}}</button>
  </view>
</half-sheet>
