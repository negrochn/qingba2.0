<view class="container {{fontClass}} {{darkClass}}">

  <!-- 顶部个人卡片（仿微信「我」头像区） -->
  <view class="profile-card" bindtap="goAbout">
    <view class="profile-avatar">📚</view>
    <view class="profile-info">
      <view class="profile-name">庆爸2.0</view>
      <view class="profile-subtitle">儿童英语听力打卡</view>
      <view class="profile-status-row">
        <text class="profile-status-btn">+ 状态</text>
      </view>
    </view>
    <view class="profile-qr">▦</view>
    <text class="profile-arrow">›</text>
  </view>

  <!-- 关于（独立项，与资料卡无缝相连） -->
  <view class="group">
    <view class="group-card">
      <view class="cell" bindtap="goAbout">
        <view class="cell-icon icon-info">ⓘ</view>
        <view class="cell-label">关于庆爸2.0</view>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 功能（打卡记录 + 数据统计） -->
  <view class="group">
    <view class="group-card">
      <view class="cell" bindtap="goRecords">
        <view class="cell-icon icon-check">✓</view>
        <view class="cell-label">打卡记录</view>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="goStats">
        <view class="cell-icon icon-chart">📊</view>
        <view class="cell-label">数据统计</view>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置（独立项） -->
  <view class="group">
    <view class="group-card">
      <view class="cell" bindtap="goSettings">
        <view class="cell-icon icon-gear">⚙</view>
        <view class="cell-label">设置</view>
        <text class="cell-arrow">›</text>
      </view>
    </view>
  </view>

</view>