<view class="container {{fontClass}} {{darkClass}}">

  <!-- 路线介绍（两路线独立页面、独立入口） -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" bindtap="goAbout">
      <view class="weui-cell__hd"><text class="iconfont icon-info"></text></view>
      <view class="weui-cell__bd">常规路线介绍</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goAboutBigloop">
      <view class="weui-cell__hd"><text class="iconfont icon-info"></text></view>
      <view class="weui-cell__bd">大循环路线介绍</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
  </view>

  <!-- 功能 -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" bindtap="goRecords">
      <view class="weui-cell__hd"><text class="iconfont icon-squarecheck"></text></view>
      <view class="weui-cell__bd">打卡记录</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goStats">
      <view class="weui-cell__hd"><text class="iconfont icon-rank"></text></view>
      <view class="weui-cell__bd">数据统计</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" bindtap="goSettings">
      <view class="weui-cell__hd"><text class="iconfont icon-settings"></text></view>
      <view class="weui-cell__bd">设置</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
  </view>

</view>
