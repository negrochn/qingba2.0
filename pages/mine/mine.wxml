<view class="container {{fontClass}} {{darkClass}}">

  <!-- 路线介绍：只显示当前路线的入口（与全 app「只服务当前路线」口径一致；
       想了解另一条路线走路线选择页切换） -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" wx:if="{{routeId === 'regular'}}" bindtap="goAbout">
      <view class="weui-cell__hd"><text class="iconfont icon-info"></text></view>
      <view class="weui-cell__bd">常规路线介绍</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <view class="weui-cell weui-cell_access" wx:if="{{routeId === 'bigloop'}}" bindtap="goAboutBigloop">
      <view class="weui-cell__hd"><text class="iconfont icon-info"></text></view>
      <view class="weui-cell__bd">大循环路线介绍</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
  </view>

  <!-- 功能 -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" bindtap="goRecords">
      <view class="weui-cell__hd"><text class="iconfont icon-squarecheck"></text></view>
      <view class="weui-cell__bd">打卡记录</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goStats">
      <view class="weui-cell__hd"><text class="iconfont icon-rank"></text></view>
      <view class="weui-cell__bd">数据统计</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <!-- 数据管理：备份 / 恢复 / 清空的唯一聚合页（设置页已无数据入口），
         低频但高价值，「我的」页直达；红点同口径（数据量达标且超期未备份） -->
    <view class="weui-cell weui-cell_access" bindtap="goDataBackup">
      <view class="weui-cell__hd"><text class="iconfont icon-lock"></text></view>
      <view class="weui-cell__bd">数据管理<text class="backup-dot" wx:if="{{backupRemind}}"></text></view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
    <!-- 会员中心：非会员纯导航无值位（常驻空间不亮价格，与「数据管理」等入口平权）；
         会员金色「永久会员」是身份确认。价格只留在意愿场景内：
         会员中心页状态卡 + 备份被拦的解锁弹层 -->
    <view class="weui-cell weui-cell_access" bindtap="goMembership">
      <view class="weui-cell__hd"><text class="iconfont icon-vip"></text></view>
      <view class="weui-cell__bd">会员中心</view>
      <view class="weui-cell__ft">
        <text class="mine-member-ft" wx:if="{{isMember}}">永久会员</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="weui-cells mb-16">
    <view class="weui-cell weui-cell_access" bindtap="goSettings">
      <view class="weui-cell__hd"><text class="iconfont icon-settings"></text></view>
      <view class="weui-cell__bd">设置</view>
      <view class="weui-cell__ft"><text class="iconfont icon-right"></text></view>
    </view>
  </view>

</view>
