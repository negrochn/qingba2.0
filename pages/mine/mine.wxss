/* 我的页卡 - 微信小程序原生分组列表风格（与设置页一致） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组 ===== */
.group {
  margin-bottom: 24rpx;
}

.group-card {
  background: var(--card);
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* ===== 列表项 ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.cell:active {
  background: var(--cell-active);
}

.cell-label {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

.cell-arrow {
  font-size: calc(36rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
}

/* 分隔线：左侧留白（微信原生 inset） */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 32rpx;
}
