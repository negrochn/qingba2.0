.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: #888;
  font-size: 26rpx;
}

.row-value {
  color: #333;
  font-size: 26rpx;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 12rpx 0 24rpx;
}
