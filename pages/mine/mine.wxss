.menu {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.menu-item:last-child::after {
  display: none;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c8c8c8;
}
