/* 我的页卡 - 仿微信「我」页布局
   顶部资料卡（头像区）+ 分组列表（左图标 + 右箭头，组间灰底间隔）
   主题：复用全局 --bg / --card / --card2 / --text / --text2 / --text3 / --divider / --cell-active
   缩放：保留 --fs 机制（calc(Nrpx * var(--fs, 1))），字号随系统档位缩放 */

page {
  background: var(--bg);
}

.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 个人卡片（仿微信「我」头像区） ===== */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--card);
  padding: 32rpx;
  margin-bottom: 0; /* 与下方第一组无缝相连（仿微信：资料卡与「服务」同一片白底） */
}

.profile-card:active {
  background: var(--cell-active);
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  background: var(--card2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  line-height: 1;
}

.profile-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.profile-name {
  font-size: calc(40rpx * var(--fs, 1));
  color: var(--text);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.profile-subtitle {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  margin-bottom: 16rpx;
}

.profile-status-row {
  display: flex;
  align-items: center;
}

.profile-status-btn {
  display: inline-block;
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--text3);
  border-radius: 24rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}

.profile-qr {
  font-size: 48rpx;
  color: var(--text3);
  margin-right: 12rpx;
  line-height: 1;
  flex-shrink: 0;
}

.profile-arrow {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  flex-shrink: 0;
}

/* ===== 分组（组间灰底间隔 24rpx） ===== */
.group {
  margin-bottom: 24rpx;
}

.group-card {
  background: var(--card);
  margin: 0;
  border-radius: 0;
  overflow: hidden;
}

/* ===== 列表项 ===== */
.cell {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.cell:active {
  background: var(--cell-active);
}

/* cell 左侧图标（仿微信各功能入口的彩色小图标） */
.cell-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 图标配色：仿微信各模块色板（服务绿、收藏橙、设置蓝 等） */
.icon-info { color: #4a90d9; }
.icon-check { color: #07C160; } /* 仿微信「服务」绿 */
.icon-chart { color: #FA9D3B; } /* 仿微信「收藏」橙 */
.icon-gear { color: #4a90d9; } /* 仿微信「设置」蓝 */

.cell-label {
  flex: 1;
  min-width: 0;
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
}

.cell-arrow {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 分隔线：左缩进 = pad(32) + icon(40) + gap(20) = 92rpx（图标右对齐，不被分隔线穿过） */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 92rpx;
}