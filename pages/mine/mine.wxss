.menu {
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 80rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--divider);
}

.menu-item:last-child::after {
  display: none;
}

.menu-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(32rpx * var(--fs, 1));
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

.menu-arrow {
  font-size: calc(32rpx * var(--fs, 1));
  color: #c0c8d0;
}

/* 深色模式适配 */
.dm-dark .menu-arrow { color: #4a4a4e; }

@media (prefers-color-scheme: dark) {
  .dm-auto .menu-arrow { color: #4a4a4e; }
}
