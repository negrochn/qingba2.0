/* 我的页 - WeUI 风格分组列表，组件原语见全局 app.wxss */
page {
  background: var(--bg);
}

/* 左侧入口图标：与右侧箭头(icon-right)保持一致的视觉权重 */
.weui-cell__hd .iconfont {
  font-size: 40rpx;
  color: var(--text2);
  margin-right: 8rpx;
}

/* 「数据与备份」入口的提醒红点：与设置页同款（数据量达标且超期未备份时常驻显示） */
.backup-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  vertical-align: middle;
}

/* 「会员中心」入口的值位（weui-cell__ft 内、箭头左侧）：仅会员态展示，
   金色「永久会员」是身份确认；非会员纯导航无值位（价格只在意愿场景） */
.mine-member-ft {
  margin-right: 8rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: #d29a3a;
}
