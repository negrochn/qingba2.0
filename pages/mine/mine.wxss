/* 我的页卡 - 与设置页同一套微信风格分组列表原语（无 group-title，cell 左侧带图标）
   组件原语：.group（全宽分组 section）+ .group-card（平铺无圆角）+ .cell 基类
   主题：复用全局 --bg/--card/--text/--text2/--text3/--divider/--cell-active（同名 token）
   缩放：保留 --fs 机制（calc(Nrpx * var(--fs,1))），字号随系统档位缩放 */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组 ===== */
.group {
  margin-bottom: 24rpx; /* group-gap 24rpx */
}

.group-card {
  background: var(--card);
  margin: 0; /* 全宽平铺，无侧边距 */
  border-radius: 0; /* 无圆角 */
  overflow: hidden;
}

/* ===== 列表项（.cell 基类） ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx; /* cell-h 88rpx（点击热区） */
  padding: 24rpx 32rpx; /* cell-pad-x：左右 32rpx 对称 */
  box-sizing: border-box;
}

.cell:active {
  background: var(--cell-active);
}

/* cell 左侧图标（emoji，与文字左对齐排布） */
.cell-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx; /* 图标与标题间距 */
  flex-shrink: 0;
  line-height: 1;
}

.cell-label {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1)); /* row 主文 34rpx */
  color: var(--text);
}

.cell-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.cell-desc {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

.cell-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 60%;
}

.cell-value {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text2);
}

.cell-value.placeholder {
  color: var(--text2);
  opacity: 0.6;
}

.cell-desc-right {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

.cell-arrow {
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1;
  margin-left: 12rpx;
}

/* 危险操作语义色 = #FF3B30 */
.cell-danger .cell-label {
  color: #FF3B30;
}

.cell-danger .cell-desc-right {
  color: rgba(255, 59, 48, 0.6);
}

/* 分隔线：左缩进 = pad(32) + icon(44) + gap(24) = 100rpx（对齐标题左缘） */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 100rpx;
}
