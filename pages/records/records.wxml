<view class="container {{fontClass}} {{darkClass}}">
  <!-- 头部：始终显示，含月份选择器（标题由导航栏承担，与设置页一致） -->
  <view class="section-head">
    <view class="overview-right">
      <text class="overview-year">{{yearText}}</text>
      <!-- 月份选择：原生 picker（mode="date" + fields="month"）即系统年月滚轮，
           与补录 / 编辑页的取向一致，省掉一整套自绘弹层与遮罩；
           start / end 把范围锁在「今年 -3 年 1 月」到「当前月」，不可选未来 -->
      <picker mode="date" fields="month" value="{{curYm}}" start="{{minYm}}" end="{{maxYm}}" bindchange="onMonthChange">
        <view class="overview-picker">
          <text class="overview-month">{{monthDisplay}}</text>
          <text class="overview-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="overview-add" bindtap="goBackfill">
      <text class="overview-add-icon">＋</text>
      <text>补录</text>
    </view>
  </view>

  <view class="record-section" wx:if="{{records.length > 0}}">
    <view class="record-list">
      <block wx:for="{{records}}" wx:key="id" wx:for-item="r" wx:for-index="idx">
        <view
          class="swipe-wrap"
          data-idx="{{idx}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
        >
          <view class="swipe-bg">
            <view
              class="swipe-edit"
              catchtap="editRecord"
              data-id="{{r.id}}"
            >编辑</view>
            <view
              class="swipe-del"
              catchtap="deleteRecord"
              data-id="{{r.id}}"
            >删除</view>
          </view>
          <view
            class="swipe-fg record-row"
            style="transform: translateX({{r._dx}}rpx); transition: {{r._anim ? 'transform 0.25s ease' : 'none'}};"
          >
            <view class="record-avatar">{{r.firstChar}}</view>
            <view class="record-main">
              <view class="record-line1">
                <text class="record-res-name">{{r.resourceName}}</text>
                <text class="record-date">{{r.dateText}}</text>
              </view>
              <view class="record-line2">
                <view class="record-tags">
                  <text class="weui-tag tag-stage">{{r.stageName}}</text>
                  <text class="weui-tag tag-group-{{r.groupKey}}">{{r.groupLabel}}</text>
                  <text class="weui-tag record-backfill" wx:if="{{r.backfilled}}">补录</text>
                  <text class="weui-tag record-remark" wx:if="{{r.remark}}">{{r.remark}}</text>
                </view>
                <view class="record-duration">
                  <text>{{r.durationText}}</text>
                  <!-- 熏听记录：时长后跟折算标记（×0.5 / ×0.8 / 不计入），与打卡弹窗一致 -->
                  <text class="record-factor" wx:if="{{r.factorText}}">{{r.factorText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="empty-wrap" wx:else>
    <view class="empty-icon">📖</view>
    <view class="empty-text">本月暂无打卡记录</view>
    <view class="empty-hint">在「路线」中点击资源即可开始打卡，或点上方「补录」补记</view>
  </view>
</view>
