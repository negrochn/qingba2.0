/* 打卡记录详情页：复用首页记录列表 + 月份选择器样式（支持深色模式） */

page {
  background: var(--bg);
}

.record-section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

/* 补录入口（右上角，次级按钮：弱化配色，避免抢眼） */
.overview-add {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  background: var(--cell-active);
  color: var(--text2);
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--fs, 1));
}

.overview-add:active {
  opacity: 0.6;
}

.overview-add-icon {
  font-size: calc(30rpx * var(--fs, 1));
  line-height: 1;
  color: var(--text3);
}

/* 月份选择器（头部右侧，与首页一致） */
.overview-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.overview-year {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

.overview-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: var(--cell-active);
  border-radius: 8rpx;
}

.overview-month {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  font-weight: 500;
}

.overview-arrow {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* ===== 滑动删除 ===== */
.swipe-wrap {
  position: relative;
  overflow: hidden;
}

.swipe-wrap:not(:last-child) .record-row::after {
  content: '';
  position: absolute;
  left: 148rpx;
  right: 28rpx;
  bottom: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: bottom;
}

.swipe-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 300rpx;                /* 编辑 + 删除 各 150rpx，与 records.js 的 SWIPE_W 保持一致 */
  display: flex;
  align-items: stretch;
}

.swipe-edit,
.swipe-del {
  flex: 1;
  height: 100%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
}

.swipe-edit { background: #c7c7cc; }   /* 中性灰：非破坏操作 */
.swipe-del  { background: #ff4d4f; }   /* 危险操作 */

.swipe-fg {
  position: relative;
  background: var(--card);
  z-index: 1;
}

.record-list {
  background: var(--card);
  overflow: hidden;
}

/* 单行记录 */
.record-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 32rpx;
  min-height: 144rpx;
  box-sizing: border-box;
}

/* 首字小图标 */
.record-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #5a9af0;
  color: #fff;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 第一行 */
.record-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-res-name {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.record-date {
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

/* 第二行 */
.record-line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

/* 本页标签统一收紧内边距与圆角（.weui-tag 基类默认 4rpx 16rpx / 8rpx，在密集列表里偏大）。
   集中写在这里，避免各标签各写一份、日后漏改。 */
.record-tags .weui-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 标签配色（阶段 / 分类 / 备注 / 补录）与字号、内边距均不在此处覆盖：
   配色统一收敛到 app.wxss「记录标签配色」一节（浅色档与深色档成对书写），
   字号 / 内边距走 .weui-tag 基类 + 上面的 .record-tags .weui-tag ——
   请勿在此重复定义，避免再次出现「只补浅色、漏补深色档」 */

.record-duration {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
  line-height: 1;
  align-self: flex-end;
  padding-bottom: 2rpx;
}

/* 熏听记录的折算标记（×0.5 / ×0.8 / 不计入）：紧跟原始时长，
   与打卡弹窗单位旁的那个标记同档（28rpx / --text3），弱于主数值的 34rpx / --text */
.record-factor {
  margin-left: 8rpx;
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 400;
  color: var(--text3);
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text2);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}
