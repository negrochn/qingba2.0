/* 打卡记录详情页：复用首页记录列表 + 月份选择器样式（支持深色模式） */

page {
  background: var(--bg);
}

.record-section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

/* 补录入口（右上角，次级按钮：弱化配色，避免抢眼） */
.overview-add {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  background: var(--cell-active);
  color: var(--text2);
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--fs, 1));
}

.overview-add:active {
  opacity: 0.6;
}

.overview-add-icon {
  font-size: calc(30rpx * var(--fs, 1));
  line-height: 1;
  color: var(--text3);
}

/* 月份选择器（头部右侧，与首页一致） */
.overview-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.overview-year {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

.overview-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: var(--cell-active);
  border-radius: 8rpx;
}

.overview-month {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  font-weight: 500;
}

.overview-arrow {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  transition: transform 0.2s;
}

.overview-arrow.up {
  transform: rotate(180deg);
}

/* ===== 滑动删除 ===== */
.swipe-wrap {
  position: relative;
  overflow: hidden;
}

.swipe-wrap:not(:last-child) .record-row::after {
  content: '';
  position: absolute;
  left: 148rpx;
  right: 28rpx;
  bottom: 0;
  height: 1px;
  background: var(--divider);
  transform: scaleY(0.5);
  transform-origin: bottom;
}

.swipe-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 300rpx;                /* 编辑 + 删除 各 150rpx，与 records.js 的 SWIPE_W 保持一致 */
  display: flex;
  align-items: stretch;
}

.swipe-edit,
.swipe-del {
  flex: 1;
  height: 100%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
}

.swipe-edit { background: #c7c7cc; }   /* 中性灰：非破坏操作 */
.swipe-del  { background: #ff4d4f; }   /* 危险操作 */

.swipe-fg {
  position: relative;
  background: var(--card);
  z-index: 1;
}

.record-list {
  background: var(--card);
  overflow: hidden;
}

/* 单行记录 */
.record-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 32rpx;
  min-height: 144rpx;
  box-sizing: border-box;
}

/* 首字小图标 */
.record-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #5a9af0;
  color: #fff;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 第一行 */
.record-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-res-name {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.record-date {
  flex-shrink: 0;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
}

/* 第二行 */
.record-line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.tag-stage {
  color: #7a5200;
  background: #fff7e6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 各分类标签颜色 */
.tag-group-main_picture_books { color: #1a5fb0; background: #e8f1fb; }
.tag-group-main_graded_readers { color: #4a26a8; background: #f0eafc; }
.tag-group-main_animations { color: #c4390e; background: #fff1ea; }
.tag-group-sub_graded_readers { color: #006d75; background: #e6fffb; }
.tag-group-sub_animations { color: #b0156e; background: #fff0f6; }
.tag-group-fun_extensions { color: #389e0d; background: #f0ffe0; }
.tag-group-science_extensions { color: #ad6800; background: #fffbe6; }
.tag-group-fusion_apps { color: #531dab; background: #f5f0ff; }
.tag-group-default { color: var(--text3); background: var(--cell-active); }

.record-remark {
  font-size: calc(28rpx * var(--fs, 1));
  color: #52c41a;
  background: #f0fff0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 补录标记（中性灰，弱于分类彩色标签） */
.record-backfill {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  background: var(--cell-active);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.record-duration {
  flex-shrink: 0;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
  line-height: 1;
  align-self: flex-end;
  padding-bottom: 2rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text2);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
}

/* ===== 月份选择器弹层（与首页一致） ===== */
.mp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 2000;
  pointer-events: none;
  transition: background 0.2s;
  display: flex;
  align-items: flex-end;
}

.mp-mask.show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.mp-sheet {
  width: 100%;
  background: var(--card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
}

.mp-title {
  text-align: center;
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
  font-weight: 600;
}

.mp-pv {
  width: 100%;
  height: 400rpx;
}

.mp-item {
  line-height: 80rpx;
  text-align: center;
  font-size: calc(30rpx * var(--fs, 1));
  color: var(--text);
}

/* picker-view 的内置蒙层是固定白色渐变，不跟随主题，深色下会在卡片上留下灰白块，
   用 mask-class 直接去掉。
   注意：indicator 覆盖在内容层之上，只能保持透明背景——填不透明底色会把选中行整行文字盖住；
   选中态改用主题色的上下细线标识。 */
.mp-pv-mask {
  background-image: none !important;
  background-color: transparent !important;
}

.mp-pv-indicator {
  background: transparent !important;
  /* 选中框自身不能用 transform（会把整个 80rpx 高的选中区压扁），故直接用 1px */
  border-top: 1px solid var(--divider);
  border-bottom: 1px solid var(--divider);
}

.mp-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.mp-btn {
  width: 45%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  border: none;
  padding: 0;
  line-height: 1;
}

.mp-btn::after {
  border: none;
}

.mp-cancel {
  background: var(--cell-active);
  color: var(--text2);
}

.mp-ok {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

/* ===== 深色模式适配（标签等彩色元素，全局 tag-group 见 app.wxss） ===== */
.dm-dark .tag-stage { color: #ffd666; background: rgba(255, 214, 102, 0.16); }

@media (prefers-color-scheme: dark) {
  .dm-auto .tag-stage { color: #ffd666; background: rgba(255, 214, 102, 0.16); }
}
