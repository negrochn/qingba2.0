/* 关于庆爸2.0 详情页 - 微信原生分组风格（标题与卡片样式与设置页统一，支持深色模式） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 顶部 banner（微信风格渐变卡片） ===== */
.page-banner {
  padding: 36rpx 24rpx 40rpx;
  text-align: center;
}

.banner-text {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  padding: 14rpx 44rpx;
  border-radius: 12rpx;
  letter-spacing: 4rpx;
}

/* ===== 章节标题（微信原生分组标题风格，与设置页 group-title 一致） ===== */
.chapter-head {
  padding: 16rpx 40rpx 12rpx;
}

.chapter-title {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.4;
}

/* ===== 章节卡片（微信原生卡片风格，与设置页 group-card 一致） ===== */
.chapter-card {
  margin: 0 24rpx 28rpx;
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  overflow: hidden;
}

/* ===== 段落 ===== */
.para {
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.65;
  color: var(--text2);
  margin-bottom: 24rpx;
  text-align: justify;
}

.para.highlight {
  color: #c0392b;
  font-weight: 500;
  background: #fff8f6;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #ff7a45;
}

/* ===== 列表 ===== */
.bullets {
  margin: 20rpx 0 28rpx;
  background: var(--card2);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.bullet {
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.8;
  color: var(--text2);
}

/* ===== 阶段块（卡片风格） ===== */
.stage-block {
  background: var(--card2);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.stage-block:last-child {
  margin-bottom: 12rpx;
}

.stage-name {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10rpx;
}

.stage-line {
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
  margin-bottom: 6rpx;
}

.stage-line:last-child {
  margin-bottom: 0;
}

.hl {
  color: #c0392b;
  font-weight: 600;
}

/* ===== 方法块 ===== */
.method-block {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.method-block:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.method-name {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin-bottom: 14rpx;
}

.method-op {
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.65;
  color: var(--text2);
  margin-bottom: 16rpx;
}

/* ===== 注意点块 ===== */
.warn-block {
  background: #fff6f2;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
  border-left: 4rpx solid #ff7a45;
}

.warn-title {
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 600;
  color: #c0392b;
  margin-bottom: 10rpx;
}

.warn-item {
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.65;
  color: var(--text2);
  margin-bottom: 6rpx;
}

.warn-item:last-child {
  margin-bottom: 0;
}

.warn-num {
  color: #ff7a45;
  font-weight: 600;
}

/* ===== 子块（小小优趣等） ===== */
.sub-block {
  background: var(--card2);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-top: 16rpx;
}

.sub-title {
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 600;
  color: #1a5fb0;
  margin-bottom: 10rpx;
}

.para-sm {
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
  margin-bottom: 10rpx;
}

.para-sm:last-child {
  margin-bottom: 0;
}

/* ===== 声明条 ===== */
.disclaimer {
  margin: 0 24rpx 28rpx;
  background: #eef6ff;
  border: 2rpx solid #cfe4fb;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.6;
  color: #4a6b8a;
  text-align: justify;
}

/* ===== 深色模式适配（微信小程序深色规范） ===== */
.dm-dark .para.highlight {
  background: #2a2016;
  color: #e57373;
}

.dm-dark .warn-block {
  background: #2a1f1a;
}

.dm-dark .warn-title,
.dm-dark .hl {
  color: #e57373;
}

.dm-dark .warn-num {
  color: #ff9c6e;
}

.dm-dark .sub-title {
  color: #7fb4f7;
}

.dm-dark .disclaimer {
  background: #1f2b3a;
  border-color: #2c3f52;
  color: #8fa8c0;
}

@media (prefers-color-scheme: dark) {
  .dm-auto .para.highlight {
    background: #2a2016;
    color: #e57373;
  }

  .dm-auto .warn-block {
    background: #2a1f1a;
  }

  .dm-auto .warn-title,
  .dm-auto .hl {
    color: #e57373;
  }

  .dm-auto .warn-num {
    color: #ff9c6e;
  }

  .dm-auto .sub-title {
    color: #7fb4f7;
  }

  .dm-auto .disclaimer {
    background: #1f2b3a;
    border-color: #2c3f52;
    color: #8fa8c0;
  }
}
