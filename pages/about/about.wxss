/* ====== 关于庆爸2.0 - 纯文章写法（WeUI article） ======
   整页 .weui-article：h1 大标题 + h2 章节 + p 段落 + section，无卡片框/列表框
   去除所有彩色背景块与渐变；重点用主色加粗（WeUI 标准强调）
   配色走全局 --* 令牌，深色模式自动跟随，无需 .dm-dark 重复规则

   字号对齐微信官方字体档位（设计指南 5.1）：22 / 17 / 15 / 14 / 12 pt
   小程序 750rpx 对应 375pt 基准 → 44 / 34 / 30 / 28 / 24 rpx；var(--fs) 跟随全局字体缩放 */

/* ===== WeUI 文章原语（官方 article 体系） ===== */
.weui-article {
  padding: 48rpx 32rpx 40rpx;
  font-size: calc(30rpx * var(--fs, 1));   /* 15pt 正文基准 */
  color: var(--text2);
  line-height: 1.65;
}
.weui-article__h2 {                       /* 章节标题 17pt */
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin: 40rpx 0 16rpx;
}
.weui-article__p {                        /* 正文 15pt */
  font-size: calc(30rpx * var(--fs, 1));
  line-height: 1.65;
  color: var(--text2);
  margin-bottom: 16rpx;
}
.weui-article__p:last-child { margin-bottom: 0; }

/* ===== 文章内语义类 ===== */
.about-desc {                             /* 副标题 14pt */
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text3);
  margin-bottom: 8rpx;
}
.about-note {                             /* 辅助说明 12pt */
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  text-align: justify;
}
.about-strong-p {                         /* 重点提示段：主色（区别于周围次级灰） */
  color: var(--text);
  font-weight: 500;
}
.about-strong {                           /* 行内/序号强调：主色加粗（替代原红字 .hl） */
  color: var(--text);
  font-weight: 600;
}
.about-li {                               /* 列表项（· 前缀），继承正文 15pt */
  color: var(--text2);
}

/* ===== 阶段参考（文章内段落式，无 cell 框） ===== */
.about-stage { margin-bottom: 20rpx; }
.about-stage:last-child { margin-bottom: 0; }
.about-stage__name {                      /* 阶段名 17pt 加粗 */
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
}
.about-stage__line {                      /* 标准 15pt */
  font-size: calc(30rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--text2);
  margin-top: 6rpx;
}

/* ===== 使用说明（方式分区，文章内间距分隔，无卡片框） ===== */
.about-method { margin-bottom: 32rpx; }
.about-method:last-child { margin-bottom: 0; }
.about-method__name {                     /* 方式名 17pt 加粗 */
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}
.about-sub {                              /* 子标题 15pt 加粗 */
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  margin: 16rpx 0 8rpx;
}
