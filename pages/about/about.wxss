/* 关于庆爸2.0 详情页 - 方案A：章节卡片 */

page {
  background: #f5f6f8;
}

.container {
  padding: 0 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 顶部 banner ===== */
.page-banner {
  padding: 48rpx 32rpx 36rpx;
  text-align: center;
}

.banner-text {
  display: inline-block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 24rpx rgba(74, 144, 217, 0.3);
}

/* ===== 章节卡片 ===== */
.chapter-card {
  margin: 0 28rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(60, 90, 140, 0.06);
  border: 2rpx solid #e8eef7;
}

/* 章节标题行 */
.chapter-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.chapter-accent {
  width: 6rpx;
  height: 36rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4a90d9 0%, #6ab0f3 100%);
}

.chapter-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

/* ===== 段落 ===== */
.para {
  font-size: 28rpx;
  line-height: 1.65;
  color: #3a4556;
  margin-bottom: 24rpx;
  text-align: justify;
}

.para.highlight {
  color: #c0392b;
  font-weight: 500;
  background: #fff8f6;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #ff7a45;
}

/* ===== 列表 ===== */
.bullets {
  margin: 20rpx 0 28rpx;
  padding-left: 8rpx;
  background: #f8fafd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.bullet {
  font-size: 28rpx;
  line-height: 1.8;
  color: #3a4556;
}

/* ===== 阶段块（卡片风格） ===== */
.stage-block {
  background: #f8fafd;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e8eef7;
}

.stage-block:last-child {
  margin-bottom: 12rpx;
}

.stage-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a3b72;
  margin-bottom: 10rpx;
}

.stage-line {
  font-size: 26rpx;
  line-height: 1.6;
  color: #4a5568;
  margin-bottom: 6rpx;
}

.stage-line:last-child {
  margin-bottom: 0;
}

.hl {
  color: #c0392b;
  font-weight: 600;
}

/* ===== 方法块 ===== */
.method-block {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.method-block:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.method-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a3b72;
  margin-bottom: 14rpx;
  padding-left: 14rpx;
  border-left: 4rpx solid #4a90d9;
}

.method-op {
  font-size: 26rpx;
  line-height: 1.65;
  color: #3a4556;
  margin-bottom: 16rpx;
}

/* ===== 注意点块 ===== */
.warn-block {
  background: #fff6f2;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
  border-left: 4rpx solid #ff7a45;
}

.warn-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #c0392b;
  margin-bottom: 10rpx;
}

.warn-item {
  font-size: 26rpx;
  line-height: 1.65;
  color: #3a4556;
  margin-bottom: 6rpx;
}

.warn-item:last-child {
  margin-bottom: 0;
}

.warn-num {
  color: #ff7a45;
  font-weight: 600;
}

/* ===== 子块（小小优趣等） ===== */
.sub-block {
  background: #f0f7ff;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-top: 16rpx;
  border: 2rpx solid #d6e8fc;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a5fb0;
  margin-bottom: 10rpx;
}

.para-sm {
  font-size: 26rpx;
  line-height: 1.6;
  color: #3a4556;
  margin-bottom: 10rpx;
}

.para-sm:last-child {
  margin-bottom: 0;
}

/* ===== 声明条 ===== */
.disclaimer {
  margin: 0 28rpx 24rpx;
  background: #eef6ff;
  border: 2rpx solid #cfe4fb;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4a6b8a;
  text-align: justify;
}
