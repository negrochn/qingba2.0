<view class="container {{fontClass}} {{darkClass}}">

  <!-- 数据说明卡：风险提示 + 上次备份时间 -->
  <view class="db-intro">
    <view class="db-intro__title">数据保存在本机</view>
    <view class="db-intro__desc">打卡记录、孩子资料与自定义资源都保存在手机微信的本地存储中。移除小程序、清理微信存储空间或更换手机都会导致数据丢失且无法找回，请定期备份。</view>
    <view class="db-intro__meta">上次备份：{{lastBackupText || '从未备份'}}</view>
    <view class="db-intro__warn" wx:if="{{remindText}}">{{remindText}}</view>
  </view>

  <view class="weui-cells__title">备份</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" bindtap="onBackup">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">立即备份</view>
        <view class="weui-cell__desc">生成备份文件，发送到「文件传输助手」或好友</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goImportPicker">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">从备份恢复</view>
        <view class="weui-cell__desc">从聊天记录选择 txt / json / word 备份文件</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <view class="weui-cells__tips">备份包含全部孩子的数据；建议每月备份一次，发送到「文件传输助手」便于随时找回。</view>

</view>

<!-- 导入备份 · 选孩子（v2 单孩格式：导入到所选孩子名下；v3 多孩格式整体恢复不经过此处） -->
<half-sheet
  show="{{importPickVisible}}"
  title="导入到哪个孩子"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeImportPick"
>
  <view class="imp-list">
    <view
      class="imp-row"
      wx:for="{{importPickItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onImportPickChild"
      hover-class="imp-row-hover"
    >
      <view class="cp-av cp-av--{{item.color}}">{{item.initial}}</view>
      <view class="imp-name">{{item.name}}</view>
      <text class="weui-icon-checked iconfont icon-check" hidden="{{!item.active}}"></text>
    </view>
  </view>
  <view class="imp-note">备份数据将与所选孩子的现有数据合并，当前孩子的其他设置保持不变</view>
  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closeImportPick">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="confirmImportPick">导入</button>
  </view>
</half-sheet>
