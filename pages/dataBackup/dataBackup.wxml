<view class="container {{fontClass}} {{darkClass}}">

  <!-- 数据说明卡三态（标题/描述由页面 refreshBackupState 计算）：云端快照 > 文件备份 > 数据保存在本机；
       无云时展示丢失风险告知（转化位，不可省）；已有云端快照时只留状态行——
       快照详情已在下方「备份到云端」副文案，desc 属重复教育 -->
  <view class="db-intro">
    <view class="db-intro__head">
      <view class="db-intro__title">{{backupTitle}}</view>
      <text class="db-member-tag" wx:if="{{isMember}}">永久会员</text>
    </view>
    <view class="db-intro__desc" wx:if="{{backupDesc}}">{{backupDesc}}</view>
    <view class="db-intro__meta">{{lastBackupMeta}}</view>
    <view class="db-intro__warn" wx:if="{{remindText}}">{{remindText}}</view>
  </view>

  <!-- 云备份（主路径：云端快照的备份 / 恢复 / 删除） -->
  <view class="weui-cells__title">云备份</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" bindtap="onCloudBackup">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text db-title-row">备份到云端<text class="db-badge">推荐</text></view>
        <view class="weui-cell__desc">{{cloudStateText ? '云端快照：' + cloudSizeText : (cloudEntText || '暂无快照')}}</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value" wx:if="{{cloudTimeText}}">{{cloudTimeText}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <!-- 购买/邀请码入口已迁「会员中心」页（4.5.0 工具页去商业化）：
         非会员转化走「我的-会员中心」+ 备份被拦时的解锁弹层，页面回归纯工具 -->
    <view class="weui-cell weui-cell_access" bindtap="onCloudRestore">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">从云端恢复</view>
        <!-- 常驻可点：换手机本地缓存未拉到时 hasCloud 短暂为 false，但云端可能有快照，
             隐藏/拦截会挡住最需要恢复的人；desc 只做两态教育，点击仍真实查云端兜底 -->
        <view class="weui-cell__desc">{{hasCloud ? '用云端快照覆盖本机数据（换手机、误删找回）' : '暂无快照，完成云备份后可在此一键恢复'}}</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" wx:if="{{hasCloud}}" bindtap="onDeleteCloud">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text db-danger">删除云端备份</view>
        <view class="weui-cell__desc">删除后无法找回，本机数据不受影响</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <!-- 文件备份（多版本留存） -->
  <view class="weui-cells__title">文件备份</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" bindtap="onBackup">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">备份到文件</view>
        <view class="weui-cell__desc">发送到聊天，可长期留存多个版本</view>
      </view>
      <view class="weui-cell__ft">
        <text class="weui-cell__ft_value" wx:if="{{fileBackupText}}">{{fileBackupText}}</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="weui-cell weui-cell_access" bindtap="goImportPicker">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">从文件恢复</view>
        <view class="weui-cell__desc">从聊天记录选择 txt / json / word 备份文件</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <!-- 危险操作（原设置页「数据管理」迁入：范围在 clearPicker 选择，返回后二次确认执行） -->
  <view class="weui-cells__title">危险操作</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access weui-cell_warn" bindtap="goClearPicker">
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text">清空数据</view>
        <view class="weui-cell__desc">清空本机打卡记录与练习进度，自定义资源与云端备份不受影响</view>
      </view>
      <view class="weui-cell__ft">
        <text class="iconfont icon-right"></text>
      </view>
    </view>
  </view>

  <view class="weui-cells__tips">云端保留 1 份最新快照，换手机登录同一微信即可恢复；备份需<text class="db-link" bindtap="goMembership">永久会员</text>或看视频解锁（每日最多 5 次），恢复与删除永久免费。文件备份由自己留存，可保留多个版本，重要数据建议两者都用。</view>

</view>

<!-- 导入备份 · 选孩子（v2 单孩格式：导入到所选孩子名下；v3 多孩格式整体恢复不经过此处） -->
<half-sheet
  show="{{importPickVisible}}"
  title="导入到哪个孩子"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeImportPick"
>
  <view class="imp-list">
    <view
      class="imp-row"
      wx:for="{{importPickItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onImportPickChild"
      hover-class="imp-row-hover"
    >
      <view class="cp-av cp-av--{{item.color}}">{{item.initial}}</view>
      <view class="imp-name">{{item.name}}</view>
      <text class="weui-icon-checked iconfont icon-check" hidden="{{!item.active}}"></text>
    </view>
  </view>
  <view class="imp-note">备份数据将与所选孩子的现有数据合并，当前孩子的其他设置保持不变</view>
  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="closeImportPick">取消</button>
    <button class="weui-btn weui-btn_primary" bindtap="confirmImportPick">导入</button>
  </view>
</half-sheet>

<!-- 云备份解锁选择（替代系统 showModal：三动作——看视频 / 开通会员 / 暂不；
     开通会员跳会员中心页，购买完成后返回重按备份即走会员通道） -->
<half-sheet
  show="{{unlockVisible}}"
  title="解锁云备份"
  font-class="{{fontClass}}"
  dark-class="{{darkClass}}"
  footer="{{true}}"
  bind:close="closeUnlock"
>
  <view class="unlock-body">
    <view class="unlock-buy" bindtap="unlockByBuy" hover-class="unlock-buy-hover">
      <view class="unlock-buy__bd">
        <view class="unlock-buy__title">开通永久会员<text class="db-badge db-badge--gold">早鸟价</text></view>
        <view class="unlock-buy__desc">不限次数备份，无需再看视频</view>
      </view>
      <view class="unlock-buy__ft">
        <text class="unlock-buy__price">¥9.9</text>
        <text class="iconfont icon-right"></text>
      </view>
    </view>
    <view class="unlock-note">不想开通也可以看一段短视频免费解锁本次备份</view>
  </view>
  <view slot="footer" class="weui-btn-area_inline">
    <button class="weui-btn weui-btn_default" bindtap="cancelUnlock">暂不</button>
    <button class="weui-btn weui-btn_primary" bindtap="unlockByAd">看视频解锁</button>
  </view>
</half-sheet>
