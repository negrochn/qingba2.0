/* 数据管理页 - WeUI 风格，组件原语见全局 app.wxss（.weui-cells / .weui-cell 等） */
page {
  background: var(--bg);
}

/* ===== 数据说明卡 ===== */
.db-intro {
  margin: 24rpx 32rpx 8rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);
}

.db-intro__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.db-intro__title {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}

.db-intro__desc {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.6;
}

.db-intro__meta {
  margin-top: 24rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

.db-intro__warn {
  margin-top: 8rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--danger);              /* WeUI RED，同全项目惯例（裸引用） */
  line-height: 1.5;
}

/* 底部补充说明：走全局 .weui-cells__tips（styles/weui-cells.wxss），本页不再自定义 */

/* ===== 云备份「推荐」徽标（品牌绿） =====
   标题行用 flex 居中：vertical-align: middle 对齐的是基线+x-height/2 而非行盒中点，
   徽标与标题字号差异大时视觉必偏，flex 才是真居中 */
.db-title-row {
  display: flex;
  align-items: center;
}

.db-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #fff;
  font-size: calc(20rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.4;
}

/* 会员「早鸟价」徽标（金）与说明卡会员标识 */
.db-badge--gold {
  background: #d29a3a;
}

.db-member-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #d29a3a;
  color: #fff;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1.4;
}

/* ===== 删除云端备份：危险操作标题红，desc 保持中性弱化 ===== */
.db-danger {
  color: var(--danger);
}

/* ===== 导入备份 · 选孩子弹层（v2 单孩格式） ===== */
.imp-list {
  padding: 0 32rpx 8rpx;
}

.imp-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: background-color 0.15s ease;
}

.imp-row-hover {
  background: var(--cell-active);
}

.imp-name {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  font-size: calc(32rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.4;
}

/* 对勾：对齐 .weui-cells_radio .weui-icon-checked 的品牌绿样式
   （本弹层不在 cells_radio 容器内，拿不到那条全局规则） */
.imp-row .weui-icon-checked {
  font-size: calc(44rpx * var(--fs, 1));
  color: var(--brand);
  line-height: 1;
  flex-shrink: 0;
}

.imp-note {
  padding: 8rpx 48rpx 24rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

/* ===== 云备份解锁选择弹层（三动作：看视频 / 开通会员 / 暂不） ===== */
/* 顶部风险告知行：数据丢失痛点前置（转化位），text2 比正文弱一档、比 note 醒目 */
.unlock-risk {
  padding: 4rpx 8rpx 16rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.6;
}
.unlock-buy {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
}
.unlock-buy-hover {
  background: var(--bg);
}
.unlock-buy__bd {
  flex: 1;
  min-width: 0;
}
.unlock-buy__title {
  display: flex;
  align-items: center;
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
}
.unlock-buy__desc {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}
.unlock-buy__ft {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--text3);
}
.unlock-buy__price {
  margin-right: 8rpx;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: #d29a3a;
}
.unlock-note {
  padding: 4rpx 8rpx 8rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}
.db-link {
  color: var(--brand);
}
