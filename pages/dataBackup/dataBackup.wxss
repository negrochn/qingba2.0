/* 数据管理页 - WeUI 风格，组件原语见全局 app.wxss（.weui-cells / .weui-cell 等） */
page {
  background: var(--bg);
}

/* ===== 数据说明卡 ===== */
.db-intro {
  margin: 24rpx 32rpx 8rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--card);
}

.db-intro__title {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}

.db-intro__desc {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.6;
}

.db-intro__meta {
  margin-top: 24rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

.db-intro__warn {
  margin-top: 8rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--danger);              /* WeUI RED，同全项目惯例（裸引用） */
  line-height: 1.5;
}

/* 底部补充说明：走全局 .weui-cells__tips（styles/weui-cells.wxss），本页不再自定义 */

/* ===== 云备份「推荐」徽标（品牌绿） =====
   标题行用 flex 居中：vertical-align: middle 对齐的是基线+x-height/2 而非行盒中点，
   徽标与标题字号差异大时视觉必偏，flex 才是真居中 */
.db-title-row {
  display: flex;
  align-items: center;
}

.db-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #fff;
  font-size: calc(20rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.4;
}

/* 会员「早鸟价」徽标（金）与说明卡会员标识 */
.db-badge--gold {
  background: #d29a3a;
}

/* 购买行右侧价格：与「早鸟价」徽标同金色（价格即诱因，独立成列最醒目） */
.db-price {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: #d29a3a;
  line-height: 1.41176471;
}

.db-member-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #d29a3a;
  color: #fff;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1.4;
}

/* ===== 删除云端备份：危险操作标题红，desc 保持中性弱化 ===== */
.db-danger {
  color: var(--danger);
}

/* ===== 导入备份 · 选孩子弹层（v2 单孩格式） ===== */
.imp-list {
  padding: 0 32rpx 8rpx;
}

.imp-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: background-color 0.15s ease;
}

.imp-row-hover {
  background: var(--cell-active);
}

.imp-name {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  font-size: calc(32rpx * var(--fs, 1));
  color: var(--text);
  line-height: 1.4;
}

/* 对勾：对齐 .weui-cells_radio .weui-icon-checked 的品牌绿样式
   （本弹层不在 cells_radio 容器内，拿不到那条全局规则） */
.imp-row .weui-icon-checked {
  font-size: calc(44rpx * var(--fs, 1));
  color: var(--brand);
  line-height: 1;
  flex-shrink: 0;
}

.imp-note {
  padding: 8rpx 48rpx 24rpx;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--text3);
  line-height: 1.5;
}

/* ===== 邀请码兑换弹层（WeUI 表单口径，与编辑记录页输入行同构） ===== */
.redeem-cell {
  padding-top: 12rpx;
  padding-bottom: 12rpx;   /* 88rpx 输入框 + 12×2 = 112rpx 行高（WeUI cell 56px 口径） */
}

.redeem-cell .weui-cell__bd {
  flex: none;              /* 标签仅两字不参与宽度分配，剩余宽度全让给输入框 */
}

.redeem-ft {
  max-width: none;
  flex: 1;
}

.redeem-input {
  width: 100%;
  height: 88rpx;           /* 「可点项最小热区」口径 */
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  text-align: right;       /* WeUI 表单：标签左、值右 */
}

.redeem-input-ph {
  color: var(--text3);
}
