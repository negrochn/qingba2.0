/* 清空范围选择页 - 原语 3：picker-page（整页单选列表，选中绿色对勾，支持深色模式） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组（原语 1 .group，无 group-title） ===== */
.group {
  margin-bottom: 24rpx;
}

.group-card {
  background: var(--card);
  margin: 0; /* 全宽平铺，无侧边距（微信分组 section 无 margin / 无圆角） */
  border-radius: 0;
  overflow: hidden;
}


