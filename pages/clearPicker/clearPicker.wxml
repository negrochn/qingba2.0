<view class="container {{fontClass}} {{darkClass}}">

  <!-- 清空范围选择（整页单选列表，选中品牌绿对勾） -->
  <view class="weui-cells weui-cells_radio">
    <block wx:if="{{scopes.length > 0}}">
      <block wx:for="{{scopes}}" wx:key="key" wx:for-item="s" wx:for-index="i">
        <view class="weui-cell" bindtap="pick" data-key="{{s.key}}">
          <view class="weui-cell__bd">{{s.name}}</view>
          <text class="weui-icon-checked iconfont icon-check" hidden="{{selectedKey !== s.key}}"></text>
        </view>
      </block>
    </block>
    <view wx:else class="weui-cell_empty">暂无数据可清空</view>
  </view>

</view>
