/* 时长统计页 - wx-charts 版本 */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 顶部控制区（Tab + 周期导航） ===== */
.top-bar {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs-container {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 0;
  gap: 96rpx;
}

.tab-item {
  position: relative;
  padding: 16rpx 0 20rpx;
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
  transition: color 0.2s;
}

.tab-item.active {
  color: #1a1a1a;
  font-weight: 600;
  font-size: 32rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #5ba8e6 0%, #4a90d9 100%);
  border-radius: 3rpx;
}

.period-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0 24rpx;
}

.period-nav.nav-hidden .nav-btn {
  visibility: hidden;
}

.period-nav.nav-hidden .nav-label {
  font-weight: 500;
}

.nav-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #f8f8f8;
  border-radius: 50%;
  transition: all 0.2s;
}

.nav-btn:active {
  background: #e8e8e8;
  transform: scale(0.95);
}

.nav-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 400;
  min-width: 260rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

/* ===== 数据卡片（对齐首页打卡概览风格） ===== */
.stats-card {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(60, 90, 140, 0.06);
}

.sum-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fff;
  border-radius: 20rpx;
  row-gap: 10rpx;
}

.sg-cell {
  position: relative;
  text-align: center;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
}

.sg-tr::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18%;
  bottom: 18%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent 0%, #e5e9f0 30%, #e5e9f0 70%, transparent 100%);
}

.sg-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.sg-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.sg-val {
  font-size: 52rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.05;
  font-family: 'DIN Alternate', -apple-system, Helvetica, Arial, sans-serif;
}

.sg-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a8f99;
}

/* ===== 图表卡片 ===== */
.chart-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #ccc;
  gap: 16rpx;
}

.empty-state::before {
  content: '📊';
  font-size: 80rpx;
}
