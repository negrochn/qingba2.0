<view class="container {{fontClass}} {{darkClass}}">

  <!-- 顶部阶段选择（独立于所有模块） -->
  <view class="section-head">
    <picker class="stage-picker" mode="selector" range="{{stageOptions}}" range-key="name" value="{{stageIndex}}" bindchange="onStagePick">
      <view class="stage-picker-inner">
        <text class="stage-picker-label">{{currentStageName}}</text>
        <text class="overview-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 概览（无标题） -->
  <view class="group">
    <view class="group-card overview-card">
      <view class="overview-item">
        <text class="overview-num">{{totalMinutesText}}</text>
        <text class="overview-cap">累计时长</text>
      </view>
      <view class="overview-item">
        <text class="overview-num">{{activeDays}}</text>
        <text class="overview-cap">打卡天数</text>
      </view>
    </view>
  </view>

  <!-- 时长分布（切换控件在卡片内部第一行右侧） -->
  <view class="group">
    <view class="group-title">时长分布</view>
    <view class="group-card">
      <view class="card-head">
        <view class="seg">
          <view class="seg-item {{distMode === 'group' ? 'on' : ''}}" data-mode="group" bindtap="onDistModeChange">按分组</view>
          <view class="seg-item {{distMode === 'book' ? 'on' : ''}}" data-mode="book" bindtap="onDistModeChange">按绘本</view>
        </view>
      </view>

      <block wx:if="{{distMode === 'group'}}">
        <view class="bar-row" wx:for="{{groupList}}" wx:key="groupKey">
          <text class="bar-label">{{item.groupLabel}}</text>
          <view class="bar-track">
            <view class="bar-fill" style="width:{{item.ratio}}%;background:{{item.color}};"></view>
          </view>
          <text class="bar-val">{{item.minutesText}}</text>
        </view>
        <view class="empty-tip" wx:if="{{groupList.length === 0}}">该阶段暂无打卡记录</view>
      </block>

      <block wx:else>
        <view class="bar-row book-row" wx:for="{{bookList}}" wx:key="resourceName">
          <text class="bar-label book-name">{{item.resourceName}}</text>
          <view class="bar-track">
            <view class="bar-fill" style="width:{{item.ratio}}%;background:{{item.color}};"></view>
          </view>
          <text class="bar-val">{{item.minutesText}}</text>
        </view>
        <view class="empty-tip" wx:if="{{bookList.length === 0}}">该阶段暂无打卡记录</view>
      </block>
    </view>
  </view>

  <!-- 每月时长 -->
  <view class="group">
    <view class="group-title">每月时长</view>
    <view class="group-card">
      <view class="bar-row month-row" wx:for="{{monthlyList}}" wx:key="ym">
        <text class="bar-label">{{item.monthText}}</text>
        <view class="bar-track">
          <view class="bar-fill" style="width:{{item.ratio}}%;background:{{item.color}};"></view>
        </view>
        <text class="bar-val">{{item.minutesText}}</text>
      </view>
      <view class="empty-tip" wx:if="{{monthlyList.length === 0}}">该阶段暂无打卡记录</view>
    </view>
  </view>

  <!-- 读完排行 -->
  <view class="group">
    <view class="group-title">读完排行<text class="group-title-sub">（{{readTotal}}次）</text></view>
    <view class="group-card">
      <view class="read-row" wx:for="{{readList}}" wx:key="resourceName">
        <view class="read-dot" style="background:{{item.color}};"></view>
        <text class="read-name">{{item.resourceName}}</text>
        <text class="read-count">读完 {{item.count}} 次</text>
      </view>
      <view class="empty-tip" wx:if="{{readList.length === 0}}">该阶段暂无读完记录</view>
    </view>
  </view>

</view>
