/* 字体大小选择页 - 原语 3：picker-page（整页单选列表，选中绿色对勾，支持深色模式） */

page {
  background: var(--bg);
}

.container {
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 分组（原语 1 .group，无 group-title） ===== */
.group {
  margin-bottom: 24rpx;
}

.group-card {
  background: var(--card);
  margin: 0; /* 全宽平铺，无侧边距（微信分组 section 无 margin / 无圆角） */
  border-radius: 0;
  overflow: hidden;
}

/* ===== 列表项（.cell 基类 + 单选变体） ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx; /* cell-h 88rpx（点击热区） */
  padding: 24rpx 32rpx; /* cell-pad-x：左右 32rpx 对称 */
  box-sizing: border-box;
}

.cell:active {
  background: var(--cell-active);
}

.cell-label {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: calc(34rpx * var(--fs, 1)); /* 原语：row 主文 34rpx */
  color: var(--text);
}

/* 原语 3：单选对勾（success 绿；深色 #30D158） */
.cell-radio {
  /* 继承 .cell 基类，无需重写高度 / 内边距 / 按下态 */
}

.cell-check {
  font-size: calc(34rpx * var(--fs, 1)); /* 对勾约 34rpx */
  color: #34C759; /* success */
  line-height: 1;
  flex-shrink: 0;
}

/* 分隔线：左缩进 32rpx（cell-pad-x），spec divider-row */
.cell-divider {
  height: 1rpx;
  background: var(--divider);
  margin-left: 32rpx;
}

/* 深色模式：对勾转深色 success */
.dm-dark .cell-check {
  color: #30D158;
}

@media (prefers-color-scheme: dark) {
  .dm-auto .cell-check {
    color: #30D158;
  }
}
