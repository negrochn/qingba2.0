/* ===== 会员中心 ===== */

/* 「已开通」：会员态的值位，纯金色文字（字号 / 行高走 .weui-cell 默认 34rpx，
   与非会员的 ¥9.9 同一位置、同一视觉重量；不套徽标底色，避免右侧出现两套值位样式） */
.ms-tag {
  color: #d29a3a;
}

/* 非会员状态卡右侧价格（金色，价格即诱因） */
.ms-price {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: #d29a3a;
  line-height: 1.41176471;
}

/* 开通按钮：金底白字（与价格同一金色系） */
.ms-btn-gold {
  background: #d29a3a;
  color: #fff;
}

/* 权益行对勾：位置 / 尺寸对齐「建议区间上限」单选 cell（右端、44rpx、不收缩），
   颜色沿用本页金色系（与价格、按钮同源），不引单选 cell 的品牌绿 —— 一页只留一套强调色。
   !important 与 .weui-cells_radio .weui-icon-checked 同款写法，压掉 .iconfont 的 32rpx 默认字号 */
.ms-benefit-check {
  flex-shrink: 0;
  font-size: calc(44rpx * var(--fs, 1)) !important;
  color: #d29a3a;
  line-height: 1;
}

/* ===== 邀请码兑换弹层（自数据管理页迁入，样式同构） ===== */
.redeem-cell {
  padding-top: 12rpx;
  padding-bottom: 12rpx;   /* 88rpx 输入框 + 12×2 = 112rpx 行高（WeUI cell 56px 口径） */
}

.redeem-cell .weui-cell__bd {
  flex: none;              /* 标签仅两字不参与宽度分配，剩余宽度全让给输入框 */
}

.redeem-ft {
  max-width: none;
  flex: 1;
}

.redeem-input {
  width: 100%;
  height: 88rpx;           /* 「可点项最小热区」口径 */
  font-size: calc(34rpx * var(--fs, 1));
  color: var(--text);
  text-align: right;       /* WeUI 表单：标签左、值右 */
}

.redeem-input-ph {
  color: var(--text3);
}
