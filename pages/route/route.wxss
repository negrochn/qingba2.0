/* ===== 路线页（WeUI 风格：顶部当前阶段高亮卡 + 时间线分组列表） ===== */

/* ① 当前阶段：weui-cell 结构 + 浅品牌绿底突出（无阴影，圆角同 WeUI panel） */
.current-panel {
  overflow: hidden;
  background: rgba(7, 193, 96, 0.10);
}
/* 圆角卡片不需要 weui-cells 的上下通栏线 */
.current-panel::before,
.current-panel::after { display: none; }

.current-cell { background: transparent; }
.current-cell:active { background: rgba(7, 193, 96, 0.16); }
.current-cell-hover  { background: rgba(7, 193, 96, 0.16); }

/* ② 时间线列表：行首节点 + 竖向连接线 */
.route-cell {
  align-items: stretch;                    /* 节点列撑满行高，供连接线延伸 */
}

.route-node-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  padding-top: 4rpx;
}

.route-node {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs, 1));   /* 12px 辅助 */
  font-weight: 600;
  background: var(--card2);
  color: var(--text3);
  box-sizing: border-box;
}
.route-node .iconfont {
  font-size: calc(24rpx * var(--fs, 1)) !important;
  font-weight: normal;
}

.route-node.current { background: var(--brand); color: #fff; }
.route-node.done    { background: rgba(7, 193, 96, 0.15); color: var(--brand); }
.route-node.locked  { background: var(--card2); color: var(--text3); }

/* 连接线：填满节点下方剩余高度（末行无线） */
.route-node-line {
  flex: 1;
  width: 1rpx;
  background: var(--divider);
  margin-top: 8rpx;
}

/* ③ 阶段名 / 副信息 */
.route-name {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文 */
  font-weight: 500;
  color: var(--text);
}
.route-meta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
  line-height: 1.5;
}

/* ③-b 进入 / 晋级条件（弱化说明，1rpx 分隔线与主信息区隔开） */
.route-req {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--divider);
}
.route-req-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}
.route-req-row:first-child { margin-top: 0; }
.route-req-label {
  flex-shrink: 0;
  width: 72rpx;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
}
.route-req-value {
  flex: 1;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
  line-height: 1.5;
}

/* ④ 状态徽标：扁平 chip，与标题顶部对齐 */
.route-cell .weui-cell__ft {
  align-items: flex-start;
  padding-top: 4rpx;
}
.route-chip {
  flex-shrink: 0;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--fs, 1));
  line-height: 1.3;
}
.route-chip.current { color: #fff;      background: var(--brand); }
.route-chip.done    { color: var(--brand); background: rgba(7, 193, 96, 0.12); }
.route-chip.locked  { color: var(--text2); background: var(--card2); }

/* ⑤ 深色：仅高亮卡底色需加深，其余走变量自动适配 */
.dm-dark .current-panel { background: rgba(7, 193, 96, 0.18); }
@media (prefers-color-scheme: dark) {
  .dm-auto .current-panel { background: rgba(7, 193, 96, 0.18); }
}
