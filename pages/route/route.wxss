/* 路线页卡 - 时间线布局 */

.container {
  padding: 24rpx 32rpx 48rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 头部 */
.route-header {
  padding: 32rpx 0 28rpx;
}

.route-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.route-sub {
  font-size: 26rpx;
  color: #888;
}

/* 时间线容器 */
.timeline {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 阶段项 */
.stage-item {
  display: flex;
  align-items: stretch;
  padding: 16rpx 32rpx;
}

.stage-hover {
  background: #f8fafc;
}

/* 左侧轨道 */
.stage-rail {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 阶段节点 */
.stage-node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #4a90d9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 0 6rpx #fff, 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
}

.node-num {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.stage-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(to bottom, #dfe4ea, #eef2f6);
  margin-top: 10rpx;
  min-height: 48rpx;
}

/* 右侧内容 */
.stage-body {
  flex: 1;
  padding: 4rpx 0 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.stage-item:last-child .stage-body {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.stage-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stage-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.stage-phase {
  font-size: 22rpx;
  color: #4a90d9;
  background: #eef4fb;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.stage-arrow {
  font-size: 40rpx;
  color: #c0c8d0;
  font-weight: 300;
}

.stage-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.stage-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-entry {
  color: #7a5200;
  background: #fff7e6;
}

.tag-promote {
  color: #1a5fb0;
  background: #e8f1fb;
}
