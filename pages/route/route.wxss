.route-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stage {
  display: flex;
  align-items: stretch;
}

.stage-hover {
  background: #f9fbfd;
}

.rail {
  position: relative;
  width: 72rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #4a90d9;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 0 8rpx #fff;
}

.node-end {
  background: #f0a020;
}

.line {
  width: 4rpx;
  flex: 1;
  background: #e3e8ee;
  margin-top: 8rpx;
  margin-bottom: -2rpx;
}

.content {
  flex: 1;
  padding: 2rpx 0 32rpx 16rpx;
}

.stage-end .content {
  padding-bottom: 12rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.target {
  font-size: 22rpx;
  color: #4a90d9;
  background: #eef4fb;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.target-end {
  color: #b06800;
  background: #fff3da;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: #555;
  background: #f4f5f7;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
