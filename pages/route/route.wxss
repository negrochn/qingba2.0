/* ===== 路线页（WeUI 风格：顶部当前阶段入口 + 时间线分组列表） ===== */

/* ① 当前阶段：高亮底色只作用于「当前」那一行（.current-cell）；
      容器回归 .weui-cells 默认（白底 + 上下通栏线），与下方「学习路线」组外观一致 */
.current-cell { background: rgba(7, 193, 96, 0.10); }
.current-cell:active { background: rgba(7, 193, 96, 0.18); }
.current-cell-hover  { background: rgba(7, 193, 96, 0.18); }

/* ② 时间线列表：右侧节点（weui-cell__ft）+ 竖向连接线 */
.route-cell {
  align-items: stretch;                    /* 节点列撑满行高，供连接线延伸 */
}

.route-node-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4rpx;
}

.route-node {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text3);   /* 描边式节点：状态由 border-color 区分 */
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card2);
  color: var(--text3);
  box-sizing: border-box;
}
.route-node .iconfont {
  font-size: calc(34rpx * var(--fs, 1)) !important;
}

.route-node.current { border: 0; background: transparent; }   /* 当前节点去描边/底色，仅靠 cell 绿底 + 箭头表达 */
.route-node.current .iconfont { color: var(--text3); }   /* 当前节点图标用正常箭头色，而非品牌绿 */
.route-node.done    { border-color: var(--brand); color: var(--brand); }   /* 未解锁沿用基类灰描边 + 灰图标 */

/* 连接线：贯穿整行内容高度（末行无线）。
   cell 上下各 32rpx 内边距 + 下一行 wrap 的 4rpx padding-top 会形成 ~68rpx 断口，
   用伪元素向下补齐，使整条时间线跨行连续 */
.route-node-line {
  position: relative;
  flex: 1;
  width: 1rpx;
  background: var(--divider);
}
.route-node-line::after {
  content: '';
  position: absolute;
  left: 0;
  top: 100%;
  width: 1rpx;
  height: 68rpx;
  background: var(--divider);
  z-index: 1;                       /* 盖过下一行 cell 背景（如绿底当前行），避免断口 */
}

/* ③ 阶段名 / 副信息 */
.route-name {
  font-size: calc(34rpx * var(--fs, 1));   /* 17px 主文，字重同全局 .weui-cell__bd_text（400） */
  color: var(--text);
}
.route-meta {
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
  line-height: 1.5;
}

/* ③-b 进入 / 晋级条件（弱化说明，1rpx 分隔线与主信息区隔开） */
.route-req {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--divider);
}
.route-req-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}
.route-req-row:first-child { margin-top: 0; }
.route-req-label {
  flex-shrink: 0;
  width: 72rpx;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text3);
}
.route-req-value {
  flex: 1;
  font-size: calc(28rpx * var(--fs, 1));   /* 14px 次级 */
  color: var(--text2);
  line-height: 1.5;
}

/* ④ 右侧：仅保留时间线（节点 + 连接线），整体靠右 */
.route-cell .weui-cell__ft {
  display: flex;
  align-items: stretch;            /* 让连接线撑满整行高度，跨行连续 */
}

/* ⑤ 深色：仅当前阶段高亮底色需加深，其余走变量自动适配 */
.dm-dark .current-cell { background: rgba(7, 193, 96, 0.20); }
.dm-dark .current-cell:active { background: rgba(7, 193, 96, 0.28); }
@media (prefers-color-scheme: dark) {
  .dm-auto .current-cell { background: rgba(7, 193, 96, 0.20); }
  .dm-auto .current-cell:active { background: rgba(7, 193, 96, 0.28); }
}
