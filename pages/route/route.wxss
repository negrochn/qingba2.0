/* ===== 路线页（WeUI 风格重构） ===== */

/* ① 时间线 */
.timeline {
  padding: 0 32rpx;
}

.stage-item {
  display: flex;
  align-items: stretch;
  padding-top: 8rpx;
}
.stage-hover { opacity: 0.85; }

.stage-rail {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28rpx;
}

.stage-node {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  color: var(--text3);
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 600;
  border: 2rpx solid var(--divider);
  box-sizing: border-box;
  position: relative;
  z-index: 2;
  transition: all 0.2s ease;
}
.stage-node .iconfont {
  font-size: calc(26rpx * var(--fs, 1)) !important;
  font-weight: normal;
}

.stage-node.done {
  background: rgba(7, 193, 96, 0.15);
  color: var(--brand);
  border-color: rgba(7, 193, 96, 0.4);
}

.stage-node.current {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.15);
}

.stage-node.locked {
  background: var(--card);
  color: var(--text4);
}

.stage-line {
  flex: 1;
  width: 2rpx;
  background: var(--divider);
  margin: 8rpx 0 0;
  min-height: 32rpx;
}

/* ③ 阶段卡片 */
.stage-card {
  flex: 1;
  margin: 16rpx 0 0 0;
  padding: 24rpx 24rpx 20rpx 28rpx;
  background: var(--card);
  border-radius: 16rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border-left: 4rpx solid var(--divider);
  box-sizing: border-box;
}

.stage-card.current {
  border-left-color: var(--brand);
  background: rgba(7, 193, 96, 0.04);
}

.stage-card.done {
  border-left-color: rgba(7, 193, 96, 0.5);
}

.stage-card.locked {
  opacity: 0.65;
  border-left-color: var(--divider);
}

.stage-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stage-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.stage-name {
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

.stage-phase {
  font-size: calc(26rpx * var(--fs, 1));
  color: #576b95;
  background: rgba(87, 107, 149, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 400;
  line-height: 1.3;
}

.stage-arrow {
  font-size: calc(28rpx * var(--fs, 1)) !important;
  color: var(--text4);
  line-height: 1;
}

.stage-meta-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  flex-wrap: wrap;
  gap: 4rpx;
}

.stage-meta-vocab,
.stage-meta-time {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text2);
  line-height: 1.4;
}

.stage-meta-dot {
  margin: 0 6rpx;
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--text4);
}

.stage-badge {
  margin-left: auto;
  padding: 2rpx 10rpx;
  font-size: calc(26rpx * var(--fs, 1));
  border-radius: 6rpx;
  line-height: 1.3;
  font-weight: 400;
}

.stage-badge.current {
  color: #fff;
  background: var(--brand);
}

.stage-badge.done {
  color: var(--brand);
  background: rgba(7, 193, 96, 0.12);
}

.stage-badge.locked {
  color: var(--text3);
  background: var(--card2);
}

.stage-info {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--divider);
}

.stage-info-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.5;
}
.stage-info-row:first-child { margin-top: 0; }

.stage-info-label {
  flex-shrink: 0;
  width: 80rpx;
  color: var(--text3);
}

.stage-info-value {
  flex: 1;
  color: var(--text2);
}

/* ===== 深色模式 ===== */
.dm-dark .stage-node.locked { background: var(--card); }
.dm-dark .stage-card { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2); }
.dm-dark .stage-card.current { background: rgba(7, 193, 96, 0.08); }
.dm-dark .stage-phase { color: #9aaecf; background: rgba(154, 174, 207, 0.16); }

@media (prefers-color-scheme: dark) {
  .dm-auto .stage-node.locked { background: var(--card); }
  .dm-auto .stage-card { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2); }
  .dm-auto .stage-card.current { background: rgba(7, 193, 96, 0.08); }
  .dm-auto .stage-phase { color: #9aaecf; background: rgba(154, 174, 207, 0.16); }
}