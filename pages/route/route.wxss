/* 路线页卡 - 微信小程序风格 */

page {
  background: #f7f7f7;
}

.container {
  padding: 24rpx 24rpx 48rpx;
  background: #f7f7f7;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 时间线容器 */
.timeline {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 0;
  overflow: hidden;
}

/* 阶段项 */
.stage-item {
  display: flex;
  align-items: stretch;
  padding: 20rpx 28rpx;
  transition: background 0.15s ease;
}

.stage-hover {
  background: #f5f5f5;
}

/* 左侧轨道 */
.stage-rail {
  width: 64rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 阶段节点 */
.stage-node {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d8d8d8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  transition: all 0.2s ease;
}

.node-num {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

.stage-line {
  width: 2rpx;
  flex: 1;
  background: #e8e8e8;
  margin-top: 6rpx;
  min-height: 32rpx;
}

/* 右侧内容 */
.stage-body {
  flex: 1;
  padding: 4rpx 0 20rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-width: 0;
}

.stage-item:last-child .stage-body {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.stage-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  min-width: 0;
}

.stage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  line-height: 1.4;
}

.stage-phase {
  font-size: 20rpx;
  color: #576b95;
  background: #edf0f5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 400;
}

.stage-arrow {
  font-size: 32rpx;
  color: #c8c8c8;
  font-weight: 300;
}

.stage-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.stage-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.stage-body .stage-tags + .stage-tags {
  margin-top: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 400;
  line-height: 1.4;
}

.tag-entry {
  color: #c77600;
  background: #fffbe6;
}

.tag-promote {
  color: #3370ff;
  background: #eaf2ff;
}

/* 当前阶段 - 绿色主色 */
.stage-current .stage-node {
  background: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.15);
}

.stage-current .node-current-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #ffffff;
  border-radius: 50%;
  top: -4rpx;
  right: -4rpx;
  border: 2rpx solid #07c160;
}

.stage-current .stage-name {
  color: #07c160;
}

.stage-current .stage-body {
  background: #f6fffa;
  border-radius: 0 12rpx 12rpx 0;
}

/* 已完成阶段 - 浅绿 */
.stage-done .stage-node {
  background: #95d6a7;
}

.stage-done .stage-name {
  color: #576b95;
}

.node-icon {
  font-size: 20rpx;
  font-weight: 500;
  color: #ffffff;
}

.stage-done .stage-line {
  background: #d4edda;
}

/* 锁定阶段 - 灰色 */
.stage-locked {
  opacity: 0.7;
}

.stage-locked .stage-name {
  color: #b2b2b2;
}

.stage-locked .stage-desc {
  color: #c8c8c8;
}

.stage-locked .tag {
  opacity: 0.6;
}

.node-locked {
  background: #d8d8d8;
  color: #b2b2b2;
}

.stage-locked .stage-line {
  background: #ececec;
}

.stage-lock-tag {
  font-size: 18rpx;
  color: #b2b2b2;
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 4rpx;
}
