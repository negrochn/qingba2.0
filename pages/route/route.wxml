<view class="container {{fontClass}} {{darkClass}}">

  <!-- 当前阶段：分组标题 + cell，右侧为当前阶段进度；未设置时改为引导去选择 -->
  <view class="weui-cells__title">当前阶段</view>
  <view class="weui-cells">
    <block wx:if="{{currentCard}}">
      <view
        class="weui-cell weui-cell_access current-cell"
        data-index="{{currentStageIndex}}"
        bindtap="toStage"
        hover-class="current-cell-hover"
      >
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text">{{currentCard.name}}</view>
        </view>
        <view class="weui-cell__ft">
          <text class="weui-cell__ft_value">{{currentCard.progress}}%</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </block>

    <!-- 未设置当前阶段：引导去选择，作为路线的起点 -->
    <block wx:else>
      <view
        class="weui-cell weui-cell_access"
        bindtap="goStagePicker"
        hover-class="current-cell-hover"
      >
        <view class="weui-cell__bd">
          <view class="weui-cell__bd_text route-unset">未设置</view>
          <view class="route-meta">选择一个阶段作为起点</view>
        </view>
        <view class="weui-cell__ft">
          <text class="route-cta">去选择</text>
          <text class="iconfont icon-right"></text>
        </view>
      </view>
    </block>
  </view>

  <!-- 路线时间线 -->
  <view class="weui-cells__title">学习路线</view>
  <view class="weui-cells">
    <view
      class="weui-cell weui-cell_access route-cell {{item._state === 'current' ? 'current-cell' : ''}}"
      wx:for="{{stages}}"
      wx:key="stage_id"
      id="stage-{{index}}"
      data-index="{{index}}"
      bindtap="toStage"
    >
      <view class="weui-cell__bd">
        <view class="weui-cell__bd_text route-name">{{item.stage_name}}</view>
        <view class="route-meta">{{item.target_phase}} · {{item.vocabulary_target}} · {{item.time_investment}}</view>
        <view class="route-req">
          <view class="route-req-row">
            <text class="route-req-label">进入</text>
            <text class="route-req-value">{{item.entry_requirement}}</text>
          </view>
          <view class="route-req-row">
            <text class="route-req-label">晋级</text>
            <text class="route-req-value">{{item.promotion_standard}}</text>
          </view>
        </view>
      </view>

      <view class="weui-cell__ft">
        <!-- 仅保留右侧时间线（节点 + 连接线） -->
        <view class="route-node-wrap">
          <view class="route-node {{item._state}}">
            <text wx:if="{{item._state === 'current'}}" class="iconfont icon-right"></text>
            <text wx:elif="{{item._state === 'done'}}" class="iconfont icon-check"></text>
            <text wx:elif="{{item._state === 'locked'}}" class="iconfont icon-lock"></text>
          </view>
          <view class="route-node-line" wx:if="{{index < stageCount - 1}}"></view>
        </view>
      </view>
    </view>
  </view>

</view>
