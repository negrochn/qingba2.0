<view class="container {{fontClass}} {{darkClass}}">
  <view class="timeline">
    <view
      class="stage-item {{item._state === 'done' ? 'stage-done' : ''}} {{item._state === 'current' ? 'stage-current' : ''}} {{item._state === 'locked' ? 'stage-locked' : ''}}"
      wx:for="{{stages}}"
      wx:key="stage_id"
      id="stage-{{index}}"
      data-index="{{index}}"
      bindtap="toStage"
      hover-class="stage-hover"
    >
      <view class="stage-rail">
        <view class="stage-node {{item._state === 'current' ? 'node-current' : ''}} {{item._state === 'done' ? 'node-done' : ''}} {{item._state === 'locked' ? 'node-locked' : ''}}">
          <text class="node-num" wx:if="{{item._state !== 'done'}}">{{index + 1}}</text>
          <text class="node-icon" wx:else>✓</text>
          <view class="node-current-dot" wx:if="{{item._state === 'current'}}"></view>
        </view>
        <view class="stage-line" wx:if="{{index < stageCount - 1}}"></view>
      </view>

      <view class="stage-body">
        <view class="stage-head">
          <view class="stage-title-row">
            <text class="stage-name">{{item.stage_name}}</text>
            <text class="stage-phase">{{item.target_phase}}</text>
            <view class="stage-lock-tag" wx:if="{{item._state === 'locked'}}">🔒 未解锁</view>
            <view class="stage-done-tag" wx:if="{{item._state === 'done'}}">✓ 已完成</view>
          </view>
          <text class="stage-arrow">›</text>
        </view>

        <view class="stage-desc">{{item.vocabulary_target}} · {{item.time_investment}}</view>

        <view class="stage-tags">
          <view class="tag tag-entry">进入 {{item.entry_requirement}}</view>
        </view>
        <view class="stage-tags">
          <view class="tag tag-promote">晋级 {{item.promotion_standard}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
