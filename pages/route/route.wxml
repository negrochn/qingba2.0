<view class="container {{fontClass}} {{darkClass}}">

  <!-- ① 阶段时间线：左竖线 + 圆形节点，右白卡片 -->
  <view class="timeline">
    <view
      class="stage-item"
      wx:for="{{stages}}"
      wx:key="stage_id"
      id="stage-{{index}}"
      data-index="{{index}}"
      bindtap="toStage"
      hover-class="stage-hover"
    >
      <view class="stage-rail">
        <view class="stage-node {{item._state}}">
          <text wx:if="{{item._state !== 'done'}}">{{index + 1}}</text>
          <text wx:else class="iconfont icon-check"></text>
        </view>
        <view class="stage-line" wx:if="{{index < stageCount - 1}}"></view>
      </view>

      <view class="stage-card {{item._state}}">
        <view class="stage-card-head">
          <view class="stage-title-row">
            <text class="stage-name">{{item.stage_name}}</text>
            <text class="stage-phase">{{item.target_phase}}</text>
          </view>
          <text class="iconfont icon-right stage-arrow"></text>
        </view>

        <view class="stage-meta-row">
          <text class="stage-meta-vocab">{{item.vocabulary_target}}</text>
          <text class="stage-meta-dot">·</text>
          <text class="stage-meta-time">{{item.time_investment}}</text>
          <view class="stage-badge {{item._state}}">
            <text wx:if="{{item._state === 'current'}}">当前</text>
            <text wx:elif="{{item._state === 'done'}}">已完成</text>
            <text wx:else>未解锁</text>
          </view>
        </view>

        <view class="stage-info">
          <view class="stage-info-row">
            <text class="stage-info-label">进入</text>
            <text class="stage-info-value">{{item.entry_requirement}}</text>
          </view>
          <view class="stage-info-row">
            <text class="stage-info-label">晋级</text>
            <text class="stage-info-value">{{item.promotion_standard}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>