<view class="container">
  <view class="route-card">
    <view
      class="stage {{index === stageCount - 1 ? 'stage-end' : ''}}"
      wx:for="{{stages}}"
      wx:key="stage_id"
      data-index="{{index}}"
      bindtap="toStage"
      hover-class="stage-hover"
    >
      <view class="rail">
        <view class="node {{index === stageCount - 1 ? 'node-end' : ''}}">{{index + 1}}</view>
        <view class="line" wx:if="{{index < stageCount - 1}}"></view>
      </view>
      <view class="content">
        <view class="head">
          <text class="name">{{item.stage_name}}</text>
          <text class="target {{index === stageCount - 1 ? 'target-end' : ''}}">{{item.target_phase}}</text>
        </view>
        <view class="chips">
          <text class="chip">{{item.vocabulary_target}}</text>
          <text class="chip">{{item.time_investment}}</text>
          <text class="chip">{{item.entry_requirement}}</text>
          <text class="chip">{{item.promotion_standard}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
