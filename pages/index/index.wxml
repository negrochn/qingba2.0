<view class="container">
  <!-- 顶部路线概览 -->
  <view class="hero">
    <view class="hero-title">{{route.route_name}}</view>
    <view class="hero-meta">
      <text class="tag">{{route.age_group}}</text>
      <text class="tag">{{route.total_stages}}个阶段</text>
    </view>
    <view class="hero-desc">{{route.overview.description}}</view>
  </view>

  <!-- 核心原则 -->
  <view class="card">
    <view class="section-title">三大核心原则</view>
    <view class="principles">
      <view class="principle" wx:for="{{route.overview.key_principles}}" wx:key="*this">
        <view class="principle-no">{{index + 1}}</view>
        <view class="principle-text">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 核心标准 -->
  <view class="card highlight-card">
    <view class="section-title">晋级核心标准</view>
    <view class="core-standard">{{route.overview.core_standard}}</view>
  </view>

  <!-- 三大方法 -->
  <view class="card">
    <view class="section-title">三大方法</view>
    <view class="method" wx:for="{{methods}}" wx:key="key">
      <view class="method-name">{{item.name}}</view>
      <view class="method-op">操作：{{item.standard_operation}}</view>
      <view class="method-warn" wx:if="{{item.warnings.length}}">
        <view class="warn-title">注意：</view>
        <view class="warn-item" wx:for="{{item.warnings}}" wx:for-item="w" wx:key="*this">· {{w}}</view>
      </view>
      <block wx:if="{{item.time_calculation}}">
        <view class="method-op">有效输入时长换算：</view>
        <view class="calc-item" wx:for="{{item.time_calculation}}" wx:for-item="v" wx:for-index="k" wx:key="k">{{k}}：{{v}}</view>
      </block>
    </view>
  </view>

  <!-- 阶段列表 -->
  <view class="card">
    <view class="section-title">阶段路线</view>
    <view class="stage-item" wx:for="{{stages}}" wx:key="stage_id" data-index="{{index}}" bindtap="toStage">
      <view class="stage-left">
        <view class="stage-no">{{index + 1}}</view>
      </view>
      <view class="stage-body">
        <view class="stage-name">{{item.stage_name}}</view>
        <view class="stage-info">
          <text class="info-chip">词汇 {{item.vocabulary_target}}</text>
          <text class="info-chip">{{item.time_investment}}</text>
          <text class="info-chip">{{item.target_phase}}</text>
        </view>
        <view class="stage-entry">进入条件：{{item.entry_requirement}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>
