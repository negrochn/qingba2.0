.hero {
  background: linear-gradient(135deg, #4a90d9 0%, #6ab0f3 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hero-meta {
  margin-bottom: 20rpx;
}

.hero-meta .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.hero-desc {
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.7;
}

.principles {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.principle {
  display: flex;
  align-items: center;
}

.principle-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.principle-text {
  flex: 1;
  color: #333;
}

.highlight-card {
  background: linear-gradient(135deg, #fff8ec 0%, #fff3da 100%);
  border-left: 8rpx solid #f0a020;
}

.core-standard {
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.8;
}

.method {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.method:last-child {
  border-bottom: none;
}

.method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4a90d9;
  margin-bottom: 12rpx;
}

.method-op {
  color: #555;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.method-warn {
  background: #fff4f4;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.warn-title {
  color: #e0625a;
  font-weight: 600;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.warn-item {
  color: #b04040;
  font-size: 24rpx;
  line-height: 1.7;
}

.calc-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  padding-left: 12rpx;
}

.stage-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stage-item:last-child {
  border-bottom: none;
}

.stage-item:active {
  background: #f9f9f9;
}

.stage-left {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.stage-no {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #4a90d9;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.stage-body {
  flex: 1;
}

.stage-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.stage-info {
  margin-bottom: 10rpx;
}

.info-chip {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background: #eef4fb;
  color: #4a90d9;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.stage-entry {
  font-size: 24rpx;
  color: #888;
}

.arrow {
  flex-shrink: 0;
  color: #c0c0c0;
  font-size: 40rpx;
  padding-left: 12rpx;
}
